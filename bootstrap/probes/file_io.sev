modulo bootstrap.probes.file_io

usa std.fs.file

campo inicio() -> Num toca disco, terminal ::
  guarda gravado := arquivo_salva_texto("build/probe-file.txt", "stage0-file-ok")

  veja gravado e Falha ::
    diga "file-write-failed"
    devolve 1
  fecha

  guarda lido := arquivo_texto("build/probe-file.txt")
  veja lido e Falha ::
    diga "file-read-failed"
    devolve 2
  fecha

  diga "file=" + lido.valor
  devolve 0
fecha
