static int field_index_suffix(Image*im,const char*name){
 size_t n=strlen(name);int found=-1;
 for(uint32_t i=0;i<im->field_count;i++){
  String s=im->fields[i].name;
  if(str_eq_c(s,name))return (int)i;
  if(s.len>n&&s.data[s.len-n-1]=='.'&&!memcmp(s.data+s.len-n,name,n)){
   if(found>=0)return -2;
   found=(int)i;
  }
 }
 return found;
}
static int vm_run(Image*im,int argc,char**argv){VM vm={0};vm.img=im;int entry=field_index_suffix(im,"inicio");if(entry==-2)die("ambiguous entry field inicio");if(entry<0&&im->field_count==1)entry=0;if(entry<0)die("entry field inicio missing");vm.field=(uint32_t)entry;vm.ip=im->fields[entry].entry;vm.local_count=im->fields[entry].locals;vm.locals=(Value*)xcalloc(vm.local_count,sizeof(Value));if(im->fields[entry].params){List*l=list_new();for(int i=0;i<argc;i++)list_push(l,v_str_c(argv[i]));vm.locals[0]=v_list(l);}uint64_t steps=0;while(!vm.failed){if(++steps>2000000000ULL){vm_fail(&vm,"step limit");break;}if(vm.ip>=im->code_count){vm_fail(&vm,"instruction pointer out of bounds");break;}Instr in=im->code[vm.ip++];switch(in.op){case 0:return 0;case 1:if(in.a>=im->num_count){vm_fail(&vm,"number constant out of bounds");break;}push(&vm,v_int(im->nums[in.a]));break;case 2:if(in.a>=im->text_count){vm_fail(&vm,"text constant out of bounds");break;}push(&vm,v_str(im->texts[in.a]));break;case 3:if(in.a>=vm.local_count){vm_fail(&vm,"local read out of bounds");break;}push(&vm,vm.locals[in.a]);break;case 4:if(in.a>=vm.local_count){vm_fail(&vm,"local write out of bounds");break;}vm.locals[in.a]=pop(&vm);break;case 5:case 6:case 7:case 8:case 9:case 10:case 21:case 22:case 23:case 24:{Value r=pop(&vm),l=pop(&vm);const char*op=in.op==5?"+":in.op==6?"-":in.op==7?"*":in.op==8?"/":in.op==9?"==":in.op==10?"<":in.op==21?"!=":in.op==22?"<=":in.op==23?">":">=";push(&vm,binary(&vm,l,str_c(op),r));break;}case 11:if(in.a>=im->code_count)vm_fail(&vm,"jump out of bounds");else vm.ip=in.a;break;case 12:{Value c=pop(&vm);if(!truth(c)){if(in.a>=im->code_count)vm_fail(&vm,"conditional jump out of bounds");else vm.ip=in.a;}break;}case 13:{if(in.a>=im->field_count){vm_fail(&vm,"call field out of bounds");break;}Field*t=&im->fields[in.a];if(in.b!=t->params||in.b>vm.sp){vm_fail(&vm,"invalid call arity");break;}Value*nl=(Value*)xcalloc(t->locals,sizeof(Value));size_t base=vm.sp-in.b;for(uint32_t i=0;i<in.b;i++)nl[i]=vm.stack[base+i];vm.sp=base;Frame fr={vm.field,vm.ip,vm.locals,vm.local_count};frame_push(&vm,fr);vm.field=in.a;vm.ip=t->entry;vm.locals=nl;vm.local_count=t->locals;break;}case 14:{Value ret=vm.sp?pop(&vm):v_null();if(!vm.fp)return (int)number(ret);Frame fr=vm.frames[--vm.fp];vm.field=fr.field;vm.ip=fr.ret_ip;vm.locals=fr.locals;vm.local_count=fr.local_count;push(&vm,ret);break;}case 15:{int64_t n=number(pop(&vm));if(n<0){vm_fail(&vm,"negative byte block size");break;}Bytes*b=bytes_new();bytes_reserve(b,(size_t)n);memset(b->data,0,(size_t)n);b->len=(size_t)n;push(&vm,v_bytes(b));break;}case 16:{Value value=pop(&vm),index=pop(&vm),block=pop(&vm);if(block.tag!=V_BYTES){vm_fail(&vm,"byte block expected");break;}size_t i=(size_t)number(index);if(i>=block.as.bytes->len){vm_fail(&vm,"byte write out of bounds");break;}block.as.bytes->data[i]=(uint8_t)number(value);break;}case 17:{Value index=pop(&vm),block=pop(&vm);if(block.tag!=V_BYTES){vm_fail(&vm,"byte block expected");break;}size_t i=(size_t)number(index);if(i>=block.as.bytes->len){vm_fail(&vm,"byte read out of bounds");break;}push(&vm,v_int(block.as.bytes->data[i]));break;}case 18:break;case 19:{if(in.a>=im->name_count||in.b>vm.sp){vm_fail(&vm,"invalid syscall operands");break;}size_t base=vm.sp-in.b;Value out=syscall(&vm,im->names[in.a],vm.stack+base,in.b);vm.sp=base;if(!vm.failed)push(&vm,out);break;}case 20:if(in.a>=im->const_count){vm_fail(&vm,"constant out of bounds");break;}push(&vm,im->consts[in.a]);break;default:vm_fail(&vm,"unsupported opcode");break;}}
fprintf(stderr,"genesis-host: %s (field=%.*s ip=%u steps=%llu)\n",vm.error,(int)im->fields[vm.field].name.len,im->fields[vm.field].name.data,vm.ip,(unsigned long long)steps);return 1;}

int main(int argc,char**argv){if(argc<2){fprintf(stderr,"usage: %s IMAGE.svbc [program args...]\n",argv[0]);return 2;}Image im=load_image(argv[1]);return vm_run(&im,argc-2,argv+2);}
