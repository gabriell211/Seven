modulo conformance.platform.valid.capabilities

usa seven.runtime.platform.abi
usa seven.runtime.platform.capability

campo inicio() -> Num ::
  solta caps := lista_de(CapPura)
  lista_coloca(caps, CapRede)

  veja capacidade_tem(caps, CapRede) ::
    devolve 0
  outro ::
    devolve 1
  fecha
fecha
