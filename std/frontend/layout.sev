modulo std.frontend.layout

usa std.frontend.css

campo flex_linha() -> Lista<DeclaracaoCss> ::
  solta declaracoes := lista<DeclaracaoCss>()
  lista_coloca(declaracoes, decl("display", "flex"))
  lista_coloca(declaracoes, decl("flex-direction", "row"))
  devolve declaracoes
fecha

campo flex_coluna() -> Lista<DeclaracaoCss> ::
  solta declaracoes := lista<DeclaracaoCss>()
  lista_coloca(declaracoes, decl("display", "flex"))
  lista_coloca(declaracoes, decl("flex-direction", "column"))
  devolve declaracoes
fecha

campo grid_colunas(colunas: Texto) -> Lista<DeclaracaoCss> ::
  solta declaracoes := lista<DeclaracaoCss>()
  lista_coloca(declaracoes, decl("display", "grid"))
  lista_coloca(declaracoes, decl("grid-template-columns", colunas))
  devolve declaracoes
fecha

campo centraliza() -> Lista<DeclaracaoCss> ::
  solta declaracoes := lista<DeclaracaoCss>()
  lista_coloca(declaracoes, decl("display", "grid"))
  lista_coloca(declaracoes, decl("place-items", "center"))
  devolve declaracoes
fecha

campo espacamento(valor: Texto) -> DeclaracaoCss ::
  devolve decl("gap", valor)
fecha

campo tamanho_total() -> Lista<DeclaracaoCss> ::
  solta declaracoes := lista<DeclaracaoCss>()
  lista_coloca(declaracoes, decl("width", "100%"))
  lista_coloca(declaracoes, decl("min-height", "100vh"))
  devolve declaracoes
fecha
