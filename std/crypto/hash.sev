modulo std.crypto.hash

usa std.fs.file
usa std.mem.bytes

molde Hash ::
  algoritmo: Texto
  valor: Bytes
fecha

campo sha256(dados: Bytes) -> Hash toca ambiente ::
  devolve Hash {
    algoritmo: "sha256",
    valor: sys_sha256(dados)
  }
fecha

campo hash_texto(hash: Hash) -> Texto ::
  devolve bytes_hex(hash.valor)
fecha

campo sha256_arquivo(caminho: Texto) -> Texto toca disco, ambiente ::
  guarda dados := arquivo_bytes(caminho)

  veja dados e Falha ::
    devolve ""
  fecha

  devolve hash_texto(sha256(dados.valor))
fecha
