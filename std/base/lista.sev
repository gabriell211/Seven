modulo std.base.lista

molde Lista<T> ::
  tamanho: U64
fecha

campo lista<T>() -> Lista<T> ::
  devolve Lista<T> {
    tamanho: 0
  }
fecha

campo lista_de<T>(primeiro: T) -> Lista<T> ::
  solta itens := lista<T>()
  lista_coloca(itens, primeiro)
  devolve itens
fecha

campo lista_coloca<T>(itens: Lista<T>, valor: T) -> Lista<T> ::
  devolve sys_lista_coloca(itens, valor)
fecha

campo lista_insere<T>(itens: Lista<T>, indice: U64, valor: T) -> Lista<T> ::
  devolve sys_lista_insere(itens, indice, valor)
fecha

campo lista_remove<T>(itens: Lista<T>, indice: U64) -> T ::
  devolve sys_lista_remove(itens, indice)
fecha

campo lista_pop<T>(itens: Lista<T>) -> T ::
  devolve sys_lista_pop(itens)
fecha

campo lista_pega<T>(itens: Lista<T>, indice: U64) -> T ::
  devolve sys_lista_pega(itens, indice)
fecha

campo lista_define<T>(itens: Lista<T>, indice: U64, valor: T) -> Lista<T> ::
  devolve sys_lista_define(itens, indice, valor)
fecha

campo lista_tamanho<T>(itens: Lista<T>) -> U64 ::
  devolve itens.tamanho
fecha

campo lista_vazia<T>(itens: Lista<T>) -> Bit ::
  devolve itens.tamanho == 0
fecha

campo lista_junta<T>(destino: Lista<T>, origem: Lista<T>) -> Lista<T> ::
  solta indice: U64 := 0
  gira indice < lista_tamanho(origem) ::
    lista_coloca(destino, lista_pega(origem, indice))
    vira indice := indice + 1
  fecha
  devolve destino
fecha

campo reverso<T>(itens: Lista<T>) -> Lista<T> ::
  solta saida := lista<T>()
  solta indice := lista_tamanho(itens)

  gira indice > 0 ::
    vira indice := indice - 1
    lista_coloca(saida, lista_pega(itens, indice))
  fecha

  devolve saida
fecha
