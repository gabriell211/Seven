modulo seven.runtime.svbc0.vm

usa std.base.resultado
usa std.mem.bytes
usa seven.runtime.svbc.vm
usa seven.runtime.svbc0.decoder
usa seven.runtime.svbc0.image
usa seven.runtime.svbc0.translator
usa seven.runtime.svbc0.verifier

campo vm0_executa(
  imagem: ImagemSvbc0
) -> Resultado<Num, Falha> toca rede, disco, terminal, tempo, ambiente, frontend ::
  guarda verificacao := svbc0_verifica(imagem)

  veja verificacao e Falha ::
    devolve Falha(verificacao.valor)
  fecha

  devolve vm_executa(svbc0_para_svbc(imagem))
fecha

campo vm0_executa_com_args(
  imagem: ImagemSvbc0,
  argumentos: Lista<Texto>
) -> Resultado<Num, Falha> toca rede, disco, terminal, tempo, ambiente, frontend ::
  guarda verificacao := svbc0_verifica(imagem)

  veja verificacao e Falha ::
    devolve Falha(verificacao.valor)
  fecha

  devolve vm_executa_com_args(svbc0_para_svbc(imagem), argumentos)
fecha

campo vm0_executa_bytes(
  dados: Bytes,
  argumentos: Lista<Texto>
) -> Resultado<Num, Falha> toca rede, disco, terminal, tempo, ambiente, frontend ::
  guarda imagem := svbc0_decodifica(dados)

  veja imagem e Falha ::
    devolve Falha(imagem.valor)
  fecha

  devolve vm0_executa_com_args(imagem.valor, argumentos)
fecha
