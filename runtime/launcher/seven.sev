modulo seven.runtime.launcher

usa seven.runtime.svbc.runner
usa std.fs.file

campo seven_launcher(argumentos: Lista<Texto>) -> Num toca disco, terminal, rede, tempo, ambiente, frontend ::
  devolve roda_svbc_com_args(seven_compilador_caminho(), argumentos)
fecha

campo inicio() -> Num toca disco, terminal, rede, tempo, ambiente, frontend ::
  devolve seven_launcher(sys_args())
fecha

campo seven_compilador_caminho() -> Texto toca disco, ambiente ::
  guarda raiz := sys_executavel_diretorio()
  guarda irmao := raiz + "/seven.svbc"

  veja arquivo_existe(irmao) ::
    devolve irmao
  fecha

  veja arquivo_existe("build/seven.svbc") ::
    devolve "build/seven.svbc"
  fecha

  devolve "seven.svbc"
fecha
