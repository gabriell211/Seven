modulo seven.runtime.launcher

campo seven_launcher(argumentos: Lista<Texto>) -> Num toca terminal, ambiente ::
  veja lista_tamanho(argumentos) == 0 ou lista_pega(argumentos, 0) == "--help" ou lista_pega(argumentos, 0) == "help" ::
    diga "Seven 0.2.0"
    diga "usage:"
    diga "  seven --version"
    diga "  seven doctor"
    diga "  seven check <pacote.pkg|arquivo.sev>"
    diga "  seven build <pacote.pkg|arquivo.sev> <saida.svbc>"
    diga "  seven run <pacote.pkg|arquivo.sev>"
    diga "  seven web build <entrada.sev> <saida-dir>"
    diga "  seven web serve <diretorio> <porta>"
    devolve 0
  fecha

  guarda comando := lista_pega(argumentos, 0)

  veja comando == "--version" ::
    diga "Seven 0.2.0"
    diga "Creator: Gabriel Barcelos"
    devolve 0
  fecha

  veja comando == "doctor" ::
    diga "seven doctor: bootstrap minimo auditavel e compilador Stage2 self-hosted operacionais"
    devolve 0
  fecha

  diga "comando fora da superficie stable do launcher: " + comando
  diga "use: seven --help"
  devolve 2
fecha

campo inicio() -> Num toca terminal, ambiente ::
  devolve seven_launcher(sys_args())
fecha
