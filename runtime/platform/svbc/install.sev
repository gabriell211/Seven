modulo seven.runtime.platform.svbc.install

usa std.base.resultado
usa seven.runtime.platform.svbc.bytes
usa seven.runtime.svbc.value

campo intr_plataforma_atual(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca ambiente ::
  devolve Valor(VmTexto(sys_host_plataforma_atual()))
fecha

campo intr_diretorio_cria(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca disco ::
  guarda resultado := sys_host_diretorio_cria(valor_texto(lista_pega(args, 0)))
  devolve resultado_nada_vm(resultado)
fecha

campo intr_diretorio_copia(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca disco ::
  guarda origem := valor_texto(lista_pega(args, 0))
  guarda destino := valor_texto(lista_pega(args, 1))
  devolve resultado_nada_vm(sys_host_diretorio_copia(origem, destino))
fecha

campo intr_diretorio_remove_arvore(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca disco ::
  guarda resultado := sys_host_diretorio_remove_arvore(valor_texto(lista_pega(args, 0)))
  devolve resultado_nada_vm(resultado)
fecha

campo intr_arquivo_grava_bytes(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca disco ::
  guarda caminho := valor_texto(lista_pega(args, 0))
  guarda dados := lista_pega(args, 1)

  veja dados e VmBytes ::
    devolve resultado_nada_vm(sys_host_arquivo_grava_bytes(caminho, dados.valor))
  fecha

  devolve Falha(nova_falha("SV-INSTALL-TIPO", "arquivo_grava_bytes esperava Bytes"))
fecha

campo intr_arquivo_copia(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca disco ::
  guarda origem := valor_texto(lista_pega(args, 0))
  guarda destino := valor_texto(lista_pega(args, 1))
  devolve resultado_nada_vm(sys_host_arquivo_copia(origem, destino))
fecha

campo intr_arquivo_remove(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca disco ::
