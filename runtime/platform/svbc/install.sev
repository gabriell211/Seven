campo resultado_nada_vm(resultado: Resultado<Nada, Falha>) -> Resultado<ValorVm, Falha> ::
  veja resultado e Falha ::
    devolve Falha(resultado.valor)
  fecha

  devolve Valor(VmNada)
fecha
