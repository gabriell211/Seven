campo intr_host_crypto(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> toca ambiente ::
  devolve Falha(nova_falha("SVBC-CAP-CRYPTO", "capacidade criptografica requer um provedor compativel"))
