campo intr_vm_binaria(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  devolve sys_vm_binaria(lista_pega(args, 0), valor_texto(lista_pega(args, 1)), lista_pega(args, 2))
fecha

campo intr_bit_nao(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  devolve Valor(VmBit(nao valor_verdadeiro(lista_pega(args, 0))))
fecha

campo intr_bit_e(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  devolve Valor(VmBit(valor_verdadeiro(lista_pega(args, 0)) e valor_verdadeiro(lista_pega(args, 1))))
fecha

campo intr_bit_ou(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  devolve Valor(VmBit(valor_verdadeiro(lista_pega(args, 0)) ou valor_verdadeiro(lista_pega(args, 1))))
fecha

campo intr_num_mod(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  guarda esquerda := valor_num(lista_pega(args, 0))
  guarda direita := valor_num(lista_pega(args, 1))

  veja direita == 0 ::
    devolve Falha(nova_falha("SVBC-DIV-ZERO", "modulo por zero"))
  fecha

  devolve Valor(VmNum(esquerda % direita))
fecha

campo intr_falha(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  guarda codigo := valor_texto(lista_pega(args, 0))
  guarda mensagem := valor_texto(lista_pega(args, 1))
  devolve Falha(nova_falha(codigo, mensagem))
fecha

campo intr_obj_novo(args: Lista<ValorVm>) -> Resultado<ValorVm, Falha> ::
  devolve Valor(sys_vm_obj_novo(args))
