campo x64_runtime_bytes_coloca_be(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo,
  largura: U64
) -> Nada ::
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 94)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 209)
  bytes_coloca_byte(codigo, 238)
  bytes_coloca_byte(codigo, 88)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 232)
  bytes_coloca_byte(codigo, 1)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 196)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 123)
  bytes_coloca_byte(codigo, Byte(largura))
  x64_bytes_garante(codigo, virtual_alloc_patches, alvo)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 108)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 24)
  bytes_coloca_byte(codigo, 79)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 29)
  bytes_coloca_byte(codigo, 0)

  solta indice: U64 := 0
  gira indice < largura ::
    bytes_coloca_byte(codigo, 76)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 240)
    guarda deslocamento := (largura - 1 - indice) * 8
    veja deslocamento > 0 ::
      bytes_coloca_byte(codigo, 73)
      bytes_coloca_byte(codigo, 193)
      bytes_coloca_byte(codigo, 238)
      bytes_coloca_byte(codigo, Byte(deslocamento))
    fecha
    bytes_coloca_byte(codigo, 69)
    bytes_coloca_byte(codigo, 136)
    bytes_coloca_byte(codigo, 113)
    bytes_coloca_byte(codigo, Byte(indice))
    vira indice := indice + 1
  fecha

  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 195)
  bytes_coloca_byte(codigo, Byte(largura))
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)
  x64_bytes_push_nulo(codigo)
fecha

