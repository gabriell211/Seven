campo x64_runtime_bytes_novo(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo
) -> Nada ::
  x64_runtime_aloca(codigo, virtual_alloc_patches, alvo, 32)
  bytes_coloca_byte(codigo, 73)
