campo x64_syscall_fs_emite(
  codigo: Bytes,
  imports_windows: Lista<PatchImportWindowsX64>,
  alvo: AlvoNativo,
  nome: Texto,
  aridade: U32
) -> Bit ::
  veja nome == "sys_arquivo_existe" e aridade == 1 ::
    veja alvo.formato == "elf" ::
      x64_fs_linux_existe(codigo)
    outro ::
      x64_fs_windows_existe(codigo, imports_windows)
    fecha
    devolve sim
  fecha

  veja nome == "sys_arquivo_grava_texto" e aridade == 2 ::
    veja alvo.formato == "elf" ::
      x64_fs_linux_grava_texto(codigo)
    outro ::
      x64_fs_windows_grava_texto(codigo, imports_windows)
    fecha
    devolve sim
  fecha

  veja nome == "sys_arquivo_le_texto" e aridade == 1 ::
    veja alvo.formato == "elf" ::
      x64_fs_linux_le_texto(codigo)
    outro ::
      x64_fs_windows_le_texto(codigo, imports_windows)
    fecha
    devolve sim
  fecha

  veja nome == "sys_arquivo_permissao" e aridade == 2 ::
    veja alvo.formato == "elf" ::
      x64_fs_linux_permissao(codigo)
    outro ::
      x64_fs_windows_permissao(codigo)
    fecha
    devolve sim
  fecha

  devolve nao
fecha

