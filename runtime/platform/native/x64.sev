campo x64_emite_saida(saida: CodigoX64, alvo: AlvoNativo) -> Nada ::
  bytes_coloca_byte(saida.bytes, 72)
  bytes_coloca_byte(saida.bytes, 209)
  bytes_coloca_byte(saida.bytes, 232)

  veja alvo.formato == "elf" ::
    bytes_coloca_byte(saida.bytes, 72)
    bytes_coloca_byte(saida.bytes, 137)
    bytes_coloca_byte(saida.bytes, 199)
    bytes_coloca_byte(saida.bytes, 184)
