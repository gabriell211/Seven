campo x64_syscall_pura(codigo: Bytes, nome: Texto, aridade: U32) -> Resultado<Nada, Falha> ::
  veja nome == "sys_num_mod" e aridade == 2 ::
    bytes_coloca_byte(codigo, 89)
    bytes_coloca_byte(codigo, 88)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 209)
    bytes_coloca_byte(codigo, 249)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 209)
    bytes_coloca_byte(codigo, 248)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 153)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 247)
    bytes_coloca_byte(codigo, 249)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 209)
    bytes_coloca_byte(codigo, 226)
    bytes_coloca_byte(codigo, 82)
    devolve Valor(nulo)
  fecha

  veja nome == "sys_bit_nao" e aridade == 1 ::
    x64_bit_nao(codigo)
    devolve Valor(nulo)
  fecha

  veja nome == "sys_bit_e" e aridade == 2 ::
    bytes_coloca_byte(codigo, 89)
    bytes_coloca_byte(codigo, 88)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 33)
    bytes_coloca_byte(codigo, 200)
    bytes_coloca_byte(codigo, 80)
    devolve Valor(nulo)
  fecha

  veja nome == "sys_bit_ou" e aridade == 2 ::
    bytes_coloca_byte(codigo, 89)
    bytes_coloca_byte(codigo, 88)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 9)
    bytes_coloca_byte(codigo, 200)
    bytes_coloca_byte(codigo, 80)
    devolve Valor(nulo)
  fecha

  veja nome == "sys_texto_tamanho" e aridade == 1 ::
    bytes_coloca_byte(codigo, 88)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 131)
    bytes_coloca_byte(codigo, 232)
    bytes_coloca_byte(codigo, 1)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 139)
    bytes_coloca_byte(codigo, 64)
    bytes_coloca_byte(codigo, 8)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 209)
    bytes_coloca_byte(codigo, 224)
    bytes_coloca_byte(codigo, 80)
    devolve Valor(nulo)
  fecha

  devolve Falha(nova_falha("SV-NATIVE-SYSCALL", "syscall ainda nao ligada ao runtime nativo: " + nome))
fecha

