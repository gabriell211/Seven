campo x64_aloca_imediato(saida: CodigoX64, alvo: AlvoNativo, tamanho: U64) -> Nada ::
  veja alvo.formato == "elf" ::
    bytes_coloca_byte(saida.bytes, 72)
    bytes_coloca_byte(saida.bytes, 190)
    nativo_u64_le(saida.bytes, tamanho)
    x64_linux_mmap(saida.bytes)
    devolve nulo
  fecha

  bytes_coloca_byte(saida.bytes, 72)
  bytes_coloca_byte(saida.bytes, 186)
  nativo_u64_le(saida.bytes, tamanho)
  x64_windows_virtual_alloc(saida)
fecha

