  bytes_coloca_byte(saida.bytes, 255)
  bytes_coloca_byte(saida.bytes, 21)
  guarda pos := saida.bytes.tamanho
  nativo_u32_le(saida.bytes, 0)
  lista_coloca(saida.exit_process_patches, pos)
  bytes_coloca_byte(saida.bytes, 204)
fecha
