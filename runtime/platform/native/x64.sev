    bytes_coloca_byte(saida.bytes, 0)
    bytes_coloca_byte(saida.bytes, 15)
    bytes_coloca_byte(saida.bytes, 5)
    devolve nulo
  fecha

  bytes_coloca_byte(saida.bytes, 137)
  bytes_coloca_byte(saida.bytes, 193)
  bytes_coloca_byte(saida.bytes, 72)
  bytes_coloca_byte(saida.bytes, 131)
  bytes_coloca_byte(saida.bytes, 228)
  bytes_coloca_byte(saida.bytes, 240)
  bytes_coloca_byte(saida.bytes, 72)
  bytes_coloca_byte(saida.bytes, 131)
  bytes_coloca_byte(saida.bytes, 236)
