campo x64_tcp_linux_escuta(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo
) -> Nada ::
  x64_tcp_descarta_host_porta(codigo)

  bytes_coloca_byte(codigo, 191)
  nativo_u32_le(codigo, 2)
  bytes_coloca_byte(codigo, 190)
  nativo_u32_le(codigo, 1)
  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 210)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 41)
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, 5)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 192)
  guarda socket_falhou := x64_runtime_jcc(codigo, 136)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 199)

  x64_tcp_sockaddr_loopback(codigo)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 230)
  bytes_coloca_byte(codigo, 186)
  nativo_u32_le(codigo, 16)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 49)
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, 5)
  x64_tcp_sockaddr_libera(codigo)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 192)
  guarda bind_falhou := x64_runtime_jcc(codigo, 136)

  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 190)
  nativo_u32_le(codigo, 128)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 50)
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, 5)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 192)
  guarda listen_falhou := x64_runtime_jcc(codigo, 136)

  x64_runtime_push_objeto_id_r15(codigo, virtual_alloc_patches, alvo, "ListenerTcp")
  x64_runtime_push_resultado_valor_da_pilha(codigo, virtual_alloc_patches, alvo)
  guarda fim := x64_runtime_jmp(codigo)

  guarda fecha_socket := codigo.tamanho
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 3)
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, 5)

  guarda falha := codigo.tamanho
  x64_runtime_push_resultado_falha(
    codigo,
    virtual_alloc_patches,
    alvo,
    "SV-NATIVE-TCP-LISTEN",
    "nao foi possivel abrir o listener TCP nativo"
  )

  guarda fim_real := codigo.tamanho
  x64_runtime_patch(codigo, socket_falhou, falha)
  x64_runtime_patch(codigo, bind_falhou, fecha_socket)
  x64_runtime_patch(codigo, listen_falhou, fecha_socket)
  x64_runtime_patch(codigo, fim, fim_real)
fecha

