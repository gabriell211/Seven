modulo seven.runtime.platform.native.syscall_net

usa seven.runtime.platform.native.bytes
usa seven.runtime.platform.native.imports
usa seven.runtime.platform.native.object_runtime
usa seven.runtime.platform.native.target
usa seven.runtime.platform.native.value_build
usa std.base.lista
usa std.mem.bytes

const TcpBufferNativo: U64 := 65536
const TipoBytesTcp: U64 := 4

campo x64_syscall_net_emite(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  imports_windows: Lista<PatchImportWindowsX64>,
  alvo: AlvoNativo,
  nome: Texto,
  aridade: U32
) -> Bit ::
  veja nome == "sys_tcp_escuta" e aridade == 2 ::
    veja alvo.formato == "elf" ::
      x64_tcp_linux_escuta(codigo, virtual_alloc_patches, alvo)
    outro ::
      x64_tcp_windows_escuta(codigo, virtual_alloc_patches, imports_windows, alvo)
    fecha
    devolve sim
  fecha

  veja nome == "sys_tcp_aceita" e aridade == 1 ::
    veja alvo.formato == "elf" ::
      x64_tcp_linux_aceita(codigo, virtual_alloc_patches, alvo)
    outro ::
      x64_tcp_windows_aceita(codigo, virtual_alloc_patches, imports_windows, alvo)
    fecha
    devolve sim
  fecha

  veja nome == "sys_tcp_le" e aridade == 1 ::
    veja alvo.formato == "elf" ::
      x64_tcp_linux_le(codigo, virtual_alloc_patches, alvo)
    outro ::
      x64_tcp_windows_le(codigo, virtual_alloc_patches, imports_windows, alvo)
    fecha
    devolve sim
  fecha

  veja nome == "sys_tcp_escreve" e aridade == 2 ::
    veja alvo.formato == "elf" ::
      x64_tcp_linux_escreve(codigo, virtual_alloc_patches, alvo)
    outro ::
      x64_tcp_windows_escreve(codigo, virtual_alloc_patches, imports_windows, alvo)
    fecha
    devolve sim
  fecha

  veja nome == "sys_tcp_fecha" e aridade == 1 ::
    veja alvo.formato == "elf" ::
      x64_tcp_linux_fecha(codigo, virtual_alloc_patches, alvo)
    outro ::
      x64_tcp_windows_fecha(codigo, virtual_alloc_patches, imports_windows, alvo)
    fecha
    devolve sim
  fecha

  devolve nao
fecha

