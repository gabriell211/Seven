modulo seven.runtime.platform.native.pe_imports

usa seven.runtime.platform.native.bytes
usa seven.runtime.platform.native.win_imports
usa std.mem.bytes

const PeImportsRva: U64 := 8192
const PeImportsOftOffset: U64 := 40
const PeImportsIatOffset: U64 := 112
const PeImportsDllOffset: U64 := 184
const PeHintExitProcess: U64 := 197
const PeHintVirtualAlloc: U64 := 211
const PeHintGetStdHandle: U64 := 226
const PeHintWriteFile: U64 := 241
const PeHintCreateFileA: U64 := 253
const PeHintReadFile: U64 := 267
const PeHintGetFileSizeEx: U64 := 278
const PeHintCloseHandle: U64 := 294
const PeImportsTamanho: U64 := 308

campo pe_imports_exit_rva() -> U64 :: devolve PeImportsRva + PeImportsIatOffset fecha
campo pe_imports_virtual_alloc_rva() -> U64 :: devolve PeImportsRva + PeImportsIatOffset + 8 fecha
campo pe_imports_iat_rva() -> U64 :: devolve PeImportsRva + PeImportsIatOffset fecha
campo pe_imports_iat_tamanho() -> U64 :: devolve 72 fecha
campo pe_imports_diretorio_tamanho() -> U64 :: devolve 40 fecha

campo pe_imports_aplica(codigo: Bytes, text_rva: U64) -> Nada ::
  solta indice: U64 := 0
  gira indice + 6 <= codigo.tamanho ::
    veja bytes_pega(codigo, indice) == 255 e bytes_pega(codigo, indice + 1) == 21 ::
      guarda marcador := pe_imports_u32_le(codigo, indice + 2)
      guarda iat := pe_imports_marcador_iat(marcador)
      veja iat >= 0 ::
        guarda posicao := indice + 2
        guarda relativo := iat - Num(text_rva + posicao + 4)
        nativo_define_u32_le(codigo, posicao, relativo)
      fecha
    fecha
    vira indice := indice + 1
  fecha
fecha

campo pe_imports_marcador_iat(marcador: U64) -> Num ::
  veja marcador == WinImportGetStdHandle :: devolve Num(PeImportsRva + PeImportsIatOffset + 16) fecha
  veja marcador == WinImportWriteFile :: devolve Num(PeImportsRva + PeImportsIatOffset + 24) fecha
  veja marcador == WinImportCreateFileA :: devolve Num(PeImportsRva + PeImportsIatOffset + 32) fecha
  veja marcador == WinImportReadFile :: devolve Num(PeImportsRva + PeImportsIatOffset + 40) fecha
  veja marcador == WinImportGetFileSizeEx :: devolve Num(PeImportsRva + PeImportsIatOffset + 48) fecha
  veja marcador == WinImportCloseHandle :: devolve Num(PeImportsRva + PeImportsIatOffset + 56) fecha
  devolve -1
fecha

campo pe_imports_u32_le(dados: Bytes, posicao: U64) -> U64 ::
  devolve U64(bytes_pega(dados, posicao)) +
    U64(bytes_pega(dados, posicao + 1)) * 256 +
    U64(bytes_pega(dados, posicao + 2)) * 65536 +
    U64(bytes_pega(dados, posicao + 3)) * 16777216
fecha

campo pe_imports_idata() -> Bytes ::
  solta idata := bytes_novo()
  guarda oft_rva := PeImportsRva + PeImportsOftOffset
  guarda iat_rva := PeImportsRva + PeImportsIatOffset
  guarda dll_rva := PeImportsRva + PeImportsDllOffset

  nativo_u32_le(idata, oft_rva)
  nativo_u32_le(idata, 0)
  nativo_u32_le(idata, 0)
  nativo_u32_le(idata, dll_rva)
  nativo_u32_le(idata, iat_rva)
  nativo_preenche_ate(idata, 40, 0)
  pe_imports_thunks(idata)
  pe_imports_thunks(idata)

  bytes_coloca_texto(idata, "KERNEL32.dll")
  bytes_coloca_byte(idata, 0)
  nativo_preenche_ate(idata, PeHintExitProcess, 0)
  pe_imports_hint(idata, "ExitProcess")
  nativo_preenche_ate(idata, PeHintVirtualAlloc, 0)
  pe_imports_hint(idata, "VirtualAlloc")
  nativo_preenche_ate(idata, PeHintGetStdHandle, 0)
  pe_imports_hint(idata, "GetStdHandle")
  nativo_preenche_ate(idata, PeHintWriteFile, 0)
  pe_imports_hint(idata, "WriteFile")
  nativo_preenche_ate(idata, PeHintCreateFileA, 0)
  pe_imports_hint(idata, "CreateFileA")
  nativo_preenche_ate(idata, PeHintReadFile, 0)
  pe_imports_hint(idata, "ReadFile")
  nativo_preenche_ate(idata, PeHintGetFileSizeEx, 0)
  pe_imports_hint(idata, "GetFileSizeEx")
  nativo_preenche_ate(idata, PeHintCloseHandle, 0)
  pe_imports_hint(idata, "CloseHandle")
  nativo_preenche_ate(idata, PeImportsTamanho, 0)
  devolve idata
fecha

campo pe_imports_thunks(idata: Bytes) -> Nada ::
  nativo_u64_le(idata, PeImportsRva + PeHintExitProcess)
  nativo_u64_le(idata, PeImportsRva + PeHintVirtualAlloc)
  nativo_u64_le(idata, PeImportsRva + PeHintGetStdHandle)
  nativo_u64_le(idata, PeImportsRva + PeHintWriteFile)
  nativo_u64_le(idata, PeImportsRva + PeHintCreateFileA)
  nativo_u64_le(idata, PeImportsRva + PeHintReadFile)
  nativo_u64_le(idata, PeImportsRva + PeHintGetFileSizeEx)
  nativo_u64_le(idata, PeImportsRva + PeHintCloseHandle)
  nativo_u64_le(idata, 0)
fecha

campo pe_imports_hint(idata: Bytes, nome: Texto) -> Nada ::
  nativo_u16_le(idata, 0)
  bytes_coloca_texto(idata, nome)
  bytes_coloca_byte(idata, 0)
fecha
