modulo seven.runtime.platform.native.linker

usa seven.runtime.platform.native.elf
usa seven.runtime.platform.native.pe
usa seven.runtime.platform.native.target
usa seven.runtime.platform.native.x64
usa seven.runtime.svbc.image
usa std.base.lista
usa std.base.resultado
usa std.fs.file
usa std.mem.bytes

molde ArtefatoNativo ::
  alvo: AlvoNativo
  bytes: Bytes
  simbolos: Lista<Texto>
fecha

campo baixa_nativo(imagem: ImagemSvbc, alvo: AlvoNativo) -> Resultado<ArtefatoNativo, Falha> toca disco ::
  guarda recursos := valida_recursos(alvo)

  veja recursos e Falha ::
    devolve Falha(recursos.valor)
  fecha

  veja alvo.arquitetura != "x86_64" ::
    devolve Falha(nova_falha("SV-NATIVE-ARQ", "arquitetura nativa ainda nao suportada: " + alvo.arquitetura))
  fecha

  guarda codigo := x64_compila(imagem, alvo)
  veja codigo e Falha ::
    devolve Falha(codigo.valor)
  fecha

  solta binario := bytes_novo()
  veja alvo.formato == "elf" ::
    vira binario := elf_x64(codigo.valor)
  outro ::
    veja alvo.formato == "exe" ::
      vira binario := pe_x64(codigo.valor)
    outro ::
      devolve Falha(nova_falha("SV-NATIVE-FORMATO", "formato nativo desconhecido: " + alvo.formato))
    fecha
  fecha

  solta simbolos := lista<Texto>()
  lista_coloca(simbolos, alvo.entrada)
  devolve Valor(ArtefatoNativo {
    alvo: alvo,
    bytes: binario,
    simbolos: simbolos
  })
fecha

campo grava_nativo(artefato: ArtefatoNativo, caminho: Texto) -> Resultado<Nada, Falha> toca disco ::
  guarda gravacao := arquivo_salva_bytes(caminho, artefato.bytes)

  veja gravacao e Falha ::
    devolve gravacao
  fecha

  veja artefato.alvo.formato == "elf" ::
    devolve sys_arquivo_permissao(caminho, 493)
  fecha

  devolve Valor(nulo)
fecha

campo valida_recursos(alvo: AlvoNativo) -> Resultado<Nada, Falha> toca disco ::
  para cada recurso em alvo.recursos ::
    veja arquivo_existe(recurso.caminho) == nao ::
      devolve Falha(nova_falha(
        "SV-NATIVE-RECURSO",
        "recurso nativo ausente: " + recurso.caminho
      ))
    fecha
  fecha

  devolve Valor(nulo)
fecha
