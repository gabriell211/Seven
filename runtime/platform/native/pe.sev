modulo seven.runtime.platform.native.pe

usa seven.runtime.platform.native.bytes
usa seven.runtime.platform.native.imports
usa seven.runtime.platform.native.x64
usa std.base.lista
usa std.mem.bytes

const PeHeadersX64: U64 := 512
const PeTextRvaX64: U64 := 4096
const PeFileAlignX64: U64 := 512
const PeSectionAlignX64: U64 := 4096

molde PeImportLayoutX64 ::
  bytes: Bytes
  nomes: Lista<Texto>
  dlls: Lista<Texto>
  iat_offsets: Lista<U64>
  iat_offset: U64
  iat_tamanho: U64
  diretorio_tamanho: U64
fecha

campo pe_x64(codigo: CodigoX64) -> Bytes ::
  guarda texto_virtual := nativo_alinha(codigo.bytes.tamanho, PeSectionAlignX64)
  guarda idata_rva := PeTextRvaX64 + texto_virtual
  guarda nomes_importados := pe_import_nomes(codigo)
  guarda dlls_importadas := pe_import_dlls(codigo)
  guarda imports := pe_idata_x64(idata_rva, nomes_importados, dlls_importadas)
  guarda exit_rva := pe_import_iat_rva(imports, idata_rva, "KERNEL32.dll", "ExitProcess")
  guarda virtual_alloc_rva := pe_import_iat_rva(imports, idata_rva, "KERNEL32.dll", "VirtualAlloc")

  para cada posicao em codigo.exit_process_patches ::
    guarda relativo := Num(exit_rva) - Num(PeTextRvaX64 + posicao + 4)
    nativo_define_u32_le(codigo.bytes, posicao, relativo)
  fecha

  para cada posicao em codigo.virtual_alloc_patches ::
    guarda relativo := Num(virtual_alloc_rva) - Num(PeTextRvaX64 + posicao + 4)
    nativo_define_u32_le(codigo.bytes, posicao, relativo)
  fecha

  para cada patch em codigo.imports_windows ::
    guarda import_rva := pe_import_iat_rva(imports, idata_rva, patch.dll, patch.nome)
    guarda relativo := Num(import_rva) - Num(PeTextRvaX64 + patch.posicao + 4)
    nativo_define_u32_le(codigo.bytes, patch.posicao, relativo)
  fecha

  guarda texto_raw := nativo_alinha(codigo.bytes.tamanho, PeFileAlignX64)
  guarda idata_raw := nativo_alinha(imports.bytes.tamanho, PeFileAlignX64)
  guarda idata_offset := PeHeadersX64 + texto_raw
  guarda imagem_tamanho := nativo_alinha(idata_rva + imports.bytes.tamanho, PeSectionAlignX64)
  solta arquivo := bytes_novo()

  pe_dos_header(arquivo)
  pe_coff_header(arquivo)
  pe_optional_header(
    arquivo,
    codigo,
    texto_raw,
    idata_raw,
    idata_rva,
    imagem_tamanho,
    imports.iat_offset,
    imports.iat_tamanho,
    imports.diretorio_tamanho
  )
  pe_section_header(arquivo, ".text", codigo.bytes.tamanho, PeTextRvaX64, texto_raw, PeHeadersX64, 1610612768)
  pe_section_header(arquivo, ".idata", imports.bytes.tamanho, idata_rva, idata_raw, idata_offset, 3221225536)

  nativo_preenche_ate(arquivo, PeHeadersX64, 0)
  nativo_anexa(arquivo, codigo.bytes)
  nativo_preenche_ate(arquivo, PeHeadersX64 + texto_raw, 0)
  nativo_anexa(arquivo, imports.bytes)
  nativo_preenche_ate(arquivo, PeHeadersX64 + texto_raw + idata_raw, 0)
  devolve arquivo
fecha

campo pe_import_nomes(codigo: CodigoX64) -> Lista<Texto> ::
  solta nomes := lista<Texto>()
  solta dlls := lista<Texto>()
  pe_import_adiciona(nomes, dlls, "KERNEL32.dll", "ExitProcess")
  pe_import_adiciona(nomes, dlls, "KERNEL32.dll", "VirtualAlloc")

  para cada patch em codigo.imports_windows ::
    pe_import_adiciona(nomes, dlls, patch.dll, patch.nome)
  fecha
  devolve nomes
fecha

campo pe_import_dlls(codigo: CodigoX64) -> Lista<Texto> ::
  solta nomes := lista<Texto>()
  solta dlls := lista<Texto>()
  pe_import_adiciona(nomes, dlls, "KERNEL32.dll", "ExitProcess")
  pe_import_adiciona(nomes, dlls, "KERNEL32.dll", "VirtualAlloc")

  para cada patch em codigo.imports_windows ::
    pe_import_adiciona(nomes, dlls, patch.dll, patch.nome)
  fecha
  devolve dlls
fecha

campo pe_import_adiciona(
  nomes: Lista<Texto>,
  dlls: Lista<Texto>,
  dll: Texto,
  nome: Texto
) -> Nada ::
  solta indice: U64 := 0
  gira indice < lista_tamanho(nomes) ::
    veja lista_pega(nomes, indice) == nome e lista_pega(dlls, indice) == dll ::
      devolve nulo
    fecha
    vira indice := indice + 1
  fecha
  lista_coloca(nomes, nome)
  lista_coloca(dlls, dll)
fecha

campo pe_import_indice(layout: PeImportLayoutX64, dll: Texto, nome: Texto) -> Num ::
  solta indice: U64 := 0
  gira indice < lista_tamanho(layout.nomes) ::
    veja lista_pega(layout.nomes, indice) == nome e lista_pega(layout.dlls, indice) == dll ::
      devolve Num(indice)
    fecha
    vira indice := indice + 1
  fecha
  devolve -1
fecha

campo pe_import_iat_rva(
  layout: PeImportLayoutX64,
  idata_rva: U64,
  dll: Texto,
  nome: Texto
) -> U64 ::
  guarda indice := pe_import_indice(layout, dll, nome)
  veja indice < 0 :: devolve 0 fecha
  devolve idata_rva + lista_pega(layout.iat_offsets, U64(indice))
fecha

campo pe_dos_header(arquivo: Bytes) -> Nada ::
  bytes_coloca_byte(arquivo, 77)
  bytes_coloca_byte(arquivo, 90)
  nativo_preenche_ate(arquivo, 60, 0)
  nativo_u32_le(arquivo, 128)
  nativo_preenche_ate(arquivo, 128, 0)
fecha

campo pe_coff_header(arquivo: Bytes) -> Nada ::
  bytes_coloca_byte(arquivo, 80)
  bytes_coloca_byte(arquivo, 69)
  bytes_coloca_byte(arquivo, 0)
  bytes_coloca_byte(arquivo, 0)
  nativo_u16_le(arquivo, 34404)
  nativo_u16_le(arquivo, 2)
  nativo_u32_le(arquivo, 0)
  nativo_u32_le(arquivo, 0)
  nativo_u32_le(arquivo, 0)
  nativo_u16_le(arquivo, 240)
  nativo_u16_le(arquivo, 34)
fecha

campo pe_optional_header(
  arquivo: Bytes,
  codigo: CodigoX64,
  texto_raw: U64,
  idata_raw: U64,
  idata_rva: U64,
  imagem_tamanho: U64,
  iat_offset: U64,
  iat_tamanho: U64,
  import_directory_tamanho: U64
) -> Nada ::
  nativo_u16_le(arquivo, 523)
  bytes_coloca_byte(arquivo, 0)
  bytes_coloca_byte(arquivo, 0)
  nativo_u32_le(arquivo, texto_raw)
  nativo_u32_le(arquivo, idata_raw)
  nativo_u32_le(arquivo, 0)
  nativo_u32_le(arquivo, PeTextRvaX64 + codigo.entrada)
  nativo_u32_le(arquivo, PeTextRvaX64)
  nativo_u64_le(arquivo, 5368709120)
  nativo_u32_le(arquivo, PeSectionAlignX64)
  nativo_u32_le(arquivo, PeFileAlignX64)
  nativo_u16_le(arquivo, 6)
  nativo_u16_le(arquivo, 0)
  nativo_u16_le(arquivo, 0)
  nativo_u16_le(arquivo, 0)
  nativo_u16_le(arquivo, 6)
  nativo_u16_le(arquivo, 0)
  nativo_u32_le(arquivo, 0)
  nativo_u32_le(arquivo, imagem_tamanho)
  nativo_u32_le(arquivo, PeHeadersX64)
  nativo_u32_le(arquivo, 0)
  nativo_u16_le(arquivo, 3)
  nativo_u16_le(arquivo, 256)
  nativo_u64_le(arquivo, 1048576)
  nativo_u64_le(arquivo, 4096)
  nativo_u64_le(arquivo, 1048576)
  nativo_u64_le(arquivo, 4096)
  nativo_u32_le(arquivo, 0)
  nativo_u32_le(arquivo, 16)

  solta indice: U64 := 0
  gira indice < 16 ::
    veja indice == 1 ::
      nativo_u32_le(arquivo, idata_rva)
      nativo_u32_le(arquivo, import_directory_tamanho)
    outro ::
      veja indice == 12 ::
        nativo_u32_le(arquivo, idata_rva + iat_offset)
        nativo_u32_le(arquivo, iat_tamanho)
      outro ::
        nativo_u32_le(arquivo, 0)
        nativo_u32_le(arquivo, 0)
      fecha
    fecha
    vira indice := indice + 1
  fecha
fecha

campo pe_section_header(
  arquivo: Bytes,
  nome: Texto,
  virtual_tamanho: U64,
  virtual_rva: U64,
  raw_tamanho: U64,
  raw_offset: U64,
  caracteristicas: U64
) -> Nada ::
  nativo_nome_secao(arquivo, nome)
  nativo_u32_le(arquivo, virtual_tamanho)
  nativo_u32_le(arquivo, virtual_rva)
  nativo_u32_le(arquivo, raw_tamanho)
  nativo_u32_le(arquivo, raw_offset)
  nativo_u32_le(arquivo, 0)
  nativo_u32_le(arquivo, 0)
  nativo_u16_le(arquivo, 0)
  nativo_u16_le(arquivo, 0)
  nativo_u32_le(arquivo, caracteristicas)
fecha

campo pe_idata_x64(
  idata_rva: U64,
  nomes: Lista<Texto>,
  dlls: Lista<Texto>
) -> PeImportLayoutX64 ::
  solta kernel_nomes := lista<Texto>()
  solta winsock_nomes := lista<Texto>()

  solta indice: U64 := 0
  gira indice < lista_tamanho(nomes) ::
    veja lista_pega(dlls, indice) == "WS2_32.dll" ::
      lista_coloca(winsock_nomes, lista_pega(nomes, indice))
    outro ::
      lista_coloca(kernel_nomes, lista_pega(nomes, indice))
    fecha
    vira indice := indice + 1
  fecha

  guarda tem_winsock := lista_tamanho(winsock_nomes) > 0
  guarda qtd_dll: U64 := 1
  veja tem_winsock :: vira qtd_dll := 2 fecha
  guarda diretorio_tamanho := (qtd_dll + 1) * 20

  guarda kernel_qtd := U64(lista_tamanho(kernel_nomes))
  guarda winsock_qtd := U64(lista_tamanho(winsock_nomes))
  guarda kernel_tabela := (kernel_qtd + 1) * 8
  guarda winsock_tabela := (winsock_qtd + 1) * 8

  guarda kernel_oft := diretorio_tamanho
  guarda winsock_oft := kernel_oft + kernel_tabela
  guarda kernel_iat := winsock_oft + winsock_tabela
  guarda winsock_iat := kernel_iat + kernel_tabela

  guarda kernel_dll_offset := winsock_iat + winsock_tabela
  guarda kernel_dll_bytes := texto_bytes("KERNEL32.dll")
  solta cursor := nativo_alinha(kernel_dll_offset + kernel_dll_bytes.tamanho + 1, 2)

  solta winsock_dll_offset: U64 := 0
  veja tem_winsock ::
    vira winsock_dll_offset := cursor
    guarda winsock_dll_bytes := texto_bytes("WS2_32.dll")
    vira cursor := nativo_alinha(winsock_dll_offset + winsock_dll_bytes.tamanho + 1, 2)
  fecha

  solta kernel_hints := lista<U64>()
  para cada nome em kernel_nomes ::
    lista_coloca(kernel_hints, cursor)
    guarda dados := texto_bytes(nome)
    vira cursor := nativo_alinha(cursor + 2 + dados.tamanho + 1, 2)
  fecha

  solta winsock_hints := lista<U64>()
  para cada nome em winsock_nomes ::
    lista_coloca(winsock_hints, cursor)
    guarda dados := texto_bytes(nome)
    vira cursor := nativo_alinha(cursor + 2 + dados.tamanho + 1, 2)
  fecha

  solta idata := bytes_novo()

  nativo_u32_le(idata, idata_rva + kernel_oft)
  nativo_u32_le(idata, 0)
  nativo_u32_le(idata, 0)
  nativo_u32_le(idata, idata_rva + kernel_dll_offset)
  nativo_u32_le(idata, idata_rva + kernel_iat)

  veja tem_winsock ::
    nativo_u32_le(idata, idata_rva + winsock_oft)
    nativo_u32_le(idata, 0)
    nativo_u32_le(idata, 0)
    nativo_u32_le(idata, idata_rva + winsock_dll_offset)
    nativo_u32_le(idata, idata_rva + winsock_iat)
  fecha

  nativo_preenche_ate(idata, diretorio_tamanho, 0)

  para cada offset em kernel_hints :: nativo_u64_le(idata, idata_rva + offset) fecha
  nativo_u64_le(idata, 0)
  para cada offset em winsock_hints :: nativo_u64_le(idata, idata_rva + offset) fecha
  nativo_u64_le(idata, 0)
  para cada offset em kernel_hints :: nativo_u64_le(idata, idata_rva + offset) fecha
  nativo_u64_le(idata, 0)
  para cada offset em winsock_hints :: nativo_u64_le(idata, idata_rva + offset) fecha
  nativo_u64_le(idata, 0)

  nativo_preenche_ate(idata, kernel_dll_offset, 0)
  bytes_coloca_texto(idata, "KERNEL32.dll")
  bytes_coloca_byte(idata, 0)

  veja tem_winsock ::
    nativo_preenche_ate(idata, winsock_dll_offset, 0)
    bytes_coloca_texto(idata, "WS2_32.dll")
    bytes_coloca_byte(idata, 0)
  fecha

  indice := 0
  gira indice < kernel_qtd ::
    guarda offset := lista_pega(kernel_hints, indice)
    guarda nome := lista_pega(kernel_nomes, indice)
    nativo_preenche_ate(idata, offset, 0)
    nativo_u16_le(idata, 0)
    bytes_coloca_texto(idata, nome)
    bytes_coloca_byte(idata, 0)
    vira indice := indice + 1
  fecha

  vira indice := 0
  gira indice < winsock_qtd ::
    guarda offset := lista_pega(winsock_hints, indice)
    guarda nome := lista_pega(winsock_nomes, indice)
    nativo_preenche_ate(idata, offset, 0)
    nativo_u16_le(idata, 0)
    bytes_coloca_texto(idata, nome)
    bytes_coloca_byte(idata, 0)
    vira indice := indice + 1
  fecha

  solta iat_offsets := lista<U64>()
  indice := 0
  gira indice < lista_tamanho(nomes) ::
    guarda nome := lista_pega(nomes, indice)
    guarda dll := lista_pega(dlls, indice)
    veja dll == "WS2_32.dll" ::
      guarda local := pe_lista_indice_texto(winsock_nomes, nome)
      lista_coloca(iat_offsets, winsock_iat + U64(local) * 8)
    outro ::
      guarda local := pe_lista_indice_texto(kernel_nomes, nome)
      lista_coloca(iat_offsets, kernel_iat + U64(local) * 8)
    fecha
    vira indice := indice + 1
  fecha

  guarda iat_inicio := kernel_iat
  guarda iat_fim := kernel_iat + kernel_tabela
  veja tem_winsock ::
    vira iat_fim := winsock_iat + winsock_tabela
  fecha

  devolve PeImportLayoutX64 {
    bytes: idata,
    nomes: nomes,
    dlls: dlls,
    iat_offsets: iat_offsets,
    iat_offset: iat_inicio,
    iat_tamanho: iat_fim - iat_inicio,
    diretorio_tamanho: diretorio_tamanho
  }
fecha

campo pe_lista_indice_texto(itens: Lista<Texto>, procurado: Texto) -> Num ::
  solta indice: U64 := 0
  para cada item em itens ::
    veja item == procurado :: devolve Num(indice) fecha
    vira indice := indice + 1
  fecha
  devolve -1
fecha
