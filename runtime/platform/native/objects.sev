    bytes_coloca_byte(codigo, 255)
    bytes_coloca_byte(codigo, 255)
    bytes_coloca_byte(codigo, 69)
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 201)
    bytes_coloca_byte(codigo, 184)
    nativo_u32_le(codigo, 9)
    bytes_coloca_byte(codigo, 15)
    bytes_coloca_byte(codigo, 5)
    devolve nulo
  fecha

  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 186)
  nativo_u64_le(codigo, tamanho)
  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 201)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 12288)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 185)
  nativo_u32_le(codigo, 4)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 220)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 228)
  bytes_coloca_byte(codigo, 240)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 236)
  bytes_coloca_byte(codigo, 48)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 32)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 21)
  guarda pos := codigo.tamanho
  nativo_u32_le(codigo, 0)
  lista_coloca(virtual_alloc_patches, pos)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 32)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 220)
fecha

campo x64_obj_mov_rax(codigo: Bytes, valor: U64) -> Nada ::
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 184)
  nativo_u64_le(codigo, valor)
fecha

campo x64_obj_carrega_rsp(codigo: Bytes, deslocamento: U64) -> Nada ::
  veja deslocamento <= 127 ::
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 139)
    bytes_coloca_byte(codigo, 68)
    bytes_coloca_byte(codigo, 36)
    bytes_coloca_byte(codigo, Byte(deslocamento))
    devolve nulo
  fecha
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 132)
  bytes_coloca_byte(codigo, 36)
  nativo_u32_le(codigo, deslocamento)
fecha

campo x64_obj_grava_r13(codigo: Bytes, deslocamento: U64) -> Nada ::
  veja deslocamento <= 127 ::
    bytes_coloca_byte(codigo, 73)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 69)
    bytes_coloca_byte(codigo, Byte(deslocamento))
    devolve nulo
  fecha
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 133)
  nativo_u32_le(codigo, deslocamento)
fecha

campo x64_obj_jcc(codigo: Bytes, condicao: Byte) -> U64 ::
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, condicao)
  guarda pos := codigo.tamanho
  nativo_u32_le(codigo, 0)
  devolve pos
fecha

campo x64_obj_jmp(codigo: Bytes) -> U64 ::
  bytes_coloca_byte(codigo, 233)
  guarda pos := codigo.tamanho
  nativo_u32_le(codigo, 0)
  devolve pos
fecha

campo x64_obj_patch_rel32(codigo: Bytes, posicao: U64, destino: U64) -> Nada ::
  nativo_define_u32_le(codigo, posicao, Num(destino) - Num(posicao + 4))
fecha
