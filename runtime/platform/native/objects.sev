  bytes_coloca_byte(codigo, 94)
  bytes_coloca_byte(codigo, 88)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 232)
  bytes_coloca_byte(codigo, 1)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 196)

  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 108)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 24)
  bytes_coloca_byte(codigo, 69)
  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 255)

  guarda loop := codigo.tamanho
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 57)
  bytes_coloca_byte(codigo, 223)
  guarda nao_encontrou := x64_obj_jcc(codigo, 132)

  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 117)
  bytes_coloca_byte(codigo, 0)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 86)
  x64_obj_texto_igual(codigo)
  bytes_coloca_byte(codigo, 88)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 192)
  guarda encontrou := x64_obj_jcc(codigo, 133)

  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 197)
  bytes_coloca_byte(codigo, 16)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 199)
  guarda volta := x64_obj_jmp(codigo)
  x64_obj_patch_rel32(codigo, volta, loop)

  guarda achado := codigo.tamanho
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 69)
  bytes_coloca_byte(codigo, 8)
  bytes_coloca_byte(codigo, 80)
  guarda fim_achado := x64_obj_jmp(codigo)

  guarda ausente := codigo.tamanho
  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 192)
  bytes_coloca_byte(codigo, 80)

  guarda fim := codigo.tamanho
  x64_obj_patch_rel32(codigo, nao_encontrou, ausente)
  x64_obj_patch_rel32(codigo, encontrou, achado)
  x64_obj_patch_rel32(codigo, fim_achado, fim)
fecha

