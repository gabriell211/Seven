modulo seven.runtime.platform.native.objects

usa seven.runtime.platform.native.bytes
usa seven.runtime.platform.native.target
usa std.base.lista
usa std.mem.bytes

const TipoNativoObjeto: U64 := 3
const CapacidadeListaNativa: U64 := 64

campo x64_obj_novo(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo,
  aridade: U32
) -> Nada ::
  guarda pares := U64(aridade / 2)
  guarda capacidade := pares + 64

  x64_obj_aloca_imediato(codigo, virtual_alloc_patches, alvo, 48)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 196)

  x64_obj_aloca_imediato(codigo, virtual_alloc_patches, alvo, capacidade * 16)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 197)

  x64_obj_mov_rax(codigo, TipoNativoObjeto)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 4)
  bytes_coloca_byte(codigo, 36)

  x64_obj_mov_rax(codigo, pares)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)

  x64_obj_mov_rax(codigo, capacidade)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 16)

  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 108)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 24)

  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 192)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 32)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 40)

  solta par: U64 := 0
  gira par < pares ::
    guarda argumento_chave := U64(aridade) - 1 - (par * 2)
    guarda argumento_valor := argumento_chave - 1
    x64_obj_carrega_rsp(codigo, argumento_chave * 8)
    x64_obj_grava_r13(codigo, par * 16)
    x64_obj_carrega_rsp(codigo, argumento_valor * 8)
    x64_obj_grava_r13(codigo, par * 16 + 8)
    vira par := par + 1
  fecha

  veja aridade > 0 ::
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 129)
    bytes_coloca_byte(codigo, 196)
    nativo_u32_le(codigo, U64(aridade) * 8)
  fecha

  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 1)
  bytes_coloca_byte(codigo, 80)
fecha

