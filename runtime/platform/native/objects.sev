  bytes_coloca_byte(codigo, 192)
  guarda fim := codigo.tamanho
  bytes_coloca_byte(codigo, 80)

  x64_obj_patch_rel32(codigo, igual_ponteiro, igual)
  x64_obj_patch_rel32(codigo, igual_fim, igual)
  x64_obj_patch_rel32(codigo, diferente, falso)
  x64_obj_patch_rel32(codigo, byte_diferente, falso)
  x64_obj_patch_rel32(codigo, pula_falso, fim)
fecha

campo x64_obj_aloca_imediato(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo,
