campo x64_runtime_args(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  imports_windows: Lista<PatchImportWindowsX64>,
  alvo: AlvoNativo
) -> Nada ::
  // Use the same three-pair list layout as the regular Lista constructor.
  x64_runtime_push_texto_constante(codigo, virtual_alloc_patches, alvo, "__tipo")
  x64_runtime_push_texto_constante(codigo, virtual_alloc_patches, alvo, "Lista")
  x64_runtime_push_texto_constante(codigo, virtual_alloc_patches, alvo, "tag")
  x64_runtime_push_texto_constante(codigo, virtual_alloc_patches, alvo, "Lista")
  x64_runtime_push_texto_constante(codigo, virtual_alloc_patches, alvo, "tamanho")
  x64_runtime_push_nulo(codigo)
  x64_runtime_obj_novo(codigo, virtual_alloc_patches, alvo, 6)

  // Scratch slots: list, argc, argv, index, current text allocation.
  bytes_coloca_byte(codigo, 88)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 236)
  bytes_coloca_byte(codigo, 64)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 4)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 199)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 24)
  bytes_coloca_byte(codigo, 1)
  bytes_coloca_byte(codigo, 0)
  bytes_coloca_byte(codigo, 0)
  bytes_coloca_byte(codigo, 0)
  solta falhas := lista<U64>()
  veja alvo.formato == "elf" ::
    // Follow frame links to the original ELF entry stack (argc, argv).
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 232)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 139)
    bytes_coloca_byte(codigo, 8)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 133)
    bytes_coloca_byte(codigo, 201)
    bytes_coloca_byte(codigo, 116)
    bytes_coloca_byte(codigo, 5)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 200)
    bytes_coloca_byte(codigo, 235)
    bytes_coloca_byte(codigo, 243)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 139)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 8)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 141)
    bytes_coloca_byte(codigo, 80)
    bytes_coloca_byte(codigo, 16)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 76)
    bytes_coloca_byte(codigo, 36)
    bytes_coloca_byte(codigo, 8)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 84)
    bytes_coloca_byte(codigo, 36)
    bytes_coloca_byte(codigo, 16)
  outro ::
    // Parse the UTF-16 process command line with the Windows shell API.
    x64_windows_import_chama_dll(codigo, imports_windows, "KERNEL32.dll", "GetCommandLineW", 32)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 193)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 141)
    bytes_coloca_byte(codigo, 84)
    bytes_coloca_byte(codigo, 36)
    bytes_coloca_byte(codigo, 8)
