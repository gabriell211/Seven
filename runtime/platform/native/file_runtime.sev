campo x64_file_retorna_escrita(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo,
  tipado: Bit,
  falha: U64
) -> Nada ::
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 199)
  bytes_coloca_byte(codigo, 199)
  nativo_u32_le(codigo, 0)
  veja tipado ::
    x64_resultado_valor_r15(codigo, virtual_alloc_patches, alvo)
  outro ::
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 192)
    bytes_coloca_byte(codigo, 80)
  fecha
  guarda fim_sucesso := x64_file_jmp(codigo)
  guarda erro := codigo.tamanho
  veja tipado ::
    x64_resultado_falha_generica(codigo, virtual_alloc_patches, alvo, "SV-ARQUIVO-GRAVAR", "nao foi possivel gravar o arquivo")
  outro ::
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 192)
    bytes_coloca_byte(codigo, 80)
  fecha
  guarda fim := codigo.tamanho
  x64_file_patch(codigo, falha, erro)
  x64_file_patch(codigo, fim_sucesso, fim)
fecha

campo x64_file_jcc(codigo: Bytes, condicao: Byte) -> U64 ::
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, condicao)
  guarda pos := codigo.tamanho
  nativo_u32_le(codigo, 0)
  devolve pos
fecha

campo x64_file_jmp(codigo: Bytes) -> U64 ::
  bytes_coloca_byte(codigo, 233)
  guarda pos := codigo.tamanho
  nativo_u32_le(codigo, 0)
  devolve pos
fecha

campo x64_file_patch(codigo: Bytes, posicao: U64, destino: U64) -> Nada ::
  nativo_define_u32_le(codigo, posicao, Num(destino) - Num(posicao + 4))
fecha
