  guarda fim := x64_file_jmp(codigo)

  guarda erro := codigo.tamanho
  x64_file_patch(codigo, falha_abre, erro)
  x64_file_patch(codigo, falha_tamanho, erro)
  x64_file_patch(codigo, falha_le, erro)
  x64_file_patch(codigo, fim, codigo.tamanho + 6)
