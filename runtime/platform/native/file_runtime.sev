    fecha

  x64_file_retorna_escrita(codigo, virtual_alloc_patches, alvo, tipado, falha)
fecha

campo x64_file_existe(codigo: Bytes, alvo: AlvoNativo) -> Nada ::
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 94)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 238)
  bytes_coloca_byte(codigo, 1)

  veja alvo.formato == "elf" ::
    bytes_coloca_byte(codigo, 184)
    nativo_u32_le(codigo, 257)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 199)
    bytes_coloca_byte(codigo, 199)
    nativo_u32_le(codigo, 4294967196)
    bytes_coloca_byte(codigo, 73)
    bytes_coloca_byte(codigo, 141)
    bytes_coloca_byte(codigo, 118)
    bytes_coloca_byte(codigo, 16)
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 210)
    bytes_coloca_byte(codigo, 69)
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 210)
    bytes_coloca_byte(codigo, 15)
    bytes_coloca_byte(codigo, 5)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 131)
    bytes_coloca_byte(codigo, 248)
    bytes_coloca_byte(codigo, 0)
    guarda nao := x64_file_jcc(codigo, 140)
    bytes_coloca_byte(codigo, 72)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 199)
    bytes_coloca_byte(codigo, 184)
    nativo_u32_le(codigo, 3)
    bytes_coloca_byte(codigo, 15)
    bytes_coloca_byte(codigo, 5)
    bytes_coloca_byte(codigo, 184)
    nativo_u32_le(codigo, 2)
    bytes_coloca_byte(codigo, 80)
    guarda fim_sim := x64_file_jmp(codigo)
    guarda falso := codigo.tamanho
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 192)
    bytes_coloca_byte(codigo, 80)
    guarda fim := codigo.tamanho
    x64_file_patch(codigo, nao, falso)
    x64_file_patch(codigo, fim_sim, fim)
    devolve nulo
  fecha

  x64_file_windows_abre(codigo, 2147483648, 1, 3)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 248)
  bytes_coloca_byte(codigo, 255)
  guarda nao := x64_file_jcc(codigo, 132)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 195)
  x64_file_windows_fecha(codigo)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 2)
  bytes_coloca_byte(codigo, 80)
  guarda fim_sim := x64_file_jmp(codigo)
  guarda falso := codigo.tamanho
  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 192)
  bytes_coloca_byte(codigo, 80)
  guarda fim := codigo.tamanho
  x64_file_patch(codigo, nao, falso)
  x64_file_patch(codigo, fim_sim, fim)
fecha

