campo x64_file_ler_texto(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo,
  tipado: Bit
) -> Nada ::
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 94)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 238)
  bytes_coloca_byte(codigo, 1)

  guarda falha :=
    se alvo.formato == "elf" ::
      x64_file_linux_ler_texto(codigo, virtual_alloc_patches, alvo)
    outro ::
      x64_file_windows_ler_texto(codigo, virtual_alloc_patches, alvo)
    fecha

  guarda sucesso := codigo.tamanho
  veja tipado ::
    x64_resultado_valor_r15(codigo, virtual_alloc_patches, alvo)
  outro ::
    bytes_coloca_byte(codigo, 65)
    bytes_coloca_byte(codigo, 87)
  fecha
  guarda fim_sucesso := x64_file_jmp(codigo)

  guarda erro := codigo.tamanho
  veja tipado ::
    x64_resultado_falha_generica(codigo, virtual_alloc_patches, alvo, "SV-ARQUIVO-LER", "nao foi possivel ler o arquivo")
  outro ::
    x64_literal_texto(codigo, virtual_alloc_patches, alvo, "")
  fecha

  guarda fim := codigo.tamanho
  x64_file_patch(codigo, falha, erro)
  x64_file_patch(codigo, fim_sucesso, fim)
  guarda ignora := sucesso
fecha

campo x64_file_grava_texto(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo,
  tipado: Bit
) -> Nada ::
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 94)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 95)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 239)
  bytes_coloca_byte(codigo, 1)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 238)
  bytes_coloca_byte(codigo, 1)

  guarda falha :=
    se alvo.formato == "elf" ::
      x64_file_linux_grava(codigo, 16, 8)
    outro ::
      x64_file_windows_grava(codigo, 16, 8)
    fecha

  x64_file_retorna_escrita(codigo, virtual_alloc_patches, alvo, tipado, falha)
fecha

campo x64_file_grava_bytes(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
