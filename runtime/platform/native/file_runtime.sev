campo x64_file_windows_ler_texto(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo
) -> U64 ::
  x64_file_windows_abre(codigo, 2147483648, 1, 3)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 248)
  bytes_coloca_byte(codigo, 255)
  guarda falha_abre := x64_file_jcc(codigo, 132)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 195)

  x64_io_win_inicia(codigo, 48)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 217)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 84)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 32)
  x64_windows_importa(codigo, WinImportGetFileSizeEx)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 124)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 32)
  x64_io_win_finaliza(codigo)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 192)
  guarda falha_tamanho := x64_file_jcc(codigo, 132)

  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 111)
  bytes_coloca_byte(codigo, 17)
  x64_bytes_core_aloca_r13(codigo, virtual_alloc_patches, alvo)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 196)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 199)
  bytes_coloca_byte(codigo, 3)
  nativo_u32_le(codigo, 1)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 124)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)

  x64_io_win_inicia(codigo, 48)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 217)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 84)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 16)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 248)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 141)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 40)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 199)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 32)
  nativo_u32_le(codigo, 0)
  x64_windows_importa(codigo, WinImportReadFile)
  x64_io_win_finaliza(codigo)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 192)
  guarda falha_le := x64_file_jcc(codigo, 132)

  x64_file_windows_fecha(codigo)
  bytes_coloca_byte(codigo, 67)
  bytes_coloca_byte(codigo, 198)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 60)
