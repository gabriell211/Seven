  bytes_coloca_byte(codigo, 196)
  bytes_coloca_byte(codigo, 8)
fecha

campo x64_io_windows_stdout(codigo: Bytes) -> Nada ::
  x64_io_win_inicia(codigo, 32)
  bytes_coloca_byte(codigo, 185)
  nativo_u32_le(codigo, 4294967285)
  x64_windows_importa(codigo, WinImportGetStdHandle)
  x64_io_win_finaliza(codigo)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 199)
fecha

