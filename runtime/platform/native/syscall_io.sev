modulo seven.runtime.platform.native.syscall_io

usa seven.runtime.platform.native.target
usa seven.runtime.platform.native.win_imports
usa std.mem.bytes

campo x64_syscall_io_emite(codigo: Bytes, alvo: AlvoNativo, nome: Texto, aridade: U32) -> Bit ::
  veja nome == "terminal_escreve" e aridade == 1 :: x64_io_terminal(codigo, alvo, nao) devolve sim fecha
  veja nome == "sys_terminal_escreve" e aridade == 1 :: x64_io_terminal(codigo, alvo, nao) devolve sim fecha
  veja nome == "terminal_diga" e aridade == 1 :: x64_io_terminal(codigo, alvo, sim) devolve sim fecha
  veja nome == "diga" e aridade == 1 :: x64_io_terminal(codigo, alvo, sim) devolve sim fecha
  devolve nao
fecha

campo x64_io_terminal(codigo: Bytes, alvo: AlvoNativo, nova_linha: Bit) -> Nada ::
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 94)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 238)
  bytes_coloca_byte(codigo, 1)

  veja alvo.formato == "elf" ::
    x64_io_linux_write_texto(codigo)
    veja nova_linha :: x64_io_linux_nova_linha(codigo) fecha
    x64_io_push_nulo(codigo)
    devolve nulo
  fecha

  x64_io_windows_stdout(codigo)
  x64_io_windows_write_texto(codigo)
  veja nova_linha :: x64_io_windows_nova_linha(codigo) fecha
  x64_io_push_nulo(codigo)
fecha

campo x64_io_linux_write_texto(codigo: Bytes) -> Nada ::
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 246)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 198)
  bytes_coloca_byte(codigo, 16)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 86)
  bytes_coloca_byte(codigo, 8)
  bytes_coloca_byte(codigo, 191)
  nativo_u32_le(codigo, 1)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 1)
  bytes_coloca_byte(codigo, 15)
  bytes_coloca_byte(codigo, 5)
fecha

