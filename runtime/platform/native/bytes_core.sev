campo x64_bytes_core_garante(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo
) -> Nada ::
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 84)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 16)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 57)
  bytes_coloca_byte(codigo, 215)
  guarda suficiente := x64_bytes_core_jcc(codigo, 131)

  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 213)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 133)
  bytes_coloca_byte(codigo, 237)
  guarda cap_pronta := x64_bytes_core_jcc(codigo, 133)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 199)
  bytes_coloca_byte(codigo, 197)
  nativo_u32_le(codigo, CapacidadeBytesCore)
  guarda testa := codigo.tamanho
  x64_bytes_core_patch(codigo, cap_pronta, testa)

  guarda dobra := codigo.tamanho
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 57)
  bytes_coloca_byte(codigo, 253)
  guarda aloca := x64_bytes_core_jcc(codigo, 131)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 209)
  bytes_coloca_byte(codigo, 229)
  guarda volta_dobra := x64_bytes_core_jmp(codigo)
  x64_bytes_core_patch(codigo, volta_dobra, dobra)

  guarda realoca := codigo.tamanho
  x64_bytes_core_patch(codigo, aloca, realoca)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 116)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 24)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 92)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)

  x64_bytes_core_aloca_r13(codigo, virtual_alloc_patches, alvo)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 193)

  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 201)
  guarda copia := codigo.tamanho
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 57)
  bytes_coloca_byte(codigo, 217)
  guarda copia_fim := x64_bytes_core_jcc(codigo, 131)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 138)
  bytes_coloca_byte(codigo, 20)
  bytes_coloca_byte(codigo, 14)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 136)
  bytes_coloca_byte(codigo, 20)
  bytes_coloca_byte(codigo, 9)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 193)
  guarda volta_copia := x64_bytes_core_jmp(codigo)
  x64_bytes_core_patch(codigo, volta_copia, copia)
  guarda fim_copia := codigo.tamanho
  x64_bytes_core_patch(codigo, copia_fim, fim_copia)

  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 108)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 16)
  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 76)
