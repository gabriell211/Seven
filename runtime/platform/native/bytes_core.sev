  bytes_coloca_byte(codigo, 24)

  guarda fim := codigo.tamanho
  x64_bytes_core_patch(codigo, suficiente, fim)
fecha

campo x64_bytes_core_aloca_r13(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo
) -> Nada ::
  veja alvo.formato == "elf" ::
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 255)
    bytes_coloca_byte(codigo, 76)
    bytes_coloca_byte(codigo, 137)
    bytes_coloca_byte(codigo, 238)
    bytes_coloca_byte(codigo, 186)
    nativo_u32_le(codigo, 3)
    bytes_coloca_byte(codigo, 65)
    bytes_coloca_byte(codigo, 186)
    nativo_u32_le(codigo, 34)
    bytes_coloca_byte(codigo, 73)
    bytes_coloca_byte(codigo, 199)
    bytes_coloca_byte(codigo, 192)
    bytes_coloca_byte(codigo, 255)
    bytes_coloca_byte(codigo, 255)
    bytes_coloca_byte(codigo, 255)
    bytes_coloca_byte(codigo, 69)
    bytes_coloca_byte(codigo, 49)
    bytes_coloca_byte(codigo, 201)
    bytes_coloca_byte(codigo, 184)
    nativo_u32_le(codigo, 9)
    bytes_coloca_byte(codigo, 15)
    bytes_coloca_byte(codigo, 5)
    devolve nulo
  fecha

  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 201)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 234)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 184)
  nativo_u32_le(codigo, 12288)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 185)
  nativo_u32_le(codigo, 4)

  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 84)
  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 139)
  bytes_coloca_byte(codigo, 228)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 228)
  bytes_coloca_byte(codigo, 240)
  bytes_coloca_byte(codigo, 72)
  bytes_coloca_byte(codigo, 131)
  bytes_coloca_byte(codigo, 236)
  bytes_coloca_byte(codigo, 32)

  bytes_coloca_byte(codigo, 255)
  bytes_coloca_byte(codigo, 21)
  guarda pos := codigo.tamanho
  nativo_u32_le(codigo, 0)
  lista_coloca(virtual_alloc_patches, pos)

  bytes_coloca_byte(codigo, 76)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 228)
  bytes_coloca_byte(codigo, 65)
  bytes_coloca_byte(codigo, 92)
fecha

