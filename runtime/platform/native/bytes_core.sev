const TipoBytesCore: U64 := 4
const CapacidadeBytesCore: U64 := 64

campo x64_bytes_core_novo(
  codigo: Bytes,
  virtual_alloc_patches: Lista<U64>,
  alvo: AlvoNativo
) -> Nada ::
  x64_runtime_aloca(codigo, virtual_alloc_patches, alvo, 32)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 196)

  x64_runtime_aloca(codigo, virtual_alloc_patches, alvo, CapacidadeBytesCore)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 197)

  x64_bytes_core_mov_rax(codigo, TipoBytesCore)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 4)
  bytes_coloca_byte(codigo, 36)

  bytes_coloca_byte(codigo, 49)
  bytes_coloca_byte(codigo, 192)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 8)

  x64_bytes_core_mov_rax(codigo, CapacidadeBytesCore)
  bytes_coloca_byte(codigo, 73)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 68)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 16)

  bytes_coloca_byte(codigo, 77)
  bytes_coloca_byte(codigo, 137)
  bytes_coloca_byte(codigo, 108)
  bytes_coloca_byte(codigo, 36)
  bytes_coloca_byte(codigo, 24)

  x64_bytes_core_push_objeto(codigo)
fecha

