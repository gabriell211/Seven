campo x64_syscall_fs_bytes_emite(
  codigo: Bytes,
  imports_windows: Lista<PatchImportWindowsX64>,
  alvo: AlvoNativo,
  nome: Texto,
  aridade: U32
) -> Bit ::
  veja nome == "sys_arquivo_grava_bytes" e aridade == 2 ::
    veja alvo.formato == "elf" ::
      x64_fs_linux_grava_bytes(codigo)
    outro ::
      x64_fs_windows_grava_bytes(codigo, imports_windows)
    fecha
    devolve sim
  fecha
  devolve nao
fecha

