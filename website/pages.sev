modulo website.pages

campo inicio() -> Num toca terminal ::
  diga "<!doctype html>"
  diga "<html lang='pt-BR'>"
  diga "<head>"
  diga "<meta charset='utf-8'>"
  diga "<meta name='viewport' content='width=device-width,initial-scale=1'>"
  diga "<meta name='description' content='Seven e uma linguagem de programacao de sistemas e aplicacoes criada por Gabriel Barcelos.'>"
  diga "<meta name='theme-color' content='#07090d'>"
  diga "<title>Seven — linguagem de sistemas e aplicacoes</title>"
  diga "<style>"
  diga ":root{color-scheme:dark;--bg:#07090d;--panel:#0d1118;--panel2:#111722;--line:#202a38;--text:#f3f6fb;--muted:#9ba8b8;--accent:#7ee787;--blue:#58a6ff;--mono:ui-monospace,SFMono-Regular,Consolas,monospace;--sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif}"
  diga "*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.6}body:before{content:'';position:fixed;inset:0;z-index:-1;background:radial-gradient(circle at 76% 4%,rgba(88,166,255,.12),transparent 30rem),radial-gradient(circle at 16% 32%,rgba(126,231,135,.07),transparent 28rem)}a{color:inherit}.shell{width:min(1180px,calc(100% - 40px));margin:auto}.topbar{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.08)}"
  diga ".brand{display:flex;align-items:center;gap:12px;text-decoration:none}.brand img{width:31px;height:31px}.brand b{font-size:13px;letter-spacing:.23em}.nav{display:flex;gap:28px;align-items:center}.nav a{color:var(--muted);text-decoration:none;font-size:14px}.nav a:hover{color:var(--text)}.hero{min-height:650px;display:grid;grid-template-columns:1.05fr .95fr;gap:72px;align-items:center;padding:80px 0 72px}.eyebrow,.kicker{font:12px var(--mono);text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}.eyebrow{display:flex;align-items:center;gap:9px}.eyebrow i{width:7px;height:7px;background:var(--accent);border-radius:50%;box-shadow:0 0 18px var(--accent)}"
  diga "h1{font-size:clamp(44px,6vw,74px);line-height:1.03;letter-spacing:-.055em;margin:22px 0 26px;font-weight:650}h1 strong{color:var(--accent);font-weight:650}.lead{font-size:19px;color:#b6c1cf;max-width:650px}.actions{display:flex;gap:12px;margin-top:34px}.button{display:inline-flex;gap:8px;align-items:center;border:1px solid var(--line);border-radius:8px;padding:12px 18px;text-decoration:none;font-weight:700}.primary{background:var(--accent);color:#061008;border-color:var(--accent)}.secondary{background:#0d131c}.meta{display:flex;gap:12px;align-items:center;margin-top:31px;color:#718096;font:11px var(--mono)}.meta i{width:3px;height:3px;border-radius:50%;background:#485467}"
  diga ".terminal{border:1px solid #263245;background:#090d13;border-radius:13px;overflow:hidden;box-shadow:0 25px 80px rgba(0,0,0,.38)}.terminal-bar{height:44px;background:#101620;border-bottom:1px solid #222c3b;display:flex;align-items:center;gap:7px;padding:0 14px}.terminal-bar i{width:9px;height:9px;border-radius:50%;background:#38465a}.terminal-bar b{font:500 11px var(--mono);color:#75869b;margin-left:7px}.terminal pre,.source pre{margin:0;padding:28px;overflow:auto;color:#d5deea;font:13px/1.8 var(--mono)}code .kw,.kw{color:var(--blue)}.output{border-top:1px solid #202a38;padding:17px 28px;color:#8492a5;font:12px/1.8 var(--mono)}.output span{color:var(--accent)}"
  diga ".stats{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr)}.stats article{padding:30px 28px;border-right:1px solid var(--line)}.stats article:last-child{border:0}.stats strong{display:block;font:700 24px var(--mono);color:var(--accent)}.stats span{display:block;font-weight:700;font-size:14px}.stats small{display:block;color:#758397;font-size:11px}.section{padding:105px 0;border-bottom:1px solid var(--line)}.heading{max-width:780px;margin-bottom:52px}.kicker{color:#6f8198;margin:0 0 13px}.section h2,.cta h2{font-size:clamp(32px,4vw,49px);line-height:1.08;letter-spacing:-.035em;margin:0 0 20px}.heading>p:last-child,.bootstrap p,.cta p{color:var(--muted);font-size:17px}"
  diga ".grid{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid var(--line);border-radius:12px;overflow:hidden}.feature{min-height:210px;padding:30px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.018),transparent)}.feature:nth-child(2n){border-right:0}.feature:nth-child(n+3){border-bottom:0}.feature em{font:12px var(--mono);color:var(--accent);font-style:normal}.feature h3{font-size:20px;margin:34px 0 8px}.feature p{color:var(--muted);margin:0}.pipeline{display:flex;align-items:stretch;overflow:auto;border:1px solid var(--line);border-radius:10px;background:#0b1017;padding:14px}.pipe{min-width:122px;padding:18px;background:#101721;border:1px solid #253044;border-radius:7px}.pipe b,.pipe span{display:block}.pipe b{font:700 13px var(--mono)}.pipe span{font-size:11px;color:#758397}.arrow{display:grid;place-items:center;padding:0 10px;color:#50617a}.targets{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}.target{padding:25px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}.target b{color:var(--accent);font:700 14px var(--mono)}.target h3{margin:8px 0}.target p{color:var(--muted);font-size:13px;margin:0}"
  diga ".bootstrap{display:grid;grid-template-columns:1fr 430px;gap:80px;align-items:center}.flow{padding:26px;border:1px solid var(--line);background:var(--panel);border-radius:12px}.flow div{display:flex;align-items:center;gap:14px;padding:15px;border:1px solid #273246;background:#0b1017;border-radius:7px}.flow span{font:11px var(--mono);color:#65748a}.flow i{display:block;height:19px;text-align:center;color:#53647b;font-style:normal}.flow .active{border-color:#3f8150;box-shadow:inset 3px 0 var(--accent)}.source{border:1px solid var(--line);background:#090d13;border-radius:12px;overflow:hidden}.source-top{height:47px;padding:0 16px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);background:#101620;font:11px var(--mono);color:#7f8da0}.source-top a{color:var(--accent);text-decoration:none}.notice{margin-top:24px;padding:17px 20px;border-left:3px solid #d29922;background:#15120b;color:#c9b98f;font-size:13px}.cta{margin:104px 0 50px;padding:50px;border:1px solid #2f6940;border-radius:14px;background:linear-gradient(125deg,rgba(126,231,135,.08),rgba(88,166,255,.04));display:flex;align-items:flex-end;justify-content:space-between;gap:50px}.cta>div{max-width:720px}footer{min-height:120px;display:grid;grid-template-columns:1fr auto auto;gap:35px;align-items:center;color:#68778b;font-size:12px}"
  diga "@media(max-width:900px){.nav a:not(.docs){display:none}.hero{grid-template-columns:1fr;min-height:auto}.stats{grid-template-columns:repeat(2,1fr)}.stats article:nth-child(2){border-right:0}.targets{grid-template-columns:1fr}.bootstrap{grid-template-columns:1fr}.flow{max-width:520px}.cta{align-items:flex-start;flex-direction:column}footer{grid-template-columns:1fr;padding:35px 0;gap:8px}}@media(max-width:560px){.shell{width:min(100% - 28px,1180px)}.topbar{height:70px}.hero{padding-top:50px}.lead{font-size:16px}.actions{flex-direction:column}.stats{grid-template-columns:1fr}.stats article{border-right:0;border-bottom:1px solid var(--line)}.section{padding:75px 0}.grid{grid-template-columns:1fr}.feature{border-right:0;border-bottom:1px solid var(--line)!important}.cta{padding:30px}.terminal pre,.source pre{padding:20px;font-size:11px}}"
  diga "</style>"
  diga "</head>"
  diga "<body>"
  diga "<div class='shell'>"
  diga "<header class='topbar'><a class='brand' href='#top'><img src='./assets/seven-logo.svg' alt='Seven'><b>SEVEN</b></a><nav class='nav'><a href='#linguagem'>Linguagem</a><a href='#toolchain'>Toolchain</a><a href='#bootstrap'>Bootstrap</a><a class='docs' href='https://github.com/gabriell211/Seven/blob/main/docs/language.md'>Docs ↗</a></nav></header>"
  diga "<main id='top'>"
  diga "<section class='hero'><div><div class='eyebrow'><i></i> Seven 0.2 em desenvolvimento</div><h1>Controle de baixo nivel.<br><strong>Sem abrir mao da clareza.</strong></h1><p class='lead'>Seven e uma linguagem de sistemas e aplicacoes criada para unir tipos fortes, memoria explicita, efeitos, WebAssembly e codigo nativo em uma unica toolchain.</p><div class='actions'><a class='button primary' href='https://github.com/gabriell211/Seven'>Ver no GitHub ↗</a><a class='button secondary' href='https://github.com/gabriell211/Seven/releases'>Releases</a></div><div class='meta'><span>.sev</span><i></i><span>SVBC</span><i></i><span>WebAssembly</span><i></i><span>x86-64</span></div></div>"
  diga "<div class='terminal'><div class='terminal-bar'><i></i><i></i><i></i><b>hello.sev</b></div><pre><code><span class='kw'>modulo</span> app\n\n<span class='kw'>campo</span> inicio() -&gt; Num <span class='kw'>toca</span> terminal ::\n  guarda nome: Texto := &quot;Seven&quot;\n  diga &quot;linguagem: &quot; + nome\n  <span class='kw'>devolve</span> 0\n<span class='kw'>fecha</span></code></pre><div class='output'><span>$</span> seven run hello.sev<br>linguagem: Seven</div></div></section>"
  diga "<section class='stats'><article><strong>4</strong><span>alvos principais</span><small>SVBC · WASM · ELF64 · PE32+</small></article><article><strong>x64</strong><span>backend AOT proprio</span><small>codigo de maquina gerado pela Seven</small></article><article><strong>UTF-8</strong><span>texto nativo</span><small>tipos, bytes e memoria controlada</small></article><article><strong>0→1→2</strong><span>bootstrap verificavel</span><small>fixed point do compilador</small></article></section>"
  diga "<section id='linguagem' class='section'><div class='heading'><p class='kicker'>01 / Linguagem</p><h2>Uma sintaxe legivel para trabalho de sistemas.</h2><p>Mutabilidade, efeitos e acesso a memoria aparecem no codigo. O compilador mantem tipos fortes, diagnosticos e limites explicitos.</p></div><div class='grid'><article class='feature'><em>A</em><h3>Tipos fortes</h3><p>Inteiros de largura definida, ponto flutuante, Texto UTF-8, Byte, ponteiros e tipos compostos.</p></article><article class='feature'><em>B</em><h3>Efeitos explicitos</h3><p><code>toca terminal</code>, <code>disco</code>, <code>rede</code> e <code>cru</code> tornam interacoes observaveis.</p></article><article class='feature'><em>C</em><h3>Memoria controlada</h3><p><code>caixa</code>, <code>marca</code> e <code>pega</code> oferecem acesso a bytes com limites conhecidos.</p></article><article class='feature'><em>D</em><h3>Falhas como dados</h3><p>Resultados e selos representam falhas recuperaveis sem esconder o fluxo da aplicacao.</p></article></div></section>"
  diga "<section id='toolchain' class='section'><div class='heading'><p class='kicker'>02 / Toolchain</p><h2>Do arquivo .sev ao binario final.</h2></div><div class='pipeline'><div class='pipe'><b style='color:var(--accent)'>.sev</b><span>fonte</span></div><div class='arrow'>→</div><div class='pipe'><b>lexer</b><span>tokens</span></div><div class='arrow'>→</div><div class='pipe'><b>parser</b><span>AST</span></div><div class='arrow'>→</div><div class='pipe'><b>mede</b><span>tipos · efeitos</span></div><div class='arrow'>→</div><div class='pipe'><b>IR</b><span>otimizacao</span></div><div class='arrow'>→</div><div class='pipe'><b style='color:var(--blue)'>emit</b><span>SVBC · WASM · native</span></div></div><div class='targets'><article class='target'><b>WASM</b><h3>WebAssembly</h3><p>Backend direto da Seven. O runtime interativo 0.2 esta sendo endurecido pelo gate E2E da issue #30.</p></article><article class='target'><b>ELF64</b><h3>Linux x64</h3><p>Backend AOT e escritor ELF64 fazem parte da plataforma nativa.</p></article><article class='target'><b>PE32+</b><h3>Windows x64</h3><p>Geracao PE32+ com imports de sistema e ABI de plataforma.</p></article></div><div class='notice'>Estado transparente: o alvo WebAssembly gera modulos validos, mas a regressao de chamadas <code>frontend_*</code> do compilador de transicao esta rastreada na issue #30. Este site e publicado por um gerador estatico escrito em Seven ate esse gate voltar a ficar verde.</div></section>"
  diga "<section id='bootstrap' class='section bootstrap'><div><p class='kicker'>03 / Bootstrap</p><h2>Self-hosting provado por execucao, nao por bandeira.</h2><p>A cadeia atual alcanca fixed point byte a byte. O cutover operacional continua ate CI, CLI, conformance, AOT, WebAssembly e readiness dispensarem o compilador de transicao no caminho ativo.</p></div><div class='flow'><div><span>00</span><b>Bootstrap auditado</b></div><i>↓</i><div><span>01</span><b>Seven-0</b></div><i>↓</i><div><span>02</span><b>Stage 1</b></div><i>↓</i><div class='active'><span>03</span><b>Stage 2 fixed point</b></div></div></section>"
  diga "<section class='section'><div class='heading'><p class='kicker'>04 / Este site</p><h2>O documento que voce esta vendo e gerado por Seven.</h2><p>O fonte canonico esta em <code>website/pages.sev</code>. O GitHub Actions executa a Seven, captura o HTML produzido e publica o artefato no Pages.</p></div><div class='source'><div class='source-top'><span>website/pages.sev</span><a href='https://github.com/gabriell211/Seven/blob/main/website/pages.sev'>ver fonte ↗</a></div><pre><code><span class='kw'>modulo</span> website.pages\n\n<span class='kw'>campo</span> inicio() -&gt; Num <span class='kw'>toca</span> terminal ::\n  diga &quot;&lt;!doctype html&gt;&quot;\n  diga &quot;&lt;html lang='pt-BR'&gt;...&quot;\n  <span class='kw'>devolve</span> 0\n<span class='kw'>fecha</span></code></pre></div></section>"
  diga "<section class='cta'><div><p class='kicker'>Seven / .sev</p><h2>Uma linguagem construindo a propria pilha.</h2><p>Compilador, runtime, biblioteca padrao e toolchain evoluem juntos, com provas executaveis para cada camada critica.</p></div><a class='button primary' href='https://github.com/gabriell211/Seven'>Explorar o projeto ↗</a></section>"
  diga "</main>"
  diga "<footer><a class='brand' href='#top'><img src='./assets/seven-logo.svg' alt=''><b>SEVEN</b></a><span>Criada por Gabriel Barcelos · gabriell211</span><span>Site gerado por Seven.</span></footer>"
  diga "</div>"
  diga "</body>"
  diga "</html>"
  devolve 0
fecha
