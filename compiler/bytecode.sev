modulo seven.compiler.bytecode

usa seven.compiler.ir
usa std.base.lista
usa std.mem.bytes

const SvbcMagic: Texto := "SVBC"
const SvbcVersao: U32 := 1

selo Opcode ::
  Pare
  Const
  Carrega
  Guarda
  Soma
  Sub
  Mul
  Div
  Igual
  Diferente
  Menor
  MenorIgual
  Maior
  MaiorIgual
  Salta
  SaltaSeNao
  Chama
  Volta
  Caixa
  MarcaByte
  PegaByte
  Efeito
  Syscall
fecha

campo emite_svbc(unidade: UnidadeIr) -> Bytes ::
  prepara_nomes(unidade)
  solta bytes := bytes_novo()

  bytes_coloca_texto(bytes, SvbcMagic)
  bytes_coloca_u32(bytes, SvbcVersao)
  emite_nomes(bytes, unidade)
  emite_tabela_constantes(bytes, unidade)
  emite_campos(bytes, unidade)
  emite_codigo(bytes, unidade)

  devolve bytes
fecha

campo prepara_nomes(unidade: UnidadeIr) -> Nada ::
  para cada campo em unidade.campos ::
    adiciona_nome_unico(unidade.nomes, campo.nome)
    para cada efeito em campo.efeitos ::
      adiciona_nome_unico(unidade.nomes, efeito)
    fecha
  fecha

  para cada campo em unidade.campos ::
    para cada bloco em campo.blocos ::
      para cada instrucao em bloco.instrucoes ::
        veja instrucao e IrSyscall ::
          adiciona_nome_unico(unidade.nomes, instrucao.nome)
        fecha
      fecha
    fecha
  fecha
fecha

campo adiciona_nome_unico(nomes: Lista<Texto>, nome: Texto) -> Nada ::
  para cada atual em nomes ::
    veja atual == nome ::
      devolve nulo
    fecha
  fecha
  lista_coloca(nomes, nome)
fecha

campo emite_nomes(bytes: Bytes, unidade: UnidadeIr) -> Nada ::
  bytes_coloca_u32(bytes, U32(lista_tamanho(unidade.nomes)))
  para cada nome em unidade.nomes ::
    bytes_coloca_texto_com_tamanho(bytes, nome)
  fecha
fecha

campo emite_tabela_constantes(bytes: Bytes, unidade: UnidadeIr) -> Nada ::
  bytes_coloca_u32(bytes, U32(lista_tamanho(unidade.constantes)))
  para cada constante em unidade.constantes ::
    emite_constante(bytes, constante.valor)
  fecha
fecha

campo emite_constante(bytes: Bytes, valor: ValorIr) -> Nada ::
  veja valor e ValorNulo ::
    bytes_coloca_byte(bytes, 0)
    devolve nulo
  fecha

  veja valor e ValorBit ::
    bytes_coloca_byte(bytes, 2)
    veja valor.valor ::
      bytes_coloca_byte(bytes, 1)
    outro ::
      bytes_coloca_byte(bytes, 0)
    fecha
    devolve nulo
  fecha

  veja valor e ValorNum ::
    bytes_coloca_byte(bytes, 3)
    bytes_coloca_u64(bytes, U64(valor.valor))
    devolve nulo
  fecha

  veja valor e ValorTexto ::
    bytes_coloca_byte(bytes, 4)
    bytes_coloca_texto_com_tamanho(bytes, valor.valor)
  fecha
fecha

campo emite_campos(bytes: Bytes, unidade: UnidadeIr) -> Nada ::
  bytes_coloca_u32(bytes, U32(lista_tamanho(unidade.campos)))
  solta entrada: U64 := 0

  para cada campo em unidade.campos ::
    bytes_coloca_u32(bytes, indice_nome(unidade.nomes, campo.nome))
    bytes_coloca_u64(bytes, entrada)
    bytes_coloca_u32(bytes, U32(lista_tamanho(campo.locais)))
    bytes_coloca_u32(bytes, campo.parametros)
    bytes_coloca_u32(bytes, U32(lista_tamanho(campo.efeitos)))

    para cada efeito em campo.efeitos ::
      bytes_coloca_u32(bytes, indice_nome(unidade.nomes, efeito))
    fecha

    vira entrada := entrada + conta_instrucoes(campo)
  fecha
fecha

campo emite_codigo(bytes: Bytes, unidade: UnidadeIr) -> Nada ::
  solta total: U64 := 0
  para cada campo em unidade.campos ::
    vira total := total + conta_instrucoes(campo)
  fecha

  veja total == 0 ::
    bytes_coloca_u32(bytes, 1)
    emite_instrucao_svbc(bytes, Pare, 0, 0, 0, 0)
    devolve nulo
  fecha

  bytes_coloca_u32(bytes, U32(total))
  solta ip: U64 := 0

  para cada campo em unidade.campos ::
    para cada bloco em campo.blocos ::
      para cada instrucao em bloco.instrucoes ::
        emite_ir(bytes, unidade, campo, instrucao, ip)
        vira ip := ip + conta_instrucao_ir(instrucao)
      fecha
    fecha
  fecha
fecha

campo conta_instrucoes(campo: CampoIr) -> U64 ::
  solta total: U64 := 0
  para cada bloco em campo.blocos ::
    para cada instrucao em bloco.instrucoes ::
      vira total := total + conta_instrucao_ir(instrucao)
    fecha
  fecha
  devolve total
fecha

campo conta_instrucoes_bloco(bloco: BlocoIr) -> U64 ::
  solta total: U64 := 0
  para cada instrucao em bloco.instrucoes ::
    vira total := total + conta_instrucao_ir(instrucao)
  fecha
  devolve total
fecha

campo conta_instrucao_ir(instrucao: InstrucaoIr) -> U64 ::
  veja instrucao e IrConst ::
    devolve 2
  fecha
  veja instrucao e IrMove ::
    devolve 2
  fecha
  veja instrucao e IrBin ::
    devolve 4
  fecha
  veja instrucao e IrChama ::
    devolve lista_tamanho(instrucao.argumentos) + 2
  fecha
  veja instrucao e IrSyscall ::
    devolve lista_tamanho(instrucao.argumentos) + 2
  fecha
  veja instrucao e IrSaltaSeNao ::
    devolve 2
  fecha
  veja instrucao e IrRetorna ::
    devolve 2
  fecha
  veja instrucao e IrCaixa ::
    devolve 3
  fecha
  veja instrucao e IrMarcaByte ::
    devolve 4
  fecha
  veja instrucao e IrPegaByte ::
    devolve 4
  fecha
  devolve 1
fecha

campo emite_ir(
  bytes: Bytes,
  unidade: UnidadeIr,
  campo_atual: CampoIr,
  instrucao: InstrucaoIr,
  ip: U64
) -> Nada ::
  veja instrucao e IrConst ::
    emite_instrucao_svbc(bytes, Const, indice_constante(unidade.constantes, instrucao.valor), 0, 0, ip)
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + 1)
    devolve nulo
  fecha

  veja instrucao e IrMove ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.origem, 0, 0, ip)
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + 1)
    devolve nulo
  fecha

  veja instrucao e IrBin ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.esquerda, 0, 0, ip)
    emite_instrucao_svbc(bytes, Carrega, instrucao.direita, 0, 0, ip + 1)
    emite_instrucao_svbc(bytes, opcode_binario(instrucao.operador), 0, 0, 0, ip + 2)
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + 3)
    devolve nulo
  fecha

  veja instrucao e IrChama ::
    guarda deslocamento_chamada := emite_argumentos(bytes, instrucao.argumentos, ip)
    emite_instrucao_svbc(
      bytes,
      Chama,
      indice_campo(unidade.campos, instrucao.campo),
      U32(lista_tamanho(instrucao.argumentos)),
      0,
      ip + deslocamento_chamada
    )
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + deslocamento_chamada + 1)
    devolve nulo
  fecha

  veja instrucao e IrSyscall ::
    guarda deslocamento_syscall := emite_argumentos(bytes, instrucao.argumentos, ip)
    emite_instrucao_svbc(
      bytes,
      Syscall,
      indice_nome(unidade.nomes, instrucao.nome),
      U32(lista_tamanho(instrucao.argumentos)),
      0,
      ip + deslocamento_syscall
    )
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + deslocamento_syscall + 1)
    devolve nulo
  fecha

  veja instrucao e IrSalta ::
    emite_instrucao_svbc(bytes, Salta, ip_do_bloco(unidade, campo_atual.nome, instrucao.bloco), 0, 0, ip)
    devolve nulo
  fecha

  veja instrucao e IrSaltaSeNao ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.condicao, 0, 0, ip)
    emite_instrucao_svbc(bytes, SaltaSeNao, ip_do_bloco(unidade, campo_atual.nome, instrucao.bloco), 0, 0, ip + 1)
    devolve nulo
  fecha

  veja instrucao e IrRetorna ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.origem, 0, 0, ip)
    emite_instrucao_svbc(bytes, Volta, 0, 0, 0, ip + 1)
    devolve nulo
  fecha

  veja instrucao e IrCaixa ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.tamanho, 0, 0, ip)
    emite_instrucao_svbc(bytes, Caixa, 0, 0, 0, ip + 1)
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + 2)
    devolve nulo
  fecha

  veja instrucao e IrMarcaByte ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.bloco, 0, 0, ip)
    emite_instrucao_svbc(bytes, Carrega, instrucao.indice, 0, 0, ip + 1)
    emite_instrucao_svbc(bytes, Carrega, instrucao.valor, 0, 0, ip + 2)
    emite_instrucao_svbc(bytes, MarcaByte, 0, 0, 0, ip + 3)
    devolve nulo
  fecha

  veja instrucao e IrPegaByte ::
    emite_instrucao_svbc(bytes, Carrega, instrucao.bloco, 0, 0, ip)
    emite_instrucao_svbc(bytes, Carrega, instrucao.indice, 0, 0, ip + 1)
    emite_instrucao_svbc(bytes, PegaByte, 0, 0, 0, ip + 2)
    emite_instrucao_svbc(bytes, Guarda, instrucao.destino, 0, 0, ip + 3)
    devolve nulo
  fecha

  emite_instrucao_svbc(bytes, Pare, 0, 0, 0, ip)
fecha

campo emite_argumentos(bytes: Bytes, argumentos: Lista<U32>, ip: U64) -> U64 ::
  solta deslocamento: U64 := 0
  para cada argumento em argumentos ::
    emite_instrucao_svbc(bytes, Carrega, argumento, 0, 0, ip + deslocamento)
    vira deslocamento := deslocamento + 1
  fecha
  devolve deslocamento
fecha

campo ip_do_bloco(unidade: UnidadeIr, campo_nome: Texto, bloco_nome: Texto) -> U32 ::
  solta base: U64 := 0

  para cada campo em unidade.campos ::
    veja campo.nome == campo_nome ::
      solta deslocamento: U64 := 0
      para cada bloco em campo.blocos ::
        veja bloco.nome == bloco_nome ::
          devolve U32(base + deslocamento)
        fecha
        vira deslocamento := deslocamento + conta_instrucoes_bloco(bloco)
      fecha
      devolve U32(base)
    fecha
    vira base := base + conta_instrucoes(campo)
  fecha

  devolve 0
fecha

campo indice_nome(nomes: Lista<Texto>, nome: Texto) -> U32 ::
  solta indice: U32 := 0
  para cada atual em nomes ::
    veja atual == nome ::
      devolve indice
    fecha
    vira indice := indice + 1
  fecha
  devolve 0
fecha

campo indice_campo(campos: Lista<CampoIr>, nome: Texto) -> U32 ::
  solta indice: U32 := 0
  para cada campo em campos ::
    veja campo.nome == nome ::
      devolve indice
    fecha
    vira indice := indice + 1
  fecha
  devolve 0
fecha

campo indice_constante(constantes: Lista<ConstanteIr>, valor: ValorIr) -> U32 ::
  solta indice: U32 := 0
  para cada constante em constantes ::
    veja valor_ir_igual(constante.valor, valor) ::
      devolve indice
    fecha
    vira indice := indice + 1
  fecha
  devolve 0
fecha

campo opcode_binario(operador: Texto) -> Opcode ::
  veja operador == "+" :: devolve Soma fecha
  veja operador == "-" :: devolve Sub fecha
  veja operador == "*" :: devolve Mul fecha
  veja operador == "/" :: devolve Div fecha
  veja operador == "==" :: devolve Igual fecha
  veja operador == "!=" :: devolve Diferente fecha
  veja operador == "<" :: devolve Menor fecha
  veja operador == "<=" :: devolve MenorIgual fecha
  veja operador == ">" :: devolve Maior fecha
  veja operador == ">=" :: devolve MaiorIgual fecha
  guarda padrao: Opcode := Pare
  devolve padrao
fecha

campo opcode_byte(opcode: Opcode) -> Byte ::
  veja opcode e Pare :: devolve 0 fecha
  veja opcode e Const :: devolve 1 fecha
  veja opcode e Carrega :: devolve 2 fecha
  veja opcode e Guarda :: devolve 3 fecha
  veja opcode e Soma :: devolve 4 fecha
  veja opcode e Sub :: devolve 5 fecha
  veja opcode e Mul :: devolve 6 fecha
  veja opcode e Div :: devolve 7 fecha
  veja opcode e Igual :: devolve 8 fecha
  veja opcode e Diferente :: devolve 9 fecha
  veja opcode e Menor :: devolve 10 fecha
  veja opcode e MenorIgual :: devolve 11 fecha
  veja opcode e Maior :: devolve 12 fecha
  veja opcode e MaiorIgual :: devolve 13 fecha
  veja opcode e Salta :: devolve 14 fecha
  veja opcode e SaltaSeNao :: devolve 15 fecha
  veja opcode e Chama :: devolve 16 fecha
  veja opcode e Volta :: devolve 17 fecha
  veja opcode e Caixa :: devolve 18 fecha
  veja opcode e MarcaByte :: devolve 19 fecha
  veja opcode e PegaByte :: devolve 20 fecha
  veja opcode e Efeito :: devolve 21 fecha
  veja opcode e Syscall :: devolve 22 fecha
  devolve 0
fecha

campo emite_instrucao_svbc(bytes: Bytes, opcode: Opcode, a: U32, b: U32, c: U32, ip: U64) -> Nada ::
  bytes_coloca_byte(bytes, opcode_byte(opcode))
  bytes_coloca_u32(bytes, a)
  bytes_coloca_u32(bytes, b)
  bytes_coloca_u32(bytes, c)
  bytes_coloca_u64(bytes, ip)
fecha