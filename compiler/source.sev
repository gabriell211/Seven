modulo seven.compiler.source

usa seven.compiler.diagnostic
usa seven.compiler.package
usa std.base.texto

molde Span ::
  arquivo: Texto
  inicio: U64
  fim: U64
  linha: U32
  coluna: U32
fecha

molde Fonte ::
  caminho: Texto
  texto: Texto
  linhas: Lista<U64>
fecha

molde UnidadeFonte ::
  arquivos: Lista<Fonte>
fecha

campo fonte_de_texto(caminho: Texto, conteudo: Texto) -> Fonte ::
  devolve Fonte {
    caminho: caminho,
    texto: conteudo,
    linhas: mapa_linhas(conteudo)
  }
fecha

campo fonte_carrega_obrigatoria(caminho: Texto) -> Fonte toca disco ::
  devolve fonte_de_texto(caminho, arquivo_ler(caminho))
fecha

campo fonte_carrega(caminho: Texto) -> Resultado<Fonte, Diagnostico> toca disco ::
  devolve Valor(fonte_carrega_obrigatoria(caminho))
fecha

campo fonte_resolve_dependencias_pacote(pacote: Pacote) -> Pacote toca disco ::
  solta sementes := lista<Texto>()
  guarda quantidade_inicial := lista_tamanho(pacote.fontes)
  solta indice: U64 := 0

  gira indice < quantidade_inicial ::
    lista_coloca(sementes, lista_pega(pacote.fontes, indice))
    vira indice := indice + 1
  fecha

  solta visitados := lista<Texto>()
  fonte_visita_dependencia(pacote, "std/base/prelude.sev", visitados)

  para cada caminho em sementes ::
    fonte_visita_dependencia(pacote, caminho, visitados)
  fecha

  devolve pacote
fecha

campo fonte_visita_dependencia(pacote: Pacote, caminho: Texto, visitados: Lista<Texto>) -> Nada toca disco ::
  veja fonte_lista_contem(visitados, caminho) ::
    devolve nulo
  fecha

  lista_coloca(visitados, caminho)

  veja nao sys_arquivo_existe(caminho) ::
    devolve nulo
  fecha

  veja nao fonte_lista_contem(pacote.fontes, caminho) ::
    lista_coloca(pacote.fontes, caminho)
  fecha

  guarda conteudo := arquivo_ler(caminho)
  para cada linha em linhas(conteudo) ::
    guarda limpa := texto_apara_manifesto(linha)
    veja texto_comeca(limpa, "usa ") ::
      guarda partes := palavras_manifesto(limpa)
      veja lista_tamanho(partes) >= 2 ::
        guarda dependencia := fonte_caminho_modulo(lista_pega(partes, 1))
        veja dependencia != "" ::
          fonte_visita_dependencia(pacote, dependencia, visitados)
        fecha
      fecha
    fecha
  fecha
fecha

campo fonte_caminho_modulo(modulo: Texto) -> Texto ::
  solta relativo := modulo
  veja texto_comeca(relativo, "seven.") ::
    vira relativo := fonte_remove_prefixo(relativo, "seven.")
  fecha

  solta caminho := ""
  solta indice: U64 := 0
  gira indice < sys_texto_tamanho(relativo) ::
    guarda caractere := sys_texto_caractere(relativo, indice)
    veja caractere == "." ::
      vira caminho := caminho + "/"
    outro ::
      vira caminho := caminho + caractere
    fecha
    vira indice := indice + 1
  fecha

  veja caminho == "" ::
    devolve ""
  fecha

  devolve caminho + ".sev"
fecha

campo fonte_remove_prefixo(valor: Texto, prefixo: Texto) -> Texto ::
  veja nao texto_comeca(valor, prefixo) ::
    devolve valor
  fecha

  solta saida := ""
  solta indice := sys_texto_tamanho(prefixo)
  gira indice < sys_texto_tamanho(valor) ::
    vira saida := saida + sys_texto_caractere(valor, indice)
    vira indice := indice + 1
  fecha
  devolve saida
fecha

campo fonte_lista_contem(valores: Lista<Texto>, procurado: Texto) -> Bit ::
  para cada valor em valores ::
    veja valor == procurado ::
      devolve sim
    fecha
  fecha
  devolve nao
fecha

campo fonte_carrega_pacote(pacote: Pacote) -> UnidadeFonte toca disco ::
  veja pacote.indice_fontes != "" ::
    devolve fonte_carrega_indice(pacote.indice_fontes)
  fecha

  solta arquivos := lista<Fonte>()

  para cada caminho em pacote.fontes ::
    veja texto_contem(caminho, ".sev") ::
      lista_coloca(arquivos, fonte_carrega_obrigatoria(caminho))
    fecha
  fecha

  devolve UnidadeFonte { arquivos: arquivos }
fecha

campo fonte_carrega_indice(caminho_indice: Texto) -> UnidadeFonte toca disco ::
  solta arquivos := lista<Fonte>()
  guarda conteudo := arquivo_ler(caminho_indice)

  para cada linha em linhas(conteudo) ::
    guarda caminho := texto_apara_manifesto(linha)
    veja caminho != "" e nao texto_comeca(caminho, "#") ::
      lista_coloca(arquivos, fonte_carrega_obrigatoria(caminho))
    fecha
  fecha

  devolve UnidadeFonte { arquivos: arquivos }
fecha

campo unidade_fonte_de(fonte: Fonte) -> UnidadeFonte ::
  solta arquivos := lista<Fonte>()
  lista_coloca(arquivos, fonte)
  devolve UnidadeFonte { arquivos: arquivos }
fecha

campo mapa_linhas(conteudo: Texto) -> Lista<U64> ::
  solta linhas := lista<U64>()
  lista_coloca(linhas, 0)
  solta indice: U64 := 0
  gira indice < sys_texto_tamanho(conteudo) ::
    veja sys_texto_caractere(conteudo, indice) == "\n" ::
      lista_coloca(linhas, indice + 1)
    fecha
    vira indice := indice + 1
  fecha
  devolve linhas
fecha

campo span_texto(fonte: Fonte, inicio: U64, fim: U64, linha: U32, coluna: U32) -> Span ::
  devolve Span { arquivo: fonte.caminho, inicio: inicio, fim: fim, linha: linha, coluna: coluna }
fecha
