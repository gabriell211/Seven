modulo seven.compiler.source

usa seven.compiler.diagnostic
usa seven.compiler.package
usa std.base.texto

molde Span ::
  arquivo: Texto
  inicio: U64
  fim: U64
  linha: U32
  coluna: U32
fecha

molde Fonte ::
  caminho: Texto
  texto: Texto
  linhas: Lista<U64>
fecha

molde UnidadeFonte ::
  arquivos: Lista<Fonte>
fecha

campo fonte_de_texto(caminho: Texto, conteudo: Texto) -> Fonte ::
  devolve Fonte {
    caminho: caminho,
    texto: conteudo,
    linhas: mapa_linhas(conteudo)
  }
fecha

campo fonte_carrega_obrigatoria(caminho: Texto) -> Fonte toca disco ::
  devolve fonte_de_texto(caminho, arquivo_ler(caminho))
fecha

campo fonte_carrega(caminho: Texto) -> Resultado<Fonte, Diagnostico> toca disco ::
  devolve Valor(fonte_carrega_obrigatoria(caminho))
fecha

campo fonte_carrega_pacote(pacote: Pacote) -> UnidadeFonte toca disco ::
  veja pacote.indice_fontes != "" ::
    devolve fonte_carrega_indice(pacote.indice_fontes)
  fecha

  solta arquivos := lista<Fonte>()
  solta visitados := lista<Texto>()

  para cada caminho em pacote.fontes ::
    veja texto_contem(caminho, ".sev") ::
      fonte_carrega_recursiva(caminho, arquivos, visitados)
    fecha
  fecha

  devolve UnidadeFonte { arquivos: arquivos }
fecha

campo fonte_carrega_recursiva(
  caminho: Texto,
  arquivos: Lista<Fonte>,
  visitados: Lista<Texto>
) -> Nada toca disco ::
  veja fonte_caminho_visitado(visitados, caminho) ::
    devolve nulo
  fecha

  lista_coloca(visitados, caminho)

  veja nao sys_arquivo_existe(caminho) ::
    devolve nulo
  fecha

  guarda fonte := fonte_carrega_obrigatoria(caminho)
  lista_coloca(arquivos, fonte)

  para cada linha em linhas(fonte.texto) ::
    guarda modulo := fonte_uso_modulo(linha)
    veja modulo != "" ::
      fonte_carrega_modulo(modulo, arquivos, visitados)
    fecha
  fecha
fecha

campo fonte_carrega_modulo(
  modulo: Texto,
  arquivos: Lista<Fonte>,
  visitados: Lista<Texto>
) -> Nada toca disco ::
  veja modulo == "seven.compiler.parser" ::
    fonte_carrega_recursiva("compiler/parser_part00.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/parser_part01.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/parser_part02.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/parser_part03.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/parser_part04.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/parser_part05.sev", arquivos, visitados)
    devolve nulo
  fecha

  veja modulo == "seven.compiler.types" ::
    fonte_carrega_recursiva("compiler/types_part00.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/types_part01.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/types_part02.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler/types_part03.sev", arquivos, visitados)
    devolve nulo
  fecha

  veja modulo == "seven0.emit" ::
    fonte_carrega_recursiva("compiler0/emit_part00.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler0/emit_part01.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler0/emit_part02.sev", arquivos, visitados)
    fonte_carrega_recursiva("compiler0/emit_part03.sev", arquivos, visitados)
    devolve nulo
  fecha

  guarda caminho := fonte_modulo_caminho(modulo)
  veja caminho != "" ::
    fonte_carrega_recursiva(caminho, arquivos, visitados)
  fecha
fecha

campo fonte_modulo_caminho(modulo: Texto) -> Texto toca disco ::
  solta base := modulo

  veja modulo == "seven0" ::
    vira base := "compiler0/seven0"
  outro ::
    veja texto_comeca(modulo, "seven0.") ::
      vira base := "compiler0/" + fonte_modulo_para_path(
        sys_texto_fatia(modulo, 7, sys_texto_tamanho(modulo))
      )
    outro ::
      veja texto_comeca(modulo, "seven.") ::
        vira base := fonte_modulo_para_path(
          sys_texto_fatia(modulo, 6, sys_texto_tamanho(modulo))
        )
      outro ::
        vira base := fonte_modulo_para_path(modulo)
      fecha
    fecha
  fecha

  guarda arquivo := base + ".sev"
  veja sys_arquivo_existe(arquivo) ::
    devolve arquivo
  fecha

  guarda entrada := base + "/seven.sev"
  veja sys_arquivo_existe(entrada) ::
    devolve entrada
  fecha

  devolve ""
fecha

campo fonte_modulo_para_path(modulo: Texto) -> Texto ::
  solta saida := ""
  solta indice: U64 := 0

  gira indice < sys_texto_tamanho(modulo) ::
    guarda caractere := sys_texto_caractere(modulo, indice)
    veja caractere == "." ::
      vira saida := saida + "/"
    outro ::
      vira saida := saida + caractere
    fecha
    vira indice := indice + 1
  fecha

  devolve saida
fecha

campo fonte_uso_modulo(linha: Texto) -> Texto ::
  guarda limpa := texto_apara_manifesto(linha)
  veja nao texto_comeca(limpa, "usa ") ::
    devolve ""
  fecha

  solta modulo := ""
  solta indice: U64 := 4

  gira indice < sys_texto_tamanho(limpa) ::
    guarda caractere := sys_texto_caractere(limpa, indice)
    veja caractere == " " ou caractere == "\t" ::
      devolve modulo
    fecha
    vira modulo := modulo + caractere
    vira indice := indice + 1
  fecha

  devolve modulo
fecha

campo fonte_caminho_visitado(visitados: Lista<Texto>, caminho: Texto) -> Bit ::
  para cada item em visitados ::
    veja item == caminho ::
      devolve sim
    fecha
  fecha

  devolve nao
fecha

campo fonte_carrega_indice(caminho_indice: Texto) -> UnidadeFonte toca disco ::
  solta arquivos := lista<Fonte>()
  guarda conteudo := arquivo_ler(caminho_indice)

  para cada linha em linhas(conteudo) ::
    guarda caminho := texto_apara_manifesto(linha)
    veja caminho != "" e nao texto_comeca(caminho, "#") ::
      lista_coloca(arquivos, fonte_carrega_obrigatoria(caminho))
    fecha
  fecha

  devolve UnidadeFonte { arquivos: arquivos }
fecha

campo unidade_fonte_de(fonte: Fonte) -> UnidadeFonte ::
  solta arquivos := lista<Fonte>()
  lista_coloca(arquivos, fonte)
  devolve UnidadeFonte { arquivos: arquivos }
fecha

campo mapa_linhas(conteudo: Texto) -> Lista<U64> ::
  solta linhas := lista<U64>()
  lista_coloca(linhas, 0)
  solta indice: U64 := 0
  gira indice < sys_texto_tamanho(conteudo) ::
    veja sys_texto_caractere(conteudo, indice) == "\n" ::
      lista_coloca(linhas, indice + 1)
    fecha
    vira indice := indice + 1
  fecha
  devolve linhas
fecha

campo span_texto(fonte: Fonte, inicio: U64, fim: U64, linha: U32, coluna: U32) -> Span ::
  devolve Span { arquivo: fonte.caminho, inicio: inicio, fim: fim, linha: linha, coluna: coluna }
fecha
