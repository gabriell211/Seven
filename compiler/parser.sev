modulo seven.compiler.parser

usa seven.compiler.token
usa seven.compiler.ast
usa seven.compiler.source
usa seven.compiler.diagnostic
usa seven.compiler.parser_cursor

molde SaidaSintatica ::
  programas: Lista<Programa>
  diagnosticos: Lista<Diagnostico>
fecha

campo monta_unidade(fluxos: Lista<FluxoTokens>) -> SaidaSintatica ::
  solta programas := lista<Programa>()
  solta bolsa := bolsa_diagnosticos(200)

  para cada fluxo em fluxos ::
    guarda cursor := cursor_tokens(fluxo)
    lista_coloca(programas, monta_com_cursor(cursor))
    diagnosticos_junta(bolsa, cursor.diagnosticos.itens)
  fecha

  devolve SaidaSintatica {
    programas: programas,
    diagnosticos: bolsa.itens
  }
fecha

campo monta(fluxo: FluxoTokens) -> Programa ::
  devolve monta_com_cursor(cursor_tokens(fluxo))
fecha

campo monta_com_cursor(cursor: CursorTokens) -> Programa ::
  guarda modulo_nome := ler_modulo_opcional(cursor)
  guarda usos := ler_usos(cursor)
  solta itens := lista<Item>()

  gira nao fim(cursor) e nao cursor.diagnosticos.interrompida ::
    guarda antes := cursor.posicao
    lista_coloca(itens, ler_item(cursor))

    veja cursor.posicao == antes ::
      reporta_atual(
        cursor,
        "SV-PARSE-PROGRESSO",
        "parser nao conseguiu consumir o item atual",
        "corrija a declaracao proxima deste ponto"
      )
      avanca_token(cursor)
      sincroniza_item(cursor)
    fecha
  fecha

  devolve Programa {
    modulo: modulo_nome,
    usos: usos,
    itens: itens
  }
fecha

campo ler_modulo_opcional(cursor: CursorTokens) -> Texto ::
  veja nao aceita(cursor, "modulo") ::
    devolve ""
  fecha

  devolve ler_caminho(cursor, "depois de modulo")
fecha

campo ler_usos(cursor: CursorTokens) -> Lista<Uso> ::
  solta usos := lista<Uso>()

  gira aceita(cursor, "usa") ::
    guarda inicio := token_anterior(cursor).span
    guarda caminho := ler_caminho(cursor, "depois de usa")
    solta apelido := ""

    veja aceita(cursor, "como") ::
      vira apelido := espera_nome(cursor, "depois de como").marca
    fecha

    lista_coloca(usos, Uso {
      caminho: caminho,
      apelido: apelido,
      span: span_junta(inicio, token_anterior(cursor).span)
    })
  fecha

  devolve usos
fecha

campo ler_item(cursor: CursorTokens) -> Item ::
  veja proximo_e(cursor, "campo") ::
    devolve ItemCampo(ler_campo(cursor))
  fecha

  veja proximo_e(cursor, "extern") ::
    devolve ItemExterno(ler_externo(cursor))
  fecha

  veja proximo_e(cursor, "molde") ::
    devolve ItemMolde(ler_molde(cursor))
  fecha

  veja proximo_e(cursor, "selo") ::
    devolve ItemSelo(ler_selo(cursor))
  fecha

  veja proximo_e(cursor, "const") ::
    devolve ItemConst(ler_constante(cursor))
  fecha

  guarda encontrado := atual_token(cursor)
  reporta_atual(
    cursor,
    "SV-PARSE-ITEM",
    "esperado campo, extern, molde, selo ou const",
    "declaracoes de nivel de modulo devem iniciar por uma palavra de item"
  )
  sincroniza_item(cursor)

  devolve ItemConst(Constante {
    nome: "__item_invalido",
    tipo: tipo_ausente(encontrado.span),
    valor: ExprLiteral(LitNulo),
    span: encontrado.span
  })
fecha

campo ler_campo(cursor: CursorTokens) -> Campo ::
  guarda inicio := espera(cursor, "campo", "SV-PARSE-CAMPO", "esperado campo").span
  guarda nome := espera_nome(cursor, "do campo").marca
  guarda genericos := ler_genericos_declaracao(cursor)
  guarda parametros := ler_parametros(cursor)
  guarda retorno := ler_retorno(cursor)
  guarda efeitos := ler_efeitos(cursor)
  solta contratos := lista<Expressao>()

  gira aceita(cursor, "requer") ::
    lista_coloca(contratos, ler_expressao(cursor))
  fecha

  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: para abrir o corpo do campo")
  guarda corpo := ler_bloco(cursor, nao)
  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar o campo").span

  devolve Campo {
    nome: nome,
    genericos: genericos,
    parametros: parametros,
    retorno: retorno,
    efeitos: efeitos,
    contratos: contratos,
    corpo: corpo,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_externo(cursor: CursorTokens) -> CampoExterno ::
  guarda inicio := espera(cursor, "extern", "SV-PARSE-EXTERN", "esperado extern").span
  guarda abi_nome := espera_nome(cursor, "da ABI externa").marca
  guarda abi := abi_externa(cursor, abi_nome)

  espera(cursor, "campo", "SV-PARSE-EXTERN-CAMPO", "esperado campo depois da ABI externa")
  guarda nome := espera_nome(cursor, "do campo externo").marca
  guarda parametros := ler_parametros(cursor)
  guarda retorno := ler_retorno(cursor)
  solta simbolo := nome

  veja aceita(cursor, "liga") ::
    vira simbolo := espera_texto(cursor, "depois de liga").literal
  fecha

  devolve CampoExterno {
    abi: abi,
    nome: nome,
    simbolo: simbolo,
    parametros: parametros,
    retorno: retorno,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo abi_externa(cursor: CursorTokens, nome: Texto) -> AbiExterna ::
  veja nome == "c" ::
    devolve AbiC
  fecha

  veja nome == "cpp" ::
    devolve AbiCpp
  fecha

  guarda encontrado := token_anterior(cursor)
  diagnosticos_adiciona(cursor.diagnosticos, erro_com_ajuda(
    "SV-PARSE-ABI",
    "ABI externa desconhecida '" + nome + "'",
    encontrado.span.arquivo,
    encontrado.span.linha,
    encontrado.span.coluna,
    "use extern c ou extern cpp"
  ))
  devolve AbiC
fecha

campo ler_molde(cursor: CursorTokens) -> Molde ::
  guarda inicio := espera(cursor, "molde", "SV-PARSE-MOLDE", "esperado molde").span
  guarda nome := espera_nome(cursor, "do molde").marca
  guarda genericos := ler_genericos_declaracao(cursor)
  solta membros := lista<Membro>()

  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: para abrir o molde")

  gira nao fim(cursor) e nao proximo_e(cursor, "fecha") ::
    guarda membro_nome := espera_nome(cursor, "do membro").marca
    guarda membro_inicio := token_anterior(cursor).span
    espera(cursor, ":", "SV-PARSE-MEMBRO-TIPO", "esperado : depois do membro")
    guarda membro_tipo := ler_tipo(cursor)

    lista_coloca(membros, Membro {
      nome: membro_nome,
      tipo: membro_tipo,
      span: span_junta(membro_inicio, token_anterior(cursor).span)
    })
  fecha

  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar o molde").span

  devolve Molde {
    nome: nome,
    genericos: genericos,
    membros: membros,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_selo(cursor: CursorTokens) -> Selo ::
  guarda inicio := espera(cursor, "selo", "SV-PARSE-SELO", "esperado selo").span
  guarda nome := espera_nome(cursor, "do selo").marca
  guarda genericos := ler_genericos_declaracao(cursor)
  solta variantes := lista<Variante>()

  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: para abrir o selo")

  gira nao fim(cursor) e nao proximo_e(cursor, "fecha") ::
    guarda variante_inicio := atual_token(cursor).span
    guarda variante_nome := espera_nome(cursor, "da variante").marca
    solta carga := lista<TipoSintaxe>()

    veja aceita(cursor, "(") ::
      veja nao proximo_e(cursor, ")") ::
        lista_coloca(carga, ler_tipo(cursor))
        gira aceita(cursor, ",") ::
          lista_coloca(carga, ler_tipo(cursor))
        fecha
      fecha
      espera(cursor, ")", "SV-PARSE-VARIANTE", "esperado ) depois da carga da variante")
    fecha

    lista_coloca(variantes, Variante {
      nome: variante_nome,
      carga: carga,
      span: span_junta(variante_inicio, token_anterior(cursor).span)
    })
  fecha

  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar o selo").span

  devolve Selo {
    nome: nome,
    genericos: genericos,
    variantes: variantes,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_constante(cursor: CursorTokens) -> Constante ::
  guarda inicio := espera(cursor, "const", "SV-PARSE-CONST", "esperado const").span
  guarda nome := espera_nome(cursor, "da constante").marca
  espera(cursor, ":", "SV-PARSE-CONST-TIPO", "esperado : depois da constante")
  guarda tipo := ler_tipo(cursor)
  espera(cursor, ":=", "SV-PARSE-CONST-VALOR", "esperado := antes do valor da constante")
  guarda valor := ler_expressao(cursor)

  devolve Constante {
    nome: nome,
    tipo: tipo,
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_genericos_declaracao(cursor: CursorTokens) -> Lista<Texto> ::
  solta nomes := lista<Texto>()

  veja nao aceita(cursor, "<") ::
    devolve nomes
  fecha

  lista_coloca(nomes, espera_nome(cursor, "do parametro generico").marca)
  gira aceita(cursor, ",") ::
    lista_coloca(nomes, espera_nome(cursor, "do parametro generico").marca)
  fecha

  espera(cursor, ">", "SV-PARSE-GENERICO", "esperado > para encerrar parametros genericos")
  devolve nomes
fecha

campo ler_parametros(cursor: CursorTokens) -> Lista<Parametro> ::
  solta parametros := lista<Parametro>()
  espera(cursor, "(", "SV-PARSE-PARAMETROS", "esperado ( antes dos parametros")

  veja nao proximo_e(cursor, ")") ::
    lista_coloca(parametros, ler_parametro(cursor))
    gira aceita(cursor, ",") ::
      lista_coloca(parametros, ler_parametro(cursor))
    fecha
  fecha

  espera(cursor, ")", "SV-PARSE-PARAMETROS", "esperado ) depois dos parametros")
  devolve parametros
fecha

campo ler_parametro(cursor: CursorTokens) -> Parametro ::
  guarda inicio := atual_token(cursor).span
  guarda nome := espera_nome(cursor, "do parametro").marca
  espera(cursor, ":", "SV-PARSE-PARAMETRO-TIPO", "esperado : depois do parametro")
  guarda tipo := ler_tipo(cursor)

  devolve Parametro {
    nome: nome,
    tipo: tipo,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_retorno(cursor: CursorTokens) -> TipoSintaxe ::
  veja aceita(cursor, "->") ::
    devolve ler_tipo(cursor)
  fecha

  devolve TipoSintaxe {
    nome: "Nada",
    argumentos: lista<TipoSintaxe>(),
    matriz: nao,
    span: atual_token(cursor).span
  }
fecha

campo ler_efeitos(cursor: CursorTokens) -> Lista<Texto> ::
  solta efeitos := lista<Texto>()

  veja nao aceita(cursor, "toca") ::
    devolve efeitos
  fecha

  lista_coloca(efeitos, espera_nome(cursor, "do efeito").marca)
  gira aceita(cursor, ",") ::
    lista_coloca(efeitos, espera_nome(cursor, "do efeito").marca)
  fecha

  devolve efeitos
fecha

campo ler_tipo(cursor: CursorTokens) -> TipoSintaxe ::
  guarda inicio := atual_token(cursor).span
  guarda nome := ler_caminho(cursor, "do tipo")
  solta argumentos := lista<TipoSintaxe>()
  solta matriz := nao

  veja aceita(cursor, "<") ::
    lista_coloca(argumentos, ler_tipo(cursor))
    gira aceita(cursor, ",") ::
      lista_coloca(argumentos, ler_tipo(cursor))
    fecha
    espera(cursor, ">", "SV-PARSE-TIPO-GENERICO", "esperado > depois dos argumentos do tipo")
  fecha

  veja aceita(cursor, "[") ::
    veja nao proximo_e(cursor, "]") ::
      ler_expressao(cursor)
    fecha
    espera(cursor, "]", "SV-PARSE-TIPO-MATRIZ", "esperado ] depois do tamanho da matriz")
    vira matriz := sim
  fecha

  devolve TipoSintaxe {
    nome: nome,
    argumentos: argumentos,
    matriz: matriz,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo tipo_ausente(local: Span) -> TipoSintaxe ::
  devolve TipoSintaxe {
    nome: "",
    argumentos: lista<TipoSintaxe>(),
    matriz: nao,
    span: local
  }
fecha

campo ler_caminho(cursor: CursorTokens, contexto: Texto) -> Texto ::
  solta caminho := espera_nome(cursor, contexto).marca

  gira aceita(cursor, ".") ::
    vira caminho := caminho + "." + espera_nome(cursor, "depois de .").marca
  fecha

  devolve caminho
fecha

campo ler_bloco(cursor: CursorTokens, para_senao: Bit) -> Lista<Comando> ::
  solta comandos := lista<Comando>()

  gira nao fim(cursor) e nao proximo_e(cursor, "fecha") e (nao para_senao ou nao proximo_e(cursor, "outro")) ::
    guarda antes := cursor.posicao
    lista_coloca(comandos, ler_comando(cursor))

    veja cursor.posicao == antes ::
      reporta_atual(
        cursor,
        "SV-PARSE-COMANDO",
        "nao foi possivel reconhecer o comando",
        "inicie o comando com uma palavra valida ou use uma chamada"
      )
      avanca_token(cursor)
      sincroniza_comando(cursor)
    fecha
  fecha

  devolve comandos
fecha

campo ler_comando(cursor: CursorTokens) -> Comando ::
  veja proximo_e(cursor, "guarda") ou proximo_e(cursor, "solta") ::
    devolve CmdCria(ler_cria(cursor))
  fecha

  veja proximo_e(cursor, "vira") ::
    devolve CmdVira(ler_vira(cursor))
  fecha

  veja proximo_e(cursor, "diga") ::
    devolve CmdDiga(ler_diga(cursor))
  fecha

  veja proximo_e(cursor, "veja") ::
    devolve CmdVeja(ler_veja(cursor))
  fecha

  veja proximo_e(cursor, "gira") ::
    devolve CmdGira(ler_gira(cursor))
  fecha

  veja proximo_e(cursor, "para") ::
    devolve CmdParaCada(ler_para_cada(cursor))
  fecha

  veja proximo_e(cursor, "devolve") ::
    devolve CmdDevolve(ler_devolve(cursor))
  fecha

  veja proximo_e(cursor, "caixa") ::
    devolve CmdCaixa(ler_caixa(cursor))
  fecha

  veja proximo_e(cursor, "marca") ::
    devolve CmdMarca(ler_marca(cursor))
  fecha

  veja proximo_e(cursor, "pega") ::
    devolve CmdPega(ler_pega(cursor))
  fecha

  veja proximo_e(cursor, "zona") ::
    devolve CmdZona(ler_zona(cursor))
  fecha

  veja proximo_e(cursor, "falha") ::
    devolve CmdFalha(ler_falha(cursor))
  fecha

  guarda inicio := atual_token(cursor).span
  guarda valor := ler_expressao(cursor)
  devolve CmdExpressao(ExpressaoCmd {
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  })
fecha

campo ler_cria(cursor: CursorTokens) -> Cria ::
  guarda inicio_token := avanca_token(cursor)
  guarda mutavel := inicio_token.marca == "solta"
  guarda nome := espera_nome(cursor, "do vinculo").marca
  solta tipo := tipo_ausente(token_anterior(cursor).span)

  veja aceita(cursor, ":") ::
    vira tipo := ler_tipo(cursor)
  fecha

  espera(cursor, ":=", "SV-PARSE-VINCULO", "esperado := antes do valor do vinculo")
  guarda valor := ler_expressao(cursor)

  devolve Cria {
    mutavel: mutavel,
    nome: nome,
    tipo: tipo,
    valor: valor,
    span: span_junta(inicio_token.span, token_anterior(cursor).span)
  }
fecha

campo ler_vira(cursor: CursorTokens) -> Vira ::
  guarda inicio := espera(cursor, "vira", "SV-PARSE-VIRA", "esperado vira").span
  guarda alvo := ler_posfixa(cursor)
  espera(cursor, ":=", "SV-PARSE-VIRA-VALOR", "esperado := na atribuicao")
  guarda valor := ler_expressao(cursor)

  devolve Vira {
    alvo: alvo,
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_diga(cursor: CursorTokens) -> Diga ::
  guarda inicio := espera(cursor, "diga", "SV-PARSE-DIGA", "esperado diga").span
  guarda valor := ler_expressao(cursor)

  devolve Diga {
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_veja(cursor: CursorTokens) -> Veja ::
  guarda inicio := espera(cursor, "veja", "SV-PARSE-VEJA", "esperado veja").span
  guarda condicao := ler_expressao(cursor)
  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: depois da condicao")
  guarda entao := ler_bloco(cursor, sim)
  solta senao := lista<Comando>()

  veja aceita(cursor, "outro") ::
    espera(cursor, "::", "SV-PARSE-OUTRO", "esperado :: depois de outro")
    vira senao := ler_bloco(cursor, nao)
  fecha

  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar veja").span

  devolve Veja {
    condicao: condicao,
    entao: entao,
    senao: senao,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_gira(cursor: CursorTokens) -> Gira ::
  guarda inicio := espera(cursor, "gira", "SV-PARSE-GIRA", "esperado gira").span
  guarda condicao := ler_expressao(cursor)
  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: depois da condicao do gira")
  guarda corpo := ler_bloco(cursor, nao)
  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar gira").span

  devolve Gira {
    condicao: condicao,
    corpo: corpo,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_para_cada(cursor: CursorTokens) -> ParaCada ::
  guarda inicio := espera(cursor, "para", "SV-PARSE-PARA", "esperado para").span
  espera(cursor, "cada", "SV-PARSE-PARA-CADA", "esperado cada depois de para")
  guarda nome := espera_nome(cursor, "do item iterado").marca
  espera(cursor, "em", "SV-PARSE-PARA-EM", "esperado em depois do item iterado")
  guarda colecao := ler_expressao(cursor)
  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: depois da colecao")
  guarda corpo := ler_bloco(cursor, nao)
  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar para cada").span

  devolve ParaCada {
    nome: nome,
    colecao: colecao,
    corpo: corpo,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_devolve(cursor: CursorTokens) -> Devolve ::
  guarda inicio := espera(cursor, "devolve", "SV-PARSE-DEVOLVE", "esperado devolve").span
  guarda valor := ler_expressao(cursor)

  devolve Devolve {
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_caixa(cursor: CursorTokens) -> Caixa ::
  guarda inicio := espera(cursor, "caixa", "SV-PARSE-CAIXA", "esperado caixa").span
  guarda nome := espera_nome(cursor, "da caixa").marca
  espera(cursor, ":", "SV-PARSE-CAIXA-TIPO", "esperado : depois do nome da caixa")
  espera(cursor, "Byte", "SV-PARSE-CAIXA-BYTE", "caixa deve declarar Byte[tamanho]")
  espera(cursor, "[", "SV-PARSE-CAIXA-TAMANHO", "esperado [ antes do tamanho")
  guarda tamanho := ler_expressao(cursor)
  espera(cursor, "]", "SV-PARSE-CAIXA-TAMANHO", "esperado ] depois do tamanho")

  devolve Caixa {
    nome: nome,
    tamanho: tamanho,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_marca(cursor: CursorTokens) -> Marca ::
  guarda inicio := espera(cursor, "marca", "SV-PARSE-MARCA", "esperado marca").span
  guarda bloco := espera_nome(cursor, "da caixa").marca
  espera(cursor, "@", "SV-PARSE-MARCA-INDICE", "esperado @ antes do indice")
  guarda indice := ler_expressao(cursor)
  espera(cursor, ":=", "SV-PARSE-MARCA-VALOR", "esperado := antes do byte")
  guarda valor := ler_expressao(cursor)

  devolve Marca {
    bloco: bloco,
    indice: indice,
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_pega(cursor: CursorTokens) -> Pega ::
  guarda inicio := espera(cursor, "pega", "SV-PARSE-PEGA", "esperado pega").span
  guarda bloco := espera_nome(cursor, "da caixa").marca
  espera(cursor, "@", "SV-PARSE-PEGA-INDICE", "esperado @ antes do indice")
  guarda indice := ler_expressao(cursor)
  espera(cursor, "->", "SV-PARSE-PEGA-DESTINO", "esperado -> antes do destino")
  guarda destino := espera_nome(cursor, "do destino").marca

  devolve Pega {
    bloco: bloco,
    indice: indice,
    destino: destino,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_zona(cursor: CursorTokens) -> Zona ::
  guarda inicio := espera(cursor, "zona", "SV-PARSE-ZONA", "esperado zona").span
  guarda efeito := espera_nome(cursor, "da zona").marca
  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: depois da zona")
  guarda corpo := ler_bloco(cursor, nao)
  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha para encerrar zona").span

  devolve Zona {
    efeito: efeito,
    corpo: corpo,
    span: span_junta(inicio, fim_span)
  }
fecha

campo ler_falha(cursor: CursorTokens) -> FalhaCmd ::
  guarda inicio := espera(cursor, "falha", "SV-PARSE-FALHA", "esperado falha").span
  guarda codigo := espera_texto(cursor, "com o codigo da falha").literal
  guarda mensagem := espera_texto(cursor, "com a mensagem da falha").literal

  devolve FalhaCmd {
    codigo: codigo,
    mensagem: mensagem,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_expressao(cursor: CursorTokens) -> Expressao ::
  devolve ler_ou(cursor)
fecha

campo ler_ou(cursor: CursorTokens) -> Expressao ::
  solta esquerda := ler_e(cursor)

  gira aceita(cursor, "ou") ::
    guarda operador := token_anterior(cursor)
    guarda direita := ler_e(cursor)
    vira esquerda := ExprBinaria(BinariaExpr {
      esquerda: esquerda,
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve esquerda
fecha

campo ler_e(cursor: CursorTokens) -> Expressao ::
  solta esquerda := ler_igualdade(cursor)

  gira aceita(cursor, "e") ::
    guarda operador := token_anterior(cursor)
    guarda direita := ler_igualdade(cursor)
    vira esquerda := ExprBinaria(BinariaExpr {
      esquerda: esquerda,
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve esquerda
fecha

campo ler_igualdade(cursor: CursorTokens) -> Expressao ::
  solta esquerda := ler_comparacao(cursor)

  gira proximo_e(cursor, "==") ou proximo_e(cursor, "!=") ::
    guarda operador := avanca_token(cursor)
    guarda direita := ler_comparacao(cursor)
    vira esquerda := ExprBinaria(BinariaExpr {
      esquerda: esquerda,
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve esquerda
fecha

campo ler_comparacao(cursor: CursorTokens) -> Expressao ::
  solta esquerda := ler_termo(cursor)

  gira proximo_e(cursor, "<") ou proximo_e(cursor, "<=") ou proximo_e(cursor, ">") ou proximo_e(cursor, ">=") ::
    veja proximo_e(cursor, "<") e parece_especializacao(cursor) ::
      devolve esquerda
    fecha

    guarda operador := avanca_token(cursor)
    guarda direita := ler_termo(cursor)
    vira esquerda := ExprBinaria(BinariaExpr {
      esquerda: esquerda,
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve esquerda
fecha

campo ler_termo(cursor: CursorTokens) -> Expressao ::
  solta esquerda := ler_fator(cursor)

  gira proximo_e(cursor, "+") ou proximo_e(cursor, "-") ::
    guarda operador := avanca_token(cursor)
    guarda direita := ler_fator(cursor)
    vira esquerda := ExprBinaria(BinariaExpr {
      esquerda: esquerda,
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve esquerda
fecha

campo ler_fator(cursor: CursorTokens) -> Expressao ::
  solta esquerda := ler_unaria(cursor)

  gira proximo_e(cursor, "*") ou proximo_e(cursor, "/") ou proximo_e(cursor, "%") ::
    guarda operador := avanca_token(cursor)
    guarda direita := ler_unaria(cursor)
    vira esquerda := ExprBinaria(BinariaExpr {
      esquerda: esquerda,
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve esquerda
fecha

campo ler_unaria(cursor: CursorTokens) -> Expressao ::
  veja proximo_e(cursor, "nao") ou proximo_e(cursor, "-") ::
    guarda operador := avanca_token(cursor)
    guarda direita := ler_unaria(cursor)
    devolve ExprUnaria(UnariaExpr {
      operador: operador.marca,
      direita: direita,
      span: operador.span
    })
  fecha

  devolve ler_posfixa(cursor)
fecha

campo ler_posfixa(cursor: CursorTokens) -> Expressao ::
  solta valor := ler_primaria(cursor)
  solta ativo := sim

  gira ativo ::
    veja aceita(cursor, ".") ::
      guarda membro := espera_nome(cursor, "depois de .")
      vira valor := ExprAcesso(AcessoExpr {
        base: valor,
        membro: membro.marca,
        span: membro.span
      })
    outro ::
      veja aceita(cursor, "[") ::
        guarda inicio := token_anterior(cursor).span
        guarda indice := ler_expressao(cursor)
        guarda fim_span := espera(cursor, "]", "SV-PARSE-INDICE", "esperado ] depois do indice").span
        vira valor := ExprIndice(IndiceExpr {
          base: valor,
          indice: indice,
          span: span_junta(inicio, fim_span)
        })
      outro ::
        veja aceita(cursor, "@") ::
          guarda inicio := token_anterior(cursor).span
          guarda indice := ler_unaria(cursor)
          vira valor := ExprIndice(IndiceExpr {
            base: valor,
            indice: indice,
            span: span_junta(inicio, token_anterior(cursor).span)
          })
        outro ::
          veja proximo_e(cursor, "<") e parece_especializacao(cursor) ::
            guarda inicio := avanca_token(cursor).span
            solta argumentos_tipo := lista<TipoSintaxe>()
            lista_coloca(argumentos_tipo, ler_tipo(cursor))
            gira aceita(cursor, ",") ::
              lista_coloca(argumentos_tipo, ler_tipo(cursor))
            fecha
            guarda fim_span := espera(cursor, ">", "SV-PARSE-ESPECIALIZACAO", "esperado > depois da especializacao").span
            vira valor := ExprEspecializa(EspecializaExpr {
              alvo: valor,
              argumentos: argumentos_tipo,
              span: span_junta(inicio, fim_span)
            })
          outro ::
            veja aceita(cursor, "(") ::
              guarda inicio := token_anterior(cursor).span
              solta argumentos := lista<Expressao>()

              veja nao proximo_e(cursor, ")") ::
                lista_coloca(argumentos, ler_expressao(cursor))
                gira aceita(cursor, ",") ::
                  lista_coloca(argumentos, ler_expressao(cursor))
                fecha
              fecha

              guarda fim_span := espera(cursor, ")", "SV-PARSE-CHAMADA", "esperado ) depois dos argumentos").span
              vira valor := ExprChamada(ChamadaExpr {
                alvo: valor,
                argumentos: argumentos,
                span: span_junta(inicio, fim_span)
              })
            outro ::
              vira ativo := nao
            fecha
          fecha
        fecha
      fecha
    fecha
  fecha

  devolve valor
fecha

campo ler_primaria(cursor: CursorTokens) -> Expressao ::
  guarda atual := atual_token(cursor)

  veja atual.tipo == Numero ::
    avanca_token(cursor)
    devolve ExprLiteral(LitNum(numero(atual.literal)))
  fecha

  veja atual.tipo == TextoLit ::
    avanca_token(cursor)
    devolve ExprLiteral(LitTexto(atual.literal))
  fecha

  veja aceita(cursor, "sim") ::
    devolve ExprLiteral(LitBit(sim))
  fecha

  veja aceita(cursor, "nao") ::
    devolve ExprLiteral(LitBit(nao))
  fecha

  veja aceita(cursor, "nulo") ::
    devolve ExprLiteral(LitNulo)
  fecha

  veja aceita(cursor, "(") ::
    guarda valor := ler_expressao(cursor)
    espera(cursor, ")", "SV-PARSE-GRUPO", "esperado ) depois da expressao")
    devolve valor
  fecha

  veja proximo_e(cursor, "campo") ::
    devolve ExprCampo(ler_campo_anonimo(cursor))
  fecha

  veja atual.tipo == Nome ::
    avanca_token(cursor)
    guarda nome_expr := ExprNome(NomeExpr {
      nome: atual.marca,
      span: atual.span
    })

    veja proximo_e(cursor, "{") ::
      devolve ler_construcao(cursor, atual.marca, lista<TipoSintaxe>(), atual.span)
    fecha

    devolve nome_expr
  fecha

  reporta_atual(
    cursor,
    "SV-PARSE-EXPRESSAO",
    "esperado literal, nome, campo anonimo ou expressao entre parenteses",
    "verifique se falta um valor antes deste ponto"
  )

  veja nao fim(cursor) ::
    avanca_token(cursor)
  fecha

  devolve ExprLiteral(LitNulo)
fecha

campo ler_construcao(
  cursor: CursorTokens,
  nome: Texto,
  argumentos_tipo: Lista<TipoSintaxe>,
  inicio: Span
) -> Expressao ::
  espera(cursor, "{", "SV-PARSE-CONSTRUCAO", "esperado { na construcao")
  solta campos := lista<CampoValor>()

  veja nao proximo_e(cursor, "}") ::
    lista_coloca(campos, ler_campo_valor(cursor))
    gira aceita(cursor, ",") ::
      lista_coloca(campos, ler_campo_valor(cursor))
    fecha
  fecha

  guarda fim_span := espera(cursor, "}", "SV-PARSE-CONSTRUCAO", "esperado } depois dos campos").span
  guarda tipo := TipoSintaxe {
    nome: nome,
    argumentos: argumentos_tipo,
    matriz: nao,
    span: inicio
  }

  devolve ExprConstrucao(ConstrucaoExpr {
    tipo: tipo,
    campos: campos,
    span: span_junta(inicio, fim_span)
  })
fecha

campo ler_campo_valor(cursor: CursorTokens) -> CampoValor ::
  guarda inicio := atual_token(cursor).span
  guarda nome := espera_nome(cursor, "do campo construido").marca
  espera(cursor, ":", "SV-PARSE-CONSTRUCAO-CAMPO", "esperado : depois do campo")
  guarda valor := ler_expressao(cursor)

  devolve CampoValor {
    nome: nome,
    valor: valor,
    span: span_junta(inicio, token_anterior(cursor).span)
  }
fecha

campo ler_campo_anonimo(cursor: CursorTokens) -> CampoAnonimoExpr ::
  guarda inicio := espera(cursor, "campo", "SV-PARSE-CAMPO-ANONIMO", "esperado campo").span
  guarda parametros := ler_parametros(cursor)
  guarda retorno := ler_retorno(cursor)
  guarda efeitos := ler_efeitos(cursor)
  espera(cursor, "::", "SV-PARSE-BLOCO", "esperado :: no campo anonimo")
  guarda corpo := ler_bloco(cursor, nao)
  guarda fim_span := espera(cursor, "fecha", "SV-PARSE-FECHA", "esperado fecha no campo anonimo").span

  devolve CampoAnonimoExpr {
    parametros: parametros,
    retorno: retorno,
    efeitos: efeitos,
    corpo: corpo,
    span: span_junta(inicio, fim_span)
  }
fecha

campo parece_especializacao(cursor: CursorTokens) -> Bit ::
  veja nao proximo_e(cursor, "<") ::
    devolve nao
  fecha

  solta pos := cursor.posicao
  solta profundidade: U32 := 0
  guarda total := lista_tamanho(cursor.fluxo.tokens)

  gira pos < total ::
    guarda t := lista_pega(cursor.fluxo.tokens, pos)

    veja t.marca == "<" ::
      vira profundidade := profundidade + 1
    outro ::
      veja t.marca == ">" ::
        veja profundidade == 0 ::
          devolve nao
        fecha

        vira profundidade := profundidade - 1
        veja profundidade == 0 ::
          veja pos + 1 >= total ::
            devolve nao
          fecha

          guarda depois := lista_pega(cursor.fluxo.tokens, pos + 1).marca
          devolve depois == "(" ou depois == "{" ou depois == "."
        fecha
      outro ::
        veja t.tipo == Fim ou t.marca == "::" ou t.marca == ":=" ::
          devolve nao
        fecha
      fecha
    fecha

    vira pos := pos + 1
  fecha

  devolve nao
fecha
