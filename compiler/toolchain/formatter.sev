modulo seven.compiler.toolchain.formatter

usa std.base.resultado
usa std.fs.file

molde ResultadoFmt ::
  caminho: Texto
  alterado: Bit
  conteudo: Texto
fecha

campo fmt_caminho(caminho: Texto, escreve: Bit) -> Resultado<ResultadoFmt, Falha> toca disco ::
  guarda texto := arquivo_texto(caminho)

  veja texto e Falha ::
    devolve Falha(texto.valor)
  fecha

  guarda formatado := fmt_texto(texto.valor)
  guarda mudou := formatado != texto.valor

  veja escreve ::
    veja mudou ::
      arquivo_salva_texto(caminho, formatado)
    fecha
  fecha

  devolve Valor(ResultadoFmt {
    caminho: caminho,
    alterado: mudou,
    conteudo: formatado
  })
fecha

campo fmt_texto(fonte: Texto) -> Texto ::
  solta saida := ""
  solta nivel: U64 := 0

  para cada linha em linhas(fonte) ::
    guarda limpa := fmt_trim(linha)

    veja (limpa == "fecha" ou texto_comeca(limpa, "outro")) e nivel > 0 ::
      vira nivel := nivel - 1
    fecha

    vira saida := saida + fmt_repete("  ", nivel) + limpa + "\n"

    veja fmt_abre_bloco(limpa) ::
      vira nivel := nivel + 1
    fecha
  fecha

  devolve saida
fecha

campo fmt_abre_bloco(linha: Texto) -> Bit ::
  devolve texto_comeca(linha, "campo ") ou
    texto_comeca(linha, "molde ") ou
    texto_comeca(linha, "selo ") ou
    texto_comeca(linha, "veja ") ou
    texto_comeca(linha, "outro") ou
    texto_comeca(linha, "para ") ou
    texto_comeca(linha, "gira ") ou
    texto_comeca(linha, "zona ")
fecha

campo fmt_trim(valor: Texto) -> Texto ::
  guarda total := sys_texto_tamanho(valor)
  solta inicio: U64 := 0
  solta fim := total

  gira inicio < fim e fmt_espaco(sys_texto_caractere(valor, inicio)) ::
    vira inicio := inicio + 1
  fecha

  gira fim > inicio e fmt_espaco(sys_texto_caractere(valor, fim - 1)) ::
    vira fim := fim - 1
  fecha

  devolve sys_texto_fatia(valor, inicio, fim)
fecha

campo fmt_espaco(valor: Texto) -> Bit ::
  devolve valor == " " ou valor == "\t" ou valor == "\r" ou valor == "\n"
fecha

campo fmt_repete(valor: Texto, quantidade: U64) -> Texto ::
  solta saida := ""
  solta indice: U64 := 0
  gira indice < quantidade ::
    vira saida := saida + valor
    vira indice := indice + 1
  fecha
  devolve saida
fecha
