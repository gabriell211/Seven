modulo seven.compiler.toolchain.web_build

usa seven.compiler.source
usa seven.compiler.lexer
usa seven.compiler.parser
usa seven.compiler.semantic
usa seven.compiler.ir
usa seven.compiler.web_ir
usa seven.compiler.driver
usa seven.compiler.diagnostic
usa seven.compiler.package
usa seven.compiler.wasm
usa seven.compiler.toolchain.command
usa std.base.resultado
usa std.base.texto
usa std.crypto.hash
usa std.fs.file
usa std.io.console
usa std.os.install

campo executa_web_build(entrada: Texto, saida: Texto) -> SaidaToolchain toca terminal, disco, ambiente ::
  guarda pacote := pacote_parse(
    web_manifesto_compilacao(entrada)
  )
  guarda fontes := fonte_carrega_pacote(pacote)
  guarda tokens := varre_unidade(fontes)
  guarda sintaxe := monta_unidade(tokens)

  veja diagnosticos_tem_erros(sintaxe.diagnosticos) ::
    mostra_diagnosticos(sintaxe.diagnosticos)
    devolve ToolchainErro(1, "compilacao web falhou na sintaxe")
  fecha

  guarda semantica := mede(sintaxe.programas, pacote)
  guarda diagnosticos := junta_diagnosticos(sintaxe.diagnosticos, semantica)
  veja diagnosticos_tem_erros(diagnosticos) ::
    mostra_diagnosticos(diagnosticos)
    devolve ToolchainErro(1, "compilacao web falhou na semantica")
  fecha

  guarda meio := baixa_ir(sintaxe.programas, semantica.tipos, semantica.efeitos)
  guarda otimizado := prepara_ir_web(otimiza_ir(meio, "seguro"))
  guarda wasm := emite_wasm(otimizado)
  veja wasm e Falha ::
    devolve ToolchainErro(1, wasm.valor.codigo + ": " + wasm.valor.mensagem)
  fecha

  guarda cria := diretorio_cria(saida)
  veja cria e Falha :: devolve ToolchainErro(1, cria.valor.codigo + ": " + cria.valor.mensagem) fecha

  guarda caminho_wasm := saida + "/app.wasm"
  guarda grava_wasm := arquivo_salva_bytes(caminho_wasm, wasm.valor)
  veja grava_wasm e Falha :: devolve ToolchainErro(1, grava_wasm.valor.codigo + ": " + grava_wasm.valor.mensagem) fecha

  guarda checksum := hash_texto(sha256(wasm.valor))
  guarda grava_html := arquivo_salva_texto(saida + "/index.html", web_index_html())
  veja grava_html e Falha :: devolve ToolchainErro(1, grava_html.valor.codigo + ": " + grava_html.valor.mensagem) fecha

  guarda grava_loader := arquivo_salva_texto(saida + "/seven-loader.mjs", web_loader_modulo())
  veja grava_loader e Falha :: devolve ToolchainErro(1, grava_loader.valor.codigo + ": " + grava_loader.valor.mensagem) fecha

  guarda grava_manifesto := arquivo_salva_texto(
    saida + "/seven.web.json",
    web_manifesto_json(entrada, checksum)
  )
  veja grava_manifesto e Falha :: devolve ToolchainErro(1, grava_manifesto.valor.codigo + ": " + grava_manifesto.valor.mensagem) fecha

  guarda grava_checksum := arquivo_salva_texto(
    saida + "/app.wasm.sha256",
    checksum + "  app.wasm\n"
  )
  veja grava_checksum e Falha :: devolve ToolchainErro(1, grava_checksum.valor.codigo + ": " + grava_checksum.valor.mensagem) fecha

  diga("web wasm: " + caminho_wasm)
  diga("web manifesto: " + saida + "/seven.web.json")
  diga("web sha256: " + checksum)
  devolve ToolchainOk(0)
fecha

campo web_manifesto_compilacao(entrada: Texto) -> Texto toca disco ::
  guarda entrada_texto := arquivo_ler(entrada)
  guarda estilos := web_arquivo_irmao(entrada, "styles.sev")
  solta estilos_texto := ""

  veja arquivo_existe(estilos) ::
    vira estilos_texto := arquivo_ler(estilos)
  fecha

  guarda fontes_texto := entrada_texto + "\n" + estilos_texto
  guarda usa_dom := texto_contem(fontes_texto, "usa std.frontend.dom")
  guarda usa_css := texto_contem(fontes_texto, "usa std.frontend.css")
  guarda usa_layout := texto_contem(fontes_texto, "usa std.frontend.layout")
  guarda usa_media := texto_contem(fontes_texto, "usa std.frontend.media")
  guarda usa_theme := texto_contem(fontes_texto, "usa std.frontend.theme")
  guarda usa_html := texto_contem(fontes_texto, "usa std.web.html")
  guarda usa_convert := texto_contem(fontes_texto, "usa std.base.convert")
  guarda precisa_lista := usa_dom ou usa_css ou usa_layout ou usa_media ou usa_theme ou usa_html
  guarda precisa_mapa := usa_dom
  guarda precisa_talvez := precisa_mapa
  guarda precisa_convert := usa_convert ou usa_css ou usa_layout ou usa_media ou usa_theme
  solta manifesto := "pacote seven-web-app\n" +
    "versao 0.2.0\n" +
    "criador Gabriel Barcelos\n" +
    "entrada " + entrada + "\n" +
    "alvo webassembly\n" +
    "fonte std/frontend/intrinsics.sev\n"

  veja precisa_lista ::
    vira manifesto := manifesto + "fonte std/base/lista.sev\n"
  fecha

  veja precisa_talvez ::
    vira manifesto := manifesto + "fonte std/base/talvez.sev\n"
  fecha

  veja precisa_mapa ::
    vira manifesto := manifesto + "fonte std/base/mapa.sev\n"
  fecha

  veja precisa_convert ::
    vira manifesto := manifesto + "fonte std/base/convert.sev\n"
  fecha

  veja usa_dom ::
    vira manifesto := manifesto + "fonte std/frontend/dom.sev\n"
  fecha

  veja usa_css ::
    vira manifesto := manifesto + "fonte std/frontend/css.sev\n"
  fecha

  veja texto_contem(fontes_texto, "usa std.frontend.state") ::
    vira manifesto := manifesto + "fonte std/frontend/state.sev\n"
  fecha

  veja usa_layout ::
    vira manifesto := manifesto + "fonte std/frontend/layout.sev\n"
  fecha

  veja usa_media ::
    vira manifesto := manifesto + "fonte std/frontend/media.sev\n"
  fecha

  veja usa_theme ::
    vira manifesto := manifesto + "fonte std/frontend/theme.sev\n"
  fecha

  veja usa_html ::
    vira manifesto := manifesto + "fonte std/web/html.sev\n"
  fecha

  veja arquivo_existe(estilos) ::
    vira manifesto := manifesto + "fonte " + estilos + "\n"
  fecha

  devolve manifesto + "fonte " + entrada + "\n"
fecha

campo web_arquivo_irmao(entrada: Texto, nome: Texto) -> Texto ::
  solta ultimo: U64 := 0
  solta indice: U64 := 0

  gira indice < tamanho(entrada) ::
    guarda ch := sys_texto_caractere(entrada, indice)
    veja ch == "/" ou ch == "\\" ::
      vira ultimo := indice + 1
    fecha
    vira indice := indice + 1
  fecha

  veja ultimo == 0 ::
    devolve nome
  fecha

  devolve sys_texto_fatia(entrada, 0, ultimo) + nome
fecha

campo web_index_html() -> Texto ::
  devolve "<!doctype html>\n" +
    "<html lang=\"pt-BR\">\n" +
    "<head>\n" +
    "  <meta charset=\"utf-8\">\n" +
    "  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n" +
    "  <meta name=\"generator\" content=\"Seven 0.2 WebAssembly\">\n" +
    "  <title>Seven Web</title>\n" +
    "</head>\n" +
    "<body>\n" +
    "  <main id=\"seven-app\"></main>\n" +
    "  <pre id=\"seven-output\" hidden></pre>\n" +
    "  <script type=\"module\" src=\"./seven-loader.mjs\"></script>\n" +
    "</body>\n" +
    "</html>\n"
fecha

campo web_loader_modulo() -> Texto ::
  devolve "const decoder = new TextDecoder();\n" +
    "const encoder = new TextEncoder();\n" +
    "const INBOX = 32768;\n" +
    "const INBOX_MAX = 32760;\n" +
    "let instance;\n" +
    "let memory;\n" +
    "let lastResponse = '';\n" +
    "let lastStatus = 0;\n" +
    "let lastEventValue = '';\n" +
    "const dataView = () => new DataView(memory.buffer);\n" +
    "const decode = descriptor => {\n" +
    "  if (!descriptor) return '';\n" +
    "  const view = dataView();\n" +
    "  const pointer = view.getUint32(descriptor, true);\n" +
    "  const length = view.getUint32(descriptor + 4, true);\n" +
    "  return decoder.decode(new Uint8Array(memory.buffer, pointer, length));\n" +
    "};\n" +
    "const writeInbox = value => {\n" +
    "  const bytes = encoder.encode(String(value ?? ''));\n" +
    "  if (bytes.length > INBOX_MAX) throw new Error('Resposta excede a inbox Seven Web');\n" +
    "  const view = dataView();\n" +
    "  view.setUint32(INBOX, INBOX + 8, true);\n" +
    "  view.setUint32(INBOX + 4, bytes.length, true);\n" +
    "  new Uint8Array(memory.buffer, INBOX + 8, bytes.length).set(bytes);\n" +
    "  return INBOX;\n" +
    "};\n" +
    "const HANDLE_BASE = 1048576;\n" +
    "let nextHandle = HANDLE_BASE;\n" +
    "const handles = new Map();\n" +
    "const storeHandle = value => {\n" +
    "  const id = nextHandle++;\n" +
    "  handles.set(id, value);\n" +
    "  return id;\n" +
    "};\n" +
    "const isHandle = value => handles.has(value);\n" +
    "const ref = value => handles.get(value);\n" +
    "const looksText = value => {\n" +
    "  if (!value || isHandle(value) || value < 0 || value + 8 > memory.buffer.byteLength) return false;\n" +
    "  const view = dataView();\n" +
    "  const pointer = view.getUint32(value, true);\n" +
    "  const length = view.getUint32(value + 4, true);\n" +
    "  return pointer >= 8 && pointer + length <= memory.buffer.byteLength;\n" +
    "};\n" +
    "const fromSeven = value => isHandle(value) ? value : (looksText(value) ? decode(value) : (value | 0));\n" +
    "const toSeven = value => typeof value === 'string' ? writeInbox(value) : (value || 0);\n" +
    "const textFields = new Set(['__tipo', 'tag', 'nome', 'valor', 'seletor', 'consulta', 'ponto', 'alvo']);\n" +
    "const fieldFromSeven = (key, value) => isHandle(value) ? value : (textFields.has(key) ? decode(value) : fromSeven(value));\n" +
    "const escapeHtml = value => String(value ?? '').replace(/[&<>\\\"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;'}[ch]));\n" +
    "const createObject = args => {\n" +
    "  const object = { type: 'objeto', fields: Object.create(null), items: [] };\n" +
    "  for (let i = 0; i + 1 < args.length; i += 2) {\n" +
    "    const key = decode(args[i]);\n" +
    "    const value = fieldFromSeven(key, args[i + 1]);\n" +
    "    object.fields[key] = value;\n" +
    "    if (key === '__tipo') object.type = String(value);\n" +
    "  }\n" +
    "  if (object.type === 'Lista') object.items = [];\n" +
    "  if (object.fields.tamanho === undefined && object.items) object.fields.tamanho = object.items.length;\n" +
    "  return storeHandle(object);\n" +
    "};\n" +
    "const field = (object, name) => {\n" +
    "  const target = isHandle(object) ? ref(object) : object;\n" +
    "  if (!target) return 0;\n" +
    "  if (name === 'tamanho' && target.items) return target.items.length;\n" +
    "  return target.fields?.[name] ?? 0;\n" +
    "};\n" +
    "const asArray = value => {\n" +
    "  const target = isHandle(value) ? ref(value) : value;\n" +
    "  return target?.items ?? [];\n" +
    "};\n" +
    "const cssDecls = list => asArray(list).map(item => {\n" +
    "  const decl = ref(item);\n" +
    "  return `${field(decl, 'nome')}:${field(decl, 'valor')};`;\n" +
    "}).join('');\n" +
    "const renderCss = folhaHandle => {\n" +
    "  const folha = ref(folhaHandle);\n" +
    "  if (!folha) return '';\n" +
    "  let css = '';\n" +
    "  const variaveis = cssDecls(field(folha, 'variaveis'));\n" +
    "  if (variaveis) css += `:root{${variaveis}}`;\n" +
    "  for (const regraHandle of asArray(field(folha, 'regras'))) {\n" +
    "    const regra = ref(regraHandle);\n" +
    "    css += `${field(regra, 'seletor')}{${cssDecls(field(regra, 'declaracoes'))}}`;\n" +
    "  }\n" +
    "  return css;\n" +
    "};\n" +
    "const renderHtmlNode = nodeHandle => {\n" +
    "  if (!isHandle(nodeHandle)) return escapeHtml(nodeHandle);\n" +
    "  const node = ref(nodeHandle);\n" +
    "  if (!node) return '';\n" +
    "  if (node.type === 'TextoNo') return escapeHtml(field(node, 'valor'));\n" +
    "  if (node.type === 'ElementoNo') return renderElement(field(node, 'valor'));\n" +
    "  if (node.type === 'Elemento') return renderElement(nodeHandle);\n" +
    "  return '';\n" +
    "};\n" +
    "const renderElement = elementHandle => {\n" +
    "  const element = isHandle(elementHandle) ? ref(elementHandle) : elementHandle;\n" +
    "  if (!element) return '';\n" +
    "  const name = String(field(element, 'nome') || 'div');\n" +
    "  const attrs = asArray(field(element, 'atributos')).map(attrHandle => {\n" +
    "    const attr = ref(attrHandle);\n" +
    "    return ` ${field(attr, 'nome')}=\\\"${escapeHtml(field(attr, 'valor'))}\\\"`;\n" +
    "  }).join('');\n" +
    "  const children = asArray(field(element, 'filhos')).map(renderHtmlNode).join('');\n" +
    "  return `<${name}${attrs}>${children}</${name}>`;\n" +
    "};\n" +
    "const invoke = name => {\n" +
    "  const handler = instance.exports['seven_' + name];\n" +
    "  if (typeof handler !== 'function') throw new Error('Handler Seven inexistente: ' + name);\n" +
    "  return handler();\n" +
    "};\n" +
    "const imports = { seven: {\n" +
    "  terminal_diga(texto) {\n" +
    "    const valor = decode(texto);\n" +
    "    console.log(valor);\n" +
    "    const output = document.getElementById('seven-output');\n" +
    "    if (output) output.textContent += valor + '\\n';\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_monta(seletor, html) {\n" +
    "    const alvo = document.querySelector(decode(seletor));\n" +
    "    if (alvo) alvo.innerHTML = decode(html);\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_texto(seletor, texto) {\n" +
    "    const alvo = document.querySelector(decode(seletor));\n" +
    "    if (alvo) alvo.textContent = decode(texto);\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_atributo(seletor, nome, valor) {\n" +
    "    const alvo = document.querySelector(decode(seletor));\n" +
    "    if (alvo) alvo.setAttribute(decode(nome), decode(valor));\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_classe_adiciona(seletor, classe) {\n" +
    "    document.querySelectorAll(decode(seletor)).forEach(alvo => alvo.classList.add(decode(classe)));\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_classe_remove(seletor, classe) {\n" +
    "    document.querySelectorAll(decode(seletor)).forEach(alvo => alvo.classList.remove(decode(classe)));\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_escuta(seletor, evento, campo) {\n" +
    "    const nomeEvento = decode(evento);\n" +
    "    const nomeCampo = decode(campo);\n" +
    "    document.querySelectorAll(decode(seletor)).forEach(alvo => {\n" +
    "      alvo.addEventListener(nomeEvento, ocorrencia => {\n" +
    "        lastEventValue = ocorrencia?.target?.value ?? ocorrencia?.target?.textContent ?? '';\n" +
    "        writeInbox(lastEventValue);\n" +
    "        invoke(nomeCampo);\n" +
    "      });\n" +
    "    });\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_navega(url) { location.assign(decode(url)); return 0; },\n" +
    "  frontend_injeta_css(css) {\n" +
    "    const estilo = document.createElement('style');\n" +
    "    estilo.textContent = decode(css);\n" +
    "    document.head.appendChild(estilo);\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_fetch_texto(url, campo) {\n" +
    "    const destino = decode(url);\n" +
    "    const nomeCampo = decode(campo);\n" +
    "    fetch(destino).then(async resposta => {\n" +
    "      lastStatus = resposta.status;\n" +
    "      lastResponse = await resposta.text();\n" +
    "      writeInbox(lastResponse);\n" +
    "      invoke(nomeCampo);\n" +
    "    }).catch(erro => {\n" +
    "      lastStatus = 0;\n" +
    "      lastResponse = String(erro);\n" +
    "      writeInbox(lastResponse);\n" +
    "      invoke(nomeCampo);\n" +
    "    });\n" +
    "    return 0;\n" +
    "  },\n" +
    "  frontend_resposta_texto() { return writeInbox(lastResponse); },\n" +
    "  frontend_resposta_status() { return lastStatus | 0; },\n" +
    "  frontend_evento_valor() { return writeInbox(lastEventValue); },\n" +
    "  frontend_armazena(chave, valor) { localStorage.setItem(decode(chave), decode(valor)); return 0; },\n" +
    "  frontend_carrega(chave) { return writeInbox(localStorage.getItem(decode(chave)) ?? ''); },\n" +
    "  frontend_remove(chave) { localStorage.removeItem(decode(chave)); return 0; },\n" +
    "  sys_numero(valor) { return Number.parseInt(decode(valor), 10) || 0; },\n" +
    "  sys_texto_num(valor) { return writeInbox(String(valor | 0)); },\n" +
    "  sys_texto_u64(valor) { return writeInbox(String(valor >>> 0)); },\n" +
    "  sys_texto_concat(esquerda, direita) { return writeInbox(decode(esquerda) + decode(direita)); },\n" +
    "  sys_obj_novo(...args) { return createObject(args); },\n" +
    "  sys_obj_pega(objeto, chave) { return toSeven(field(objeto, decode(chave))); },\n" +
    "  sys_obj_define(objeto, chave, valor) { const alvo = ref(objeto); const nome = decode(chave); if (alvo) alvo.fields[nome] = fieldFromSeven(nome, valor); return objeto; },\n" +
    "  sys_lista_coloca(lista, valor) { const alvo = ref(lista); if (alvo) { alvo.items.push(fromSeven(valor)); alvo.fields.tamanho = alvo.items.length; } return lista; },\n" +
    "  sys_lista_pega(lista, indice) { const alvo = ref(lista); return toSeven(alvo?.items?.[indice >>> 0] ?? 0); },\n" +
    "  sys_lista_define(lista, indice, valor) { const alvo = ref(lista); if (alvo) alvo.items[indice >>> 0] = fromSeven(valor); return lista; },\n" +
    "  sys_lista_insere(lista, indice, valor) { const alvo = ref(lista); if (alvo) { alvo.items.splice(indice >>> 0, 0, fromSeven(valor)); alvo.fields.tamanho = alvo.items.length; } return lista; },\n" +
    "  sys_lista_remove(lista, indice) { const alvo = ref(lista); if (!alvo) return 0; const [removido] = alvo.items.splice(indice >>> 0, 1); alvo.fields.tamanho = alvo.items.length; return toSeven(removido ?? 0); },\n" +
    "  sys_lista_pop(lista) { const alvo = ref(lista); if (!alvo) return 0; const removido = alvo.items.pop(); alvo.fields.tamanho = alvo.items.length; return toSeven(removido ?? 0); },\n" +
    "  sys_css_renderiza(folha) { return writeInbox(renderCss(folha)); },\n" +
    "  sys_html_renderiza(elemento) { return writeInbox(renderElement(elemento)); }\n" +
    "} };\n" +
    "const resposta = await fetch('./app.wasm', { cache: 'no-store' });\n" +
    "if (!resposta.ok) throw new Error('Falha ao carregar app.wasm: ' + resposta.status);\n" +
    "const bytes = await resposta.arrayBuffer();\n" +
    "const modulo = await WebAssembly.instantiate(bytes, imports);\n" +
    "instance = modulo.instance;\n" +
    "memory = instance.exports.memory;\n" +
    "const codigo = instance.exports.seven_start();\n" +
    "globalThis.SevenWeb = Object.freeze({ instance, codigo, invoke });\n"
fecha

campo web_manifesto_json(entrada: Texto, checksum: Texto) -> Texto ::
  guarda fonte := web_manifesto_caminho(entrada)
  devolve "{\n" +
    "  \"format\": \"seven-web-2\",\n" +
    "  \"language\": \"Seven\",\n" +
    "  \"source\": \"" + fonte + "\",\n" +
    "  \"sourceExtension\": \".sev\",\n" +
    "  \"target\": \"webassembly\",\n" +
    "  \"executable\": \"app.wasm\",\n" +
    "  \"entryExport\": \"seven_start\",\n" +
    "  \"handlerPrefix\": \"seven_\",\n" +
    "  \"hostAbi\": \"seven-web-2\",\n" +
    "  \"inboxOffset\": 32768,\n" +
    "  \"capabilities\": [\"dom\", \"events\", \"navigation\", \"fetch\", \"storage\", \"number-format\", \"host-objects\", \"typed-css\", \"typed-html\"],\n" +
    "  \"applicationLanguageDependency\": false,\n" +
    "  \"sha256\": \"" + checksum + "\"\n" +
    "}\n"
fecha

campo web_manifesto_caminho(entrada: Texto) -> Texto ::
  solta saida := ""
  solta indice: U64 := 0

  gira indice < tamanho(entrada) ::
    guarda caractere := sys_texto_caractere(entrada, indice)
    veja caractere == "\\" ::
      vira saida := saida + "/"
    outro ::
      vira saida := saida + caractere
    fecha
    vira indice := indice + 1
  fecha

  devolve saida
fecha
