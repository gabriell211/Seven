modulo seven.compiler.wasm

usa seven.compiler.ir
usa seven.compiler.types
usa std.base.lista
usa std.base.resultado
usa std.base.talvez
usa std.mem.bytes

const WasmPagina: U64 := 65536
const WasmDadosInicio: U32 := 1024
const WasmInboxInicio: U32 := 32768
const WasmAridadeMaximaTipo: U32 := 12

molde TextoWasm ::
  campo: Texto
  local: U32
  descritor: U32
fecha

molde ImportWasm ::
  nome: Texto
  aridade: U32
fecha

molde PlanoWasm ::
  campos: Lista<CampoIr>
  textos: Lista<TextoWasm>
  dados: Bytes
fecha

campo emite_wasm(unidade: UnidadeIr) -> Resultado<Bytes, Falha> ::
  guarda plano := planeja_wasm(unidade)
  veja plano e Falha ::
    devolve Falha(plano.valor)
  fecha

  solta modulo := bytes_novo()
  bytes_coloca_byte(modulo, 0)
  bytes_coloca_byte(modulo, 97)
  bytes_coloca_byte(modulo, 115)
  bytes_coloca_byte(modulo, 109)
  bytes_coloca_byte(modulo, 1)
  bytes_coloca_byte(modulo, 0)
  bytes_coloca_byte(modulo, 0)
  bytes_coloca_byte(modulo, 0)

  wasm_secao(modulo, 1, wasm_secao_tipos())
  wasm_secao(modulo, 2, wasm_secao_imports())
  wasm_secao(modulo, 3, wasm_secao_funcoes(plano.valor))
  wasm_secao(modulo, 5, wasm_secao_memoria())
  wasm_secao(modulo, 7, wasm_secao_exports(plano.valor))

  guarda codigo := wasm_secao_codigo(plano.valor)
  veja codigo e Falha :: devolve Falha(codigo.valor) fecha
  wasm_secao(modulo, 10, codigo.valor)
  wasm_secao(modulo, 11, wasm_secao_dados(plano.valor))

  devolve Valor(modulo)
fecha

campo planeja_wasm(unidade: UnidadeIr) -> Resultado<PlanoWasm, Falha> ::
  solta campos := lista<CampoIr>()
  solta encontrou_inicio := nao

  para cada campo em unidade.campos ::
    veja nao wasm_intrinseco(campo.nome) ::
      veja campo.parametros > 4 ::
        devolve Falha(nova_falha(
          "SV-WASM-ARIDADE",
          "campo web excede quatro parametros: " + campo.nome
        ))
      fecha
      veja campo.nome == "inicio" ::
        vira encontrou_inicio := sim
        veja campo.parametros != 0 ::
          devolve Falha(nova_falha("SV-WASM-ENTRADA", "inicio web nao recebe parametros"))
        fecha
      fecha
      lista_coloca(campos, campo)
    fecha
  fecha

  veja nao encontrou_inicio ::
    devolve Falha(nova_falha("SV-WASM-ENTRADA", "o alvo web exige um campo inicio()"))
  fecha

  solta textos := lista<TextoWasm>()
  solta dados := bytes_novo()

  para cada campo em campos ::
    para cada bloco em campo.blocos ::
      para cada instrucao em bloco.instrucoes ::
        veja instrucao e IrConst ::
          veja instrucao.valor e ValorTexto ::
            guarda texto_bytes_atual := texto_bytes(instrucao.valor.valor)
            guarda descritor := WasmDadosInicio + U32(dados.tamanho)
            guarda conteudo := descritor + 8
            veja U64(conteudo) + texto_bytes_atual.tamanho >= U64(WasmInboxInicio) ::
              devolve Falha(nova_falha(
                "SV-WASM-MEMORIA",
                "dados estaticos invadem a area de comunicacao do navegador"
              ))
            fecha
            wasm_u32_le(dados, conteudo)
            wasm_u32_le(dados, U32(texto_bytes_atual.tamanho))
            wasm_anexa(dados, texto_bytes_atual)
            lista_coloca(textos, TextoWasm {
              campo: campo.nome,
              local: instrucao.destino,
              descritor: descritor
            })
          fecha
        fecha
      fecha
    fecha
  fecha

  devolve Valor(PlanoWasm {
    campos: campos,
    textos: textos,
    dados: dados
  })
fecha

campo wasm_imports() -> Lista<ImportWasm> ::
  solta imports := lista<ImportWasm>()
  lista_coloca(imports, ImportWasm { nome: "terminal_diga", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "frontend_monta", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "frontend_texto", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "frontend_atributo", aridade: 3 })
  lista_coloca(imports, ImportWasm { nome: "frontend_classe_adiciona", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "frontend_classe_remove", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "frontend_escuta", aridade: 3 })
  lista_coloca(imports, ImportWasm { nome: "frontend_navega", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "frontend_injeta_css", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "frontend_fetch_texto", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "frontend_resposta_texto", aridade: 0 })
  lista_coloca(imports, ImportWasm { nome: "frontend_resposta_status", aridade: 0 })
  lista_coloca(imports, ImportWasm { nome: "frontend_evento_valor", aridade: 0 })
  lista_coloca(imports, ImportWasm { nome: "frontend_armazena", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "frontend_carrega", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "frontend_remove", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_numero", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_texto_num", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_texto_u64", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_texto_concat", aridade: 2 })
  wasm_imports_variadico(imports, "sys_obj_novo", WasmAridadeMaximaTipo)
  lista_coloca(imports, ImportWasm { nome: "sys_obj_pega", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "sys_obj_define", aridade: 3 })
  lista_coloca(imports, ImportWasm { nome: "sys_lista_coloca", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "sys_lista_pega", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "sys_lista_define", aridade: 3 })
  lista_coloca(imports, ImportWasm { nome: "sys_lista_insere", aridade: 3 })
  lista_coloca(imports, ImportWasm { nome: "sys_lista_remove", aridade: 2 })
  lista_coloca(imports, ImportWasm { nome: "sys_lista_pop", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_iterador_novo", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_iterador_tem", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_iterador_atual", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_iterador_avanca", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_css_renderiza", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_html_renderiza", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_css_media_declaracoes", aridade: 1 })
  lista_coloca(imports, ImportWasm { nome: "sys_css_animacao_declaracoes", aridade: 1 })
  devolve imports
fecha

campo wasm_imports_variadico(imports: Lista<ImportWasm>, nome: Texto, aridade_maxima: U32) -> Nada ::
  solta aridade: U32 := 0
  gira aridade <= aridade_maxima ::
    lista_coloca(imports, ImportWasm { nome: nome, aridade: aridade })
    vira aridade := aridade + 1
  fecha
fecha

campo wasm_quantidade_imports() -> U32 ::
  devolve U32(lista_tamanho(wasm_imports()))
fecha

campo wasm_intrinseco(nome: Texto) -> Bit ::
  para cada item em wasm_imports() ::
    veja item.nome == nome :: devolve sim fecha
  fecha
  devolve nao
fecha

campo indice_import_wasm(nome: Texto, aridade: U32) -> Resultado<U32, Falha> ::
  solta indice: U32 := 0
  para cada item em wasm_imports() ::
    veja item.nome == nome e item.aridade == aridade :: devolve Valor(indice) fecha
    vira indice := indice + 1
  fecha
  devolve Falha(nova_falha("SV-WASM-SYSCALL", "intrinseco web nao suportado: " + nome))
fecha

campo indice_campo_wasm(plano: PlanoWasm, nome: Texto) -> Resultado<U32, Falha> ::
  solta indice: U32 := 0
  para cada campo em plano.campos ::
    veja campo.nome == nome :: devolve Valor(wasm_quantidade_imports() + indice) fecha
    vira indice := indice + 1
  fecha
  devolve Falha(nova_falha("SV-WASM-CAMPO", "campo chamado nao foi encontrado: " + nome))
fecha

campo descritor_texto_wasm(plano: PlanoWasm, campo: Texto, local: U32) -> Resultado<U32, Falha> ::
  para cada texto em plano.textos ::
    veja texto.campo == campo e texto.local == local ::
      devolve Valor(texto.descritor)
    fecha
  fecha
  devolve Falha(nova_falha("SV-WASM-TEXTO", "constante de texto nao foi planejada"))
fecha

campo wasm_secao_tipos() -> Bytes ::
  solta secao := bytes_novo()
  wasm_uleb(secao, WasmAridadeMaximaTipo + 1)
  solta aridade: U32 := 0
  gira aridade <= WasmAridadeMaximaTipo ::
    bytes_coloca_byte(secao, 96)
    wasm_uleb(secao, aridade)
    solta indice: U32 := 0
    gira indice < aridade ::
      bytes_coloca_byte(secao, 127)
      vira indice := indice + 1
    fecha
    wasm_uleb(secao, 1)
    bytes_coloca_byte(secao, 127)
    vira aridade := aridade + 1
  fecha
  devolve secao
fecha

campo wasm_secao_imports() -> Bytes ::
  solta secao := bytes_novo()
  guarda imports := wasm_imports()
  wasm_uleb(secao, U32(lista_tamanho(imports)))
  para cada item em imports ::
    wasm_texto(secao, "seven")
    wasm_texto(secao, item.nome)
    bytes_coloca_byte(secao, 0)
    wasm_uleb(secao, item.aridade)
  fecha
  devolve secao
fecha

campo wasm_secao_funcoes(plano: PlanoWasm) -> Bytes ::
  solta secao := bytes_novo()
  wasm_uleb(secao, U32(lista_tamanho(plano.campos)))
  para cada campo em plano.campos ::
    wasm_uleb(secao, campo.parametros)
  fecha
  devolve secao
fecha

campo wasm_secao_memoria() -> Bytes ::
  solta secao := bytes_novo()
  wasm_uleb(secao, 1)
  bytes_coloca_byte(secao, 0)
  wasm_uleb(secao, 1)
  devolve secao
fecha

campo wasm_secao_exports(plano: PlanoWasm) -> Bytes ::
  solta secao := bytes_novo()
  wasm_uleb(secao, U32(lista_tamanho(plano.campos)) + 1)

  wasm_texto(secao, "memory")
  bytes_coloca_byte(secao, 2)
  wasm_uleb(secao, 0)

  solta indice: U32 := 0
  para cada campo em plano.campos ::
    solta nome := "seven_" + campo.nome
    veja campo.nome == "inicio" :: vira nome := "seven_start" fecha
    wasm_texto(secao, nome)
    bytes_coloca_byte(secao, 0)
    wasm_uleb(secao, wasm_quantidade_imports() + indice)
    vira indice := indice + 1
  fecha
  devolve secao
fecha

campo wasm_secao_codigo(plano: PlanoWasm) -> Resultado<Bytes, Falha> ::
  solta secao := bytes_novo()
  wasm_uleb(secao, U32(lista_tamanho(plano.campos)))

  para cada campo em plano.campos ::
    guarda corpo := wasm_emite_campo(plano, campo)
    veja corpo e Falha :: devolve Falha(corpo.valor) fecha
    wasm_uleb(secao, U32(corpo.valor.tamanho))
    wasm_anexa(secao, corpo.valor)
  fecha

  devolve Valor(secao)
fecha

campo wasm_emite_campo(plano: PlanoWasm, campo: CampoIr) -> Resultado<Bytes, Falha> ::
  solta corpo := bytes_novo()
  guarda total_locais := U32(lista_tamanho(campo.locais))
  solta adicionais: U32 := 0
  veja total_locais > campo.parametros ::
    vira adicionais := total_locais - campo.parametros
  fecha

  veja adicionais == 0 ::
    wasm_uleb(corpo, 0)
  outro ::
    wasm_uleb(corpo, 1)
    wasm_uleb(corpo, adicionais)
    bytes_coloca_byte(corpo, 127)
  fecha

  guarda fluxo := wasm_emite_fluxo(corpo, plano, campo)
  veja fluxo e Falha :: devolve Falha(fluxo.valor) fecha

  bytes_coloca_byte(corpo, 65)
  wasm_sleb_positivo(corpo, 0)
  bytes_coloca_byte(corpo, 11)
  devolve Valor(corpo)
fecha

campo wasm_emite_fluxo(corpo: Bytes, plano: PlanoWasm, campo: CampoIr) -> Resultado<Nada, Falha> ::
  solta indice: U64 := 0

  gira indice < lista_tamanho(campo.blocos) ::
    guarda loop := wasm_tenta_loop(corpo, plano, campo, indice)
    veja loop e Falha :: devolve Falha(loop.valor) fecha
    veja loop.valor != indice ::
      vira indice := loop.valor
    outro ::
      guarda condicional := wasm_tenta_if(corpo, plano, campo, indice)
      veja condicional e Falha :: devolve Falha(condicional.valor) fecha
      veja condicional.valor != indice ::
        vira indice := condicional.valor
      outro ::
        guarda bloco := lista_pega(campo.blocos, indice)
        guarda emitido := wasm_emite_bloco_limite(corpo, plano, campo, bloco, lista_tamanho(bloco.instrucoes))
        veja emitido e Falha :: devolve Falha(emitido.valor) fecha
        vira indice := indice + 1
      fecha
    fecha
  fecha

  devolve Valor(nulo)
fecha

campo wasm_tenta_loop(corpo: Bytes, plano: PlanoWasm, campo: CampoIr, indice: U64) -> Resultado<U64, Falha> ::
  guarda bloco := lista_pega(campo.blocos, indice)
  guarda salto_condicao := wasm_salto_final(bloco)
  veja salto_condicao e Vazio ::
    devolve Valor(indice)
  fecha

  guarda indice_condicao := wasm_indice_bloco(campo, salto_condicao.valor)
  veja indice_condicao < 0 ::
    devolve Valor(indice)
  fecha

  guarda bloco_condicao := lista_pega(campo.blocos, U64(indice_condicao))
  guarda total_condicao := lista_tamanho(bloco_condicao.instrucoes)
  veja total_condicao < 2 ::
    devolve Valor(indice)
  fecha

  guarda penultima := lista_pega(bloco_condicao.instrucoes, total_condicao - 2)
  guarda ultima := lista_pega(bloco_condicao.instrucoes, total_condicao - 1)

  veja penultima e IrSaltaSeNao ::
    veja ultima e IrSalta ::
      guarda indice_corpo := wasm_indice_bloco(campo, ultima.bloco)
      guarda indice_fim := wasm_indice_bloco(campo, penultima.bloco)
      veja indice_corpo < 0 ou indice_fim < 0 ::
        devolve Valor(indice)
      fecha

      guarda emitido_setup := wasm_emite_bloco_limite(corpo, plano, campo, bloco, wasm_limite_sem_salto_final(bloco, salto_condicao.valor))
      veja emitido_setup e Falha :: devolve Falha(emitido_setup.valor) fecha

      bytes_coloca_byte(corpo, 2)
      bytes_coloca_byte(corpo, 64)
      bytes_coloca_byte(corpo, 3)
      bytes_coloca_byte(corpo, 64)

      guarda emitida_condicao := wasm_emite_bloco_limite(corpo, plano, campo, bloco_condicao, total_condicao - 2)
      veja emitida_condicao e Falha :: devolve Falha(emitida_condicao.valor) fecha
      wasm_local_pega(corpo, penultima.condicao)
      bytes_coloca_byte(corpo, 69)
      bytes_coloca_byte(corpo, 13)
      wasm_uleb(corpo, 1)

      guarda bloco_corpo := lista_pega(campo.blocos, U64(indice_corpo))
      guarda limite_corpo := wasm_limite_sem_salto_final(bloco_corpo, salto_condicao.valor)
      guarda emitido_corpo := wasm_emite_bloco_limite(corpo, plano, campo, bloco_corpo, limite_corpo)
      veja emitido_corpo e Falha :: devolve Falha(emitido_corpo.valor) fecha
      bytes_coloca_byte(corpo, 12)
      wasm_uleb(corpo, 0)

      bytes_coloca_byte(corpo, 11)
      bytes_coloca_byte(corpo, 11)

      devolve Valor(U64(indice_fim))
    fecha
  fecha

  devolve Valor(indice)
fecha

campo wasm_tenta_if(corpo: Bytes, plano: PlanoWasm, campo: CampoIr, indice: U64) -> Resultado<U64, Falha> ::
  guarda bloco := lista_pega(campo.blocos, indice)
  guarda total := lista_tamanho(bloco.instrucoes)
  veja total < 2 ::
    devolve Valor(indice)
  fecha

  guarda penultima := lista_pega(bloco.instrucoes, total - 2)
  guarda ultima := lista_pega(bloco.instrucoes, total - 1)

  veja penultima e IrSaltaSeNao ::
    veja ultima e IrSalta ::
      guarda indice_entao := wasm_indice_bloco(campo, ultima.bloco)
      guarda indice_senao := wasm_indice_bloco(campo, penultima.bloco)
      veja indice_entao < 0 ou indice_senao < 0 ::
        devolve Valor(indice)
      fecha

      guarda bloco_entao := lista_pega(campo.blocos, U64(indice_entao))
      guarda bloco_senao := lista_pega(campo.blocos, U64(indice_senao))
      guarda junta_entao := wasm_salto_final(bloco_entao)
      guarda junta_senao := wasm_salto_final(bloco_senao)
      solta junta := ""
      veja junta_entao e Algo :: vira junta := junta_entao.valor fecha
      veja junta == "" ::
        veja junta_senao e Algo :: vira junta := junta_senao.valor fecha
      fecha
      veja junta == "" ::
        devolve Valor(indice)
      fecha
      veja junta_entao e Algo ::
        veja junta_entao.valor != junta :: devolve Valor(indice) fecha
      fecha
      veja junta_senao e Algo ::
        veja junta_senao.valor != junta :: devolve Valor(indice) fecha
      fecha

      guarda indice_junta := wasm_indice_bloco(campo, junta)
      veja indice_junta < 0 ::
        devolve Valor(indice)
      fecha

      guarda emitido_prefixo := wasm_emite_bloco_limite(corpo, plano, campo, bloco, total - 2)
      veja emitido_prefixo e Falha :: devolve Falha(emitido_prefixo.valor) fecha
      wasm_local_pega(corpo, penultima.condicao)
      bytes_coloca_byte(corpo, 4)
      bytes_coloca_byte(corpo, 64)

      guarda emitido_entao := wasm_emite_bloco_limite(corpo, plano, campo, bloco_entao, wasm_limite_sem_salto_final(bloco_entao, junta))
      veja emitido_entao e Falha :: devolve Falha(emitido_entao.valor) fecha
      bytes_coloca_byte(corpo, 5)
      guarda emitido_senao := wasm_emite_bloco_limite(corpo, plano, campo, bloco_senao, wasm_limite_sem_salto_final(bloco_senao, junta))
      veja emitido_senao e Falha :: devolve Falha(emitido_senao.valor) fecha
      bytes_coloca_byte(corpo, 11)

      devolve Valor(U64(indice_junta))
    fecha
  fecha

  devolve Valor(indice)
fecha

campo wasm_emite_bloco_limite(
  corpo: Bytes,
  plano: PlanoWasm,
  campo: CampoIr,
  bloco: BlocoIr,
  limite: U64
) -> Resultado<Nada, Falha> ::
  solta indice: U64 := 0

  gira indice < limite ::
    guarda resultado := wasm_emite_instrucao(corpo, plano, campo, lista_pega(bloco.instrucoes, indice))
    veja resultado e Falha :: devolve Falha(resultado.valor) fecha
    vira indice := indice + 1
  fecha

  devolve Valor(nulo)
fecha

campo wasm_salto_unico(bloco: BlocoIr) -> Talvez<Texto> ::
  veja lista_tamanho(bloco.instrucoes) != 1 ::
    devolve Vazio
  fecha

  guarda instrucao := lista_pega(bloco.instrucoes, 0)
  veja instrucao e IrSalta ::
    devolve Algo(instrucao.bloco)
  fecha

  devolve Vazio
fecha

campo wasm_salto_final(bloco: BlocoIr) -> Talvez<Texto> ::
  veja lista_tamanho(bloco.instrucoes) == 0 ::
    devolve Vazio
  fecha

  guarda instrucao := lista_pega(bloco.instrucoes, lista_tamanho(bloco.instrucoes) - 1)
  veja instrucao e IrSalta ::
    devolve Algo(instrucao.bloco)
  fecha

  devolve Vazio
fecha

campo wasm_limite_sem_salto_final(bloco: BlocoIr, destino: Texto) -> U64 ::
  guarda salto := wasm_salto_final(bloco)
  veja salto e Algo ::
    veja salto.valor == destino ::
      devolve lista_tamanho(bloco.instrucoes) - 1
    fecha
  fecha

  devolve lista_tamanho(bloco.instrucoes)
fecha

campo wasm_indice_bloco(campo: CampoIr, nome: Texto) -> Num ::
  solta indice: U64 := 0
  gira indice < lista_tamanho(campo.blocos) ::
    veja lista_pega(campo.blocos, indice).nome == nome ::
      devolve Num(indice)
    fecha
    vira indice := indice + 1
  fecha

  devolve -1
fecha

campo wasm_emite_instrucao(
  corpo: Bytes,
  plano: PlanoWasm,
  campo: CampoIr,
  instrucao: InstrucaoIr
) -> Resultado<Nada, Falha> ::
  veja instrucao e IrConst ::
    bytes_coloca_byte(corpo, 65)
    veja instrucao.valor e ValorTexto ::
      guarda descritor := descritor_texto_wasm(plano, campo.nome, instrucao.destino)
      veja descritor e Falha :: devolve Falha(descritor.valor) fecha
      wasm_sleb_positivo(corpo, descritor.valor)
    fecha
    veja instrucao.valor e ValorNum :: wasm_sleb_positivo(corpo, U32(instrucao.valor.valor)) fecha
    veja instrucao.valor e ValorBit ::
      veja instrucao.valor.valor :: wasm_sleb_positivo(corpo, 1) outro :: wasm_sleb_positivo(corpo, 0) fecha
    fecha
    veja instrucao.valor e ValorNulo :: wasm_sleb_positivo(corpo, 0) fecha
    wasm_local_define(corpo, instrucao.destino)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrMove ::
    wasm_local_pega(corpo, instrucao.origem)
    wasm_local_define(corpo, instrucao.destino)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrBin ::
    veja instrucao.operador == "+" e wasm_operacao_texto(campo, instrucao.esquerda, instrucao.direita) ::
      wasm_local_pega(corpo, instrucao.esquerda)
      wasm_local_pega(corpo, instrucao.direita)
      guarda importado_texto := indice_import_wasm("sys_texto_concat", 2)
      veja importado_texto e Falha :: devolve Falha(importado_texto.valor) fecha
      bytes_coloca_byte(corpo, 16)
      wasm_uleb(corpo, importado_texto.valor)
      wasm_local_define(corpo, instrucao.destino)
      devolve Valor(nulo)
    fecha

    guarda opcode := wasm_opcode_binario(instrucao.operador)
    veja opcode == 0 ::
      devolve Falha(nova_falha("SV-WASM-OPERADOR", "operador nao suportado: " + instrucao.operador))
    fecha
    wasm_local_pega(corpo, instrucao.esquerda)
    wasm_local_pega(corpo, instrucao.direita)
    bytes_coloca_byte(corpo, opcode)
    wasm_local_define(corpo, instrucao.destino)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrChama ::
    para cada argumento em instrucao.argumentos :: wasm_local_pega(corpo, argumento) fecha
    solta indice: U32 := 0
    veja wasm_intrinseco(instrucao.campo) ::
      guarda importado := indice_import_wasm(instrucao.campo, U32(lista_tamanho(instrucao.argumentos)))
      veja importado e Falha :: devolve Falha(importado.valor) fecha
      vira indice := importado.valor
    outro ::
      guarda interno := indice_campo_wasm(plano, instrucao.campo)
      veja interno e Falha :: devolve Falha(interno.valor) fecha
      vira indice := interno.valor
    fecha
    bytes_coloca_byte(corpo, 16)
    wasm_uleb(corpo, indice)
    wasm_local_define(corpo, instrucao.destino)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrSyscall ::
    veja instrucao.nome == "sys_num_mod" ::
      veja lista_tamanho(instrucao.argumentos) != 2 ::
        devolve Falha(nova_falha("SV-WASM-ARIDADE", "mod exige dois argumentos"))
      fecha
      wasm_local_pega(corpo, lista_pega(instrucao.argumentos, 0))
      wasm_local_pega(corpo, lista_pega(instrucao.argumentos, 1))
      bytes_coloca_byte(corpo, 111)
      wasm_local_define(corpo, instrucao.destino)
      devolve Valor(nulo)
    fecha
    veja instrucao.nome == "sys_bit_nao" ::
      wasm_local_pega(corpo, lista_pega(instrucao.argumentos, 0))
      bytes_coloca_byte(corpo, 69)
      wasm_local_define(corpo, instrucao.destino)
      devolve Valor(nulo)
    fecha
    veja instrucao.nome == "sys_bit_e" ou instrucao.nome == "sys_bit_ou" ::
      wasm_local_pega(corpo, lista_pega(instrucao.argumentos, 0))
      wasm_local_pega(corpo, lista_pega(instrucao.argumentos, 1))
      veja instrucao.nome == "sys_bit_e" :: bytes_coloca_byte(corpo, 113) outro :: bytes_coloca_byte(corpo, 114) fecha
      wasm_local_define(corpo, instrucao.destino)
      devolve Valor(nulo)
    fecha

    guarda importado := indice_import_wasm(instrucao.nome, U32(lista_tamanho(instrucao.argumentos)))
    veja importado e Falha :: devolve Falha(importado.valor) fecha
    para cada argumento em instrucao.argumentos :: wasm_local_pega(corpo, argumento) fecha
    bytes_coloca_byte(corpo, 16)
    wasm_uleb(corpo, importado.valor)
    wasm_local_define(corpo, instrucao.destino)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrRetorna ::
    wasm_local_pega(corpo, instrucao.origem)
    bytes_coloca_byte(corpo, 15)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrPare ::
    bytes_coloca_byte(corpo, 65)
    wasm_sleb_positivo(corpo, 0)
    bytes_coloca_byte(corpo, 15)
    devolve Valor(nulo)
  fecha

  veja instrucao e IrSalta ::
    devolve Falha(nova_falha("SV-WASM-CONTROLE", "saltos exigem o backend estruturado da proxima etapa"))
  fecha
  veja instrucao e IrSaltaSeNao ::
    devolve Falha(nova_falha("SV-WASM-CONTROLE", "condicionais exigem o backend estruturado da proxima etapa"))
  fecha
  veja instrucao e IrCaixa ::
    devolve Falha(nova_falha("SV-WASM-MEMORIA", "alocacao dinamica ainda nao esta habilitada no navegador"))
  fecha
  veja instrucao e IrMarcaByte ::
    devolve Falha(nova_falha("SV-WASM-MEMORIA", "escrita direta de memoria ainda nao esta habilitada"))
  fecha
  veja instrucao e IrPegaByte ::
    devolve Falha(nova_falha("SV-WASM-MEMORIA", "leitura direta de memoria ainda nao esta habilitada"))
  fecha

  devolve Falha(nova_falha("SV-WASM-INSTRUCAO", "instrucao IR nao suportada pelo alvo web"))
fecha

campo wasm_operacao_texto(campo: CampoIr, esquerda: U32, direita: U32) -> Bit ::
  devolve wasm_local_texto(campo, esquerda) ou wasm_local_texto(campo, direita)
fecha

campo wasm_local_texto(campo: CampoIr, local: U32) -> Bit ::
  veja U64(local) >= lista_tamanho(campo.locais) ::
    devolve nao
  fecha

  guarda tipo := lista_pega(campo.locais, U64(local))
  veja tipo e TipoBase ::
    devolve tipo.nome == "Texto"
  fecha

  devolve nao
fecha

campo wasm_opcode_binario(operador: Texto) -> Byte ::
  veja operador == "+" :: devolve 106 fecha
  veja operador == "-" :: devolve 107 fecha
  veja operador == "*" :: devolve 108 fecha
  veja operador == "/" :: devolve 109 fecha
  veja operador == "==" :: devolve 70 fecha
  veja operador == "!=" :: devolve 71 fecha
  veja operador == "<" :: devolve 72 fecha
  veja operador == ">" :: devolve 74 fecha
  veja operador == "<=" :: devolve 76 fecha
  veja operador == ">=" :: devolve 78 fecha
  devolve 0
fecha

campo wasm_local_pega(corpo: Bytes, local: U32) -> Nada ::
  bytes_coloca_byte(corpo, 32)
  wasm_uleb(corpo, local)
fecha

campo wasm_local_define(corpo: Bytes, local: U32) -> Nada ::
  bytes_coloca_byte(corpo, 33)
  wasm_uleb(corpo, local)
fecha

campo wasm_secao_dados(plano: PlanoWasm) -> Bytes ::
  solta secao := bytes_novo()
  wasm_uleb(secao, 1)
  wasm_uleb(secao, 0)
  bytes_coloca_byte(secao, 65)
  wasm_sleb_positivo(secao, WasmDadosInicio)
  bytes_coloca_byte(secao, 11)
  wasm_uleb(secao, U32(plano.dados.tamanho))
  wasm_anexa(secao, plano.dados)
  devolve secao
fecha

campo wasm_secao(destino: Bytes, identificador: Byte, conteudo: Bytes) -> Nada ::
  bytes_coloca_byte(destino, identificador)
  wasm_uleb(destino, U32(conteudo.tamanho))
  wasm_anexa(destino, conteudo)
fecha

campo wasm_texto(destino: Bytes, texto: Texto) -> Nada ::
  guarda dados := texto_bytes(texto)
  wasm_uleb(destino, U32(dados.tamanho))
  wasm_anexa(destino, dados)
fecha

campo wasm_u32_le(destino: Bytes, valor: U32) -> Nada ::
  bytes_coloca_byte(destino, Byte(valor % 256))
  bytes_coloca_byte(destino, Byte((valor / 256) % 256))
  bytes_coloca_byte(destino, Byte((valor / 65536) % 256))
  bytes_coloca_byte(destino, Byte((valor / 16777216) % 256))
fecha

campo wasm_uleb(destino: Bytes, valor: U32) -> Nada ::
  solta restante := valor
  gira restante >= 128 ::
    bytes_coloca_byte(destino, Byte((restante % 128) + 128))
    vira restante := restante / 128
  fecha
  bytes_coloca_byte(destino, Byte(restante))
fecha

campo wasm_sleb_positivo(destino: Bytes, valor: U32) -> Nada ::
  solta restante := valor
  gira restante >= 64 ::
    bytes_coloca_byte(destino, Byte((restante % 128) + 128))
    vira restante := restante / 128
  fecha
  bytes_coloca_byte(destino, Byte(restante))
fecha

campo wasm_anexa(destino: Bytes, origem: Bytes) -> Nada ::
  solta indice: U64 := 0
  gira indice < origem.tamanho ::
    bytes_coloca_byte(destino, bytes_pega(origem, indice))
    vira indice := indice + 1
  fecha
fecha
