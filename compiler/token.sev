modulo seven.compiler.token

usa seven.compiler.source
usa seven.compiler.diagnostic

selo TokenTipo ::
  Nome
  Numero
  TextoLit
  Palavra
  Sinal
  Invalido
  Fim
fecha

molde Token ::
  tipo: TokenTipo
  marca: Texto
  literal: Texto
  span: Span
fecha

molde FluxoTokens ::
  fonte: Fonte
  tokens: Lista<Token>
  diagnosticos: Lista<Diagnostico>
fecha

campo token(tipo: TokenTipo, marca: Texto, literal: Texto, span: Span) -> Token ::
  devolve Token {
    tipo: tipo,
    marca: marca,
    literal: literal,
    span: span
  }
fecha

campo token_simples(tipo: TokenTipo, marca: Texto, span: Span) -> Token ::
  devolve token(tipo, marca, marca, span)
fecha

campo token_fim(span: Span) -> Token ::
  devolve token(Fim, "", "", span)
fecha

campo token_e(valor: Token, marca: Texto) -> Bit ::
  devolve valor.marca == marca
fecha

campo token_marca_letra(caractere: Texto) -> Bit ::
  devolve (caractere >= "a" e caractere <= "z") ou (caractere >= "A" e caractere <= "Z") ou caractere == "_"
fecha

campo token_marca_digito(caractere: Texto) -> Bit ::
  devolve caractere >= "0" e caractere <= "9"
fecha

campo token_marca_reservada(marca: Texto) -> Bit ::
  devolve marca == "modulo" ou marca == "usa" ou marca == "como" ou marca == "campo" ou marca == "extern" ou marca == "molde" ou marca == "selo" ou marca == "const" ou marca == "guarda" ou marca == "solta" ou marca == "vira" ou marca == "diga" ou marca == "veja" ou marca == "outro" ou marca == "gira" ou marca == "para" ou marca == "cada" ou marca == "em" ou marca == "devolve" ou marca == "caixa" ou marca == "marca" ou marca == "pega" ou marca == "zona" ou marca == "falha" ou marca == "fecha" ou marca == "toca" ou marca == "requer" ou marca == "liga" ou marca == "sim" ou marca == "nao" ou marca == "nulo" ou marca == "e" ou marca == "ou"
fecha

campo token_marca_nome(marca: Texto) -> Bit ::
  guarda total := sys_texto_tamanho(marca)
  veja total == 0 ou token_marca_reservada(marca) ou nao token_marca_letra(sys_texto_caractere(marca, 0)) :: devolve nao fecha
  solta indice: U64 := 1
  gira indice < total ::
    guarda caractere := sys_texto_caractere(marca, indice)
    veja nao token_marca_letra(caractere) e nao token_marca_digito(caractere) :: devolve nao fecha
    vira indice := indice + 1
  fecha
  devolve sim
fecha

campo token_marca_numero(marca: Texto) -> Bit ::
  devolve sys_texto_tamanho(marca) > 0 e token_marca_digito(sys_texto_caractere(marca, 0))
fecha

campo token_marca_texto(marca: Texto) -> Bit ::
  devolve sys_texto_tamanho(marca) >= 2 e sys_texto_caractere(marca, 0) == "\""
fecha

campo token_nome(valor: Token) -> Bit ::
  devolve valor.tipo == Nome
fecha

campo token_palavra(valor: Token) -> Bit ::
  devolve valor.tipo == Palavra
fecha

campo token_numero(valor: Token) -> Bit ::
  devolve valor.tipo == Numero
fecha

campo token_texto(valor: Token) -> Bit ::
  devolve valor.tipo == TextoLit
fecha

campo token_final(valor: Token) -> Bit ::
  devolve valor.tipo == Fim
fecha

campo fluxo_tem_erros(fluxo: FluxoTokens) -> Bit ::
  devolve diagnosticos_tem_erros(fluxo.diagnosticos)
fecha
