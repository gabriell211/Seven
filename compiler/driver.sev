modulo seven.compiler.driver

usa seven.compiler.source
usa seven.compiler.lexer
usa seven.compiler.parser
usa seven.compiler.symbols
usa seven.compiler.types
usa seven.compiler.effects
usa seven.compiler.semantic
usa seven.compiler.ir
usa seven.compiler.bytecode
usa seven.compiler.diagnostic
usa seven.compiler.package
usa std.fs.file
usa std.io.console

molde PedidoCompilacao ::
  pacote: Pacote
  entrada: Texto
  alvo: Texto
  modo: Texto
  saida: Texto
fecha

selo SaidaCompilacao ::
  Sucesso(caminho: Texto)
  Falhou(diagnosticos: Lista<Diagnostico>)
fecha

campo pedido_de_compilacao(argumentos: Lista<Texto>) -> PedidoCompilacao toca ambiente, disco ::
  guarda manifesto := argumento_compilacao(argumentos, 0, "seven.pkg")
  guarda saida := argumento_compilacao(argumentos, 1, "")
  guarda pacote := pacote_carrega(manifesto)

  devolve PedidoCompilacao {
    pacote: pacote,
    entrada: pacote.entrada,
    alvo: pacote.alvo,
    modo: "seguro",
    saida: saida
  }
fecha

campo argumento_compilacao(argumentos: Lista<Texto>, indice: U64, padrao: Texto) -> Texto ::
  veja lista_tamanho(argumentos) <= indice ::
    devolve padrao
  fecha

  devolve lista_pega(argumentos, indice)
fecha

campo compila(pedido: PedidoCompilacao) -> SaidaCompilacao toca disco ::
  guarda fontes := fonte_carrega_pacote(pedido.pacote)
  guarda tokens := varre_unidade(fontes)
  guarda sintaxe := monta_unidade(tokens)

  veja diagnosticos_tem_erros(sintaxe.diagnosticos) ::
    devolve Falhou(sintaxe.diagnosticos)
  fecha

  guarda semantica := mede(sintaxe.programas, pedido.pacote)
  guarda diagnosticos := junta_diagnosticos(sintaxe.diagnosticos, semantica)

  veja diagnosticos_tem_erros(diagnosticos) ::
    devolve Falhou(diagnosticos)
  fecha

  guarda meio := baixa_ir(sintaxe.programas, semantica.tipos, semantica.efeitos)
  guarda otimizado := otimiza_ir(meio, pedido.modo)
  guarda imagem := emite_svbc(otimizado)
  guarda caminho := caminho_saida(pedido)
  guarda gravacao := arquivo_salva_bytes(caminho, imagem)

  veja gravacao e Falha ::
    lista_coloca(diagnosticos, erro(
      gravacao.valor.codigo,
      gravacao.valor.mensagem,
      caminho,
      1,
      1
    ))
    devolve Falhou(diagnosticos)
  fecha

  devolve Sucesso(caminho)
fecha

campo caminho_saida(pedido: PedidoCompilacao) -> Texto ::
  veja pedido.saida != "" ::
    devolve pedido.saida
  fecha

  devolve "build/" + pedido.pacote.nome + ".svbc"
fecha

campo junta_diagnosticos(
  frontend: Lista<Diagnostico>,
  semantica: UnidadeSemantica
) -> Lista<Diagnostico> ::
  solta saida := lista<Diagnostico>()

  lista_junta(saida, frontend)
  lista_junta(saida, semantica.simbolos.diagnosticos)
  lista_junta(saida, semantica.tipos.diagnosticos)
  lista_junta(saida, semantica.efeitos.diagnosticos)
  lista_junta(saida, semantica.memoria.diagnosticos)
  lista_junta(saida, semantica.ffi.diagnosticos)

  devolve saida
fecha

campo mostra_diagnosticos(diagnosticos: Lista<Diagnostico>) -> Nada toca terminal ::
  para cada diag em diagnosticos ::
    diga formatar_diagnostico(diag)
  fecha
fecha
