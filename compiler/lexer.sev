modulo seven.compiler.lexer

usa seven.compiler.source
usa seven.compiler.token
usa seven.compiler.diagnostic

molde EstadoVarredura ::
  fonte: Fonte
  cursor: U64
  linha: U32
  coluna: U32
  tokens: Lista<Token>
  diagnosticos: BolsaDiagnosticos
fecha

campo varre_unidade(unidade: UnidadeFonte) -> Lista<FluxoTokens> ::
  solta saida := lista<FluxoTokens>()
  para cada fonte em unidade.arquivos ::
    lista_coloca(saida, varre(fonte))
  fecha
  devolve saida
fecha

campo varre(fonte: Fonte) -> FluxoTokens ::
  solta estado := EstadoVarredura {
    fonte: fonte,
    cursor: 0,
    linha: 1,
    coluna: 1,
    tokens: lista<Token>(),
    diagnosticos: bolsa_diagnosticos(100)
  }

  gira nao varredura_fim(estado) e nao estado.diagnosticos.interrompida ::
    guarda c := atual(estado)

    veja branco(c) ::
      le_branco(estado)
    outro ::
      veja c == "/" e olha(estado, 1) == "/" ::
        le_comentario_linha(estado)
      outro ::
        veja c == "/" e olha(estado, 1) == "*" ::
          le_comentario_bloco(estado)
        outro ::
          veja letra(c) ou c == "_" ::
            le_nome(estado)
          outro ::
            veja digito(c) ::
              le_numero(estado)
            outro ::
              veja c == "\"" ::
                le_texto(estado)
              outro ::
                le_sinal(estado)
              fecha
            fecha
          fecha
        fecha
      fecha
    fecha
  fecha

  guarda local_fim := span_atual(estado, estado.cursor, estado.linha, estado.coluna)
  lista_coloca(estado.tokens, token_fim(local_fim))

  devolve FluxoTokens {
    fonte: fonte,
    tokens: estado.tokens,
    diagnosticos: estado.diagnosticos.itens
  }
fecha

campo varredura_fim(estado: EstadoVarredura) -> Bit ::
  devolve estado.cursor >= sys_texto_tamanho(estado.fonte.texto)
fecha

campo olha(estado: EstadoVarredura, deslocamento: U64) -> Texto ::
  guarda pos := estado.cursor + deslocamento
  veja pos >= sys_texto_tamanho(estado.fonte.texto) ::
    devolve "\0"
  fecha
  devolve sys_texto_caractere(estado.fonte.texto, pos)
fecha

campo atual(estado: EstadoVarredura) -> Texto ::
  devolve olha(estado, 0)
fecha

campo avanca(estado: EstadoVarredura) -> Texto ::
  veja varredura_fim(estado) ::
    devolve "\0"
  fecha

  guarda c := atual(estado)
  vira estado.cursor := estado.cursor + 1

  veja c == "\n" ::
    vira estado.linha := estado.linha + 1
    vira estado.coluna := 1
  outro ::
    vira estado.coluna := estado.coluna + 1
  fecha

  devolve c
fecha

campo span_atual(estado: EstadoVarredura, inicio: U64, linha: U32, coluna: U32) -> Span ::
  devolve Span {
    arquivo: estado.fonte.caminho,
    inicio: inicio,
    fim: estado.cursor,
    linha: linha,
    coluna: coluna
  }
fecha

campo fatia(estado: EstadoVarredura, inicio: U64) -> Texto ::
  devolve sys_texto_fatia(estado.fonte.texto, inicio, estado.cursor)
fecha

campo publica(
  estado: EstadoVarredura,
  tipo: TokenTipo,
  marca: Texto,
  literal: Texto,
  inicio: U64,
  linha: U32,
  coluna: U32
) -> Nada ::
  lista_coloca(estado.tokens, token(tipo, marca, literal, span_atual(estado, inicio, linha, coluna)))
fecha

campo le_branco(estado: EstadoVarredura) -> Nada ::
  gira branco(atual(estado)) ::
    avanca(estado)
  fecha
fecha

campo le_comentario_linha(estado: EstadoVarredura) -> Nada ::
  avanca(estado)
  avanca(estado)
  gira nao varredura_fim(estado) e atual(estado) != "\n" ::
    avanca(estado)
  fecha
fecha

campo le_comentario_bloco(estado: EstadoVarredura) -> Nada ::
  guarda inicio := estado.cursor
  guarda linha := estado.linha
  guarda coluna := estado.coluna
  solta profundidade: U32 := 1
  avanca(estado)
  avanca(estado)

  gira nao varredura_fim(estado) e profundidade > 0 ::
    veja atual(estado) == "/" e olha(estado, 1) == "*" ::
      vira profundidade := profundidade + 1
      avanca(estado)
      avanca(estado)
    outro ::
      veja atual(estado) == "*" e olha(estado, 1) == "/" ::
        vira profundidade := profundidade - 1
        avanca(estado)
        avanca(estado)
      outro ::
        avanca(estado)
      fecha
    fecha
  fecha

  veja profundidade > 0 ::
    diagnosticos_adiciona(estado.diagnosticos, erro_com_ajuda(
      "SV-LEX-COMENTARIO",
      "comentario de bloco nao foi fechado",
      estado.fonte.caminho,
      linha,
      coluna,
      "adicione */ antes do fim do arquivo"
    ))
    publica(estado, Invalido, fatia(estado, inicio), "", inicio, linha, coluna)
  fecha
fecha

campo le_nome(estado: EstadoVarredura) -> Nada ::
  guarda inicio := estado.cursor
  guarda linha := estado.linha
  guarda coluna := estado.coluna

  gira letra(atual(estado)) ou digito(atual(estado)) ou atual(estado) == "_" ::
    avanca(estado)
  fecha

  guarda marca := fatia(estado, inicio)
  solta tipo := Nome
  veja palavra_reservada(marca) ::
    vira tipo := Palavra
  fecha
  publica(estado, tipo, marca, marca, inicio, linha, coluna)
fecha

campo le_numero(estado: EstadoVarredura) -> Nada ::
  guarda inicio := estado.cursor
  guarda linha := estado.linha
  guarda coluna := estado.coluna

  veja atual(estado) == "0" e (olha(estado, 1) == "x" ou olha(estado, 1) == "X") ::
    avanca(estado)
    avanca(estado)
    guarda digitos := estado.cursor
    gira hexadecimal(atual(estado)) ou atual(estado) == "_" ::
      avanca(estado)
    fecha
    veja estado.cursor == digitos ::
      reporta_lex(estado, "SV-LEX-HEX", "literal hexadecimal sem digitos", linha, coluna)
    fecha
    guarda marca_hex := fatia(estado, inicio)
    publica(estado, Numero, marca_hex, marca_hex, inicio, linha, coluna)
    devolve nulo
  fecha

  veja atual(estado) == "0" e (olha(estado, 1) == "b" ou olha(estado, 1) == "B") ::
    avanca(estado)
    avanca(estado)
    guarda digitos := estado.cursor
    gira binario(atual(estado)) ou atual(estado) == "_" ::
      avanca(estado)
    fecha
    veja estado.cursor == digitos ::
      reporta_lex(estado, "SV-LEX-BINARIO", "literal binario sem digitos", linha, coluna)
    fecha
    guarda marca_binaria := fatia(estado, inicio)
    publica(estado, Numero, marca_binaria, marca_binaria, inicio, linha, coluna)
    devolve nulo
  fecha

  gira digito(atual(estado)) ou atual(estado) == "_" ::
    avanca(estado)
  fecha

  veja atual(estado) == "." e digito(olha(estado, 1)) ::
    avanca(estado)
    gira digito(atual(estado)) ou atual(estado) == "_" ::
      avanca(estado)
    fecha
  fecha

  veja atual(estado) == "e" ou atual(estado) == "E" ::
    avanca(estado)
    veja atual(estado) == "+" ou atual(estado) == "-" ::
      avanca(estado)
    fecha
    veja nao digito(atual(estado)) ::
      reporta_lex(estado, "SV-LEX-EXPOENTE", "expoente numerico incompleto", estado.linha, estado.coluna)
    fecha
    gira digito(atual(estado)) ou atual(estado) == "_" ::
      avanca(estado)
    fecha
  fecha

  guarda marca := fatia(estado, inicio)
  publica(estado, Numero, marca, marca, inicio, linha, coluna)
fecha

campo le_texto(estado: EstadoVarredura) -> Nada ::
  guarda inicio := estado.cursor
  guarda linha := estado.linha
  guarda coluna := estado.coluna
  solta fechado := nao
  avanca(estado)

  gira nao varredura_fim(estado) e nao fechado ::
    veja atual(estado) == "\"" ::
      avanca(estado)
      vira fechado := sim
    outro ::
      veja atual(estado) == "\\" ::
        avanca(estado)
        veja varredura_fim(estado) ::
          reporta_lex(estado, "SV-LEX-ESCAPE", "sequencia de escape incompleta", estado.linha, estado.coluna)
        outro ::
          veja nao escape_valido(atual(estado)) ::
            lista_coloca(estado.diagnosticos.itens, aviso(
              "SV-LEX-ESCAPE-DESCONHECIDO",
              "sequencia de escape desconhecida",
              estado.fonte.caminho,
              estado.linha,
              estado.coluna
            ))
          fecha
          avanca(estado)
        fecha
      outro ::
        veja atual(estado) == "\n" ::
          reporta_lex(estado, "SV-LEX-TEXTO-LINHA", "texto foi quebrado antes de fechar aspas", linha, coluna)
          vira fechado := sim
        outro ::
          avanca(estado)
        fecha
      fecha
    fecha
  fecha

  guarda marca := fatia(estado, inicio)
  veja nao fechado ou marca == "\"" ::
    reporta_lex(estado, "SV-LEX-TEXTO", "literal de texto nao foi fechado", linha, coluna)
    publica(estado, Invalido, marca, "", inicio, linha, coluna)
  outro ::
    guarda literal := sys_texto_fatia(marca, 1, sys_texto_tamanho(marca) - 1)
    publica(estado, TextoLit, marca, literal, inicio, linha, coluna)
  fecha
fecha

campo le_sinal(estado: EstadoVarredura) -> Nada ::
  guarda inicio := estado.cursor
  guarda linha := estado.linha
  guarda coluna := estado.coluna
  guarda primeiro := avanca(estado)
  guarda duplo := primeiro + atual(estado)

  veja sinal_duplo(duplo) ::
    avanca(estado)
    publica(estado, Sinal, duplo, duplo, inicio, linha, coluna)
    devolve nulo
  fecha

  veja sinal_simples(primeiro) ::
    publica(estado, Sinal, primeiro, primeiro, inicio, linha, coluna)
    devolve nulo
  fecha

  reporta_lex(estado, "SV-LEX-CARACTERE", "caractere nao pertence a linguagem Seven", linha, coluna)
  publica(estado, Invalido, primeiro, primeiro, inicio, linha, coluna)
fecha

campo reporta_lex(estado: EstadoVarredura, codigo: Texto, mensagem: Texto, linha: U32, coluna: U32) -> Nada ::
  diagnosticos_adiciona(estado.diagnosticos, erro(codigo, mensagem, estado.fonte.caminho, linha, coluna))
fecha

campo branco(c: Texto) -> Bit ::
  devolve c == " " ou c == "\t" ou c == "\n" ou c == "\r"
fecha

campo letra(c: Texto) -> Bit ::
  devolve (c >= "a" e c <= "z") ou (c >= "A" e c <= "Z")
fecha

campo digito(c: Texto) -> Bit ::
  devolve c >= "0" e c <= "9"
fecha

campo hexadecimal(c: Texto) -> Bit ::
  devolve digito(c) ou (c >= "a" e c <= "f") ou (c >= "A" e c <= "F")
fecha

campo binario(c: Texto) -> Bit ::
  devolve c == "0" ou c == "1"
fecha

campo escape_valido(c: Texto) -> Bit ::
  devolve c == "n" ou c == "r" ou c == "t" ou c == "0" ou c == "\\" ou c == "\"" ou c == "u"
fecha

campo sinal_duplo(valor: Texto) -> Bit ::
  devolve valor == ":=" ou valor == "::" ou valor == "->" ou valor == "==" ou valor == "!=" ou valor == "<=" ou valor == ">="
fecha

campo sinal_simples(valor: Texto) -> Bit ::
  devolve valor == "+" ou valor == "-" ou valor == "*" ou valor == "/" ou valor == "%" ou valor == "<" ou valor == ">" ou valor == "=" ou valor == "@" ou valor == "." ou valor == "," ou valor == ":" ou valor == "(" ou valor == ")" ou valor == "[" ou valor == "]" ou valor == "{" ou valor == "}"
fecha

campo palavra_reservada(valor: Texto) -> Bit ::
  devolve valor == "modulo" ou valor == "usa" ou valor == "como" ou valor == "campo" ou valor == "extern" ou valor == "molde" ou valor == "selo" ou valor == "const" ou valor == "guarda" ou valor == "solta" ou valor == "vira" ou valor == "diga" ou valor == "veja" ou valor == "outro" ou valor == "gira" ou valor == "para" ou valor == "cada" ou valor == "em" ou valor == "devolve" ou valor == "caixa" ou valor == "marca" ou valor == "pega" ou valor == "zona" ou valor == "falha" ou valor == "fecha" ou valor == "toca" ou valor == "requer" ou valor == "liga" ou valor == "sim" ou valor == "nao" ou valor == "nulo" ou valor == "e" ou valor == "ou"
fecha
