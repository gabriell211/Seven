modulo examples.frontend_counter.styles

campo counter_styles() -> Texto ::
  devolve ":root{" +
    "--cor-fundo:#0f172a;" +
    "--cor-painel:#111827;" +
    "--cor-texto:#f8fafc;" +
    "--cor-acao:#22c55e;" +
    "--raio:8px;" +
    "}" +
    "body{" +
    "margin:0;" +
    "font-family:Inter,system-ui,sans-serif;" +
    "background:var(--cor-fundo);" +
    "color:var(--cor-texto);" +
    "}" +
    ".counter-shell{" +
    "min-height:100vh;" +
    "display:grid;" +
    "place-items:center;" +
    "padding:24px;" +
    "}" +
    ".counter-panel{" +
    "width:min(420px,100%);" +
    "border:1px solid rgba(148,163,184,.24);" +
    "border-radius:var(--raio);" +
    "background:var(--cor-painel);" +
    "padding:24px;" +
    "box-shadow:0 24px 80px rgba(0,0,0,.35);" +
    "}" +
    ".eyebrow{" +
    "margin:0 0 8px;" +
    "color:var(--cor-acao);" +
    "font-size:12px;" +
    "text-transform:uppercase;" +
    "}" +
    ".counter-value{" +
    "font-size:64px;" +
    "font-weight:800;" +
    "margin:24px 0;" +
    "}" +
    ".primary-button{" +
    "width:100%;" +
    "height:44px;" +
    "border:0;" +
    "border-radius:var(--raio);" +
    "background:var(--cor-acao);" +
    "color:#052e16;" +
    "font-weight:700;" +
    "cursor:pointer;" +
    "}" +
    "@media (max-width:520px){.counter-panel{padding:18px;}}"
fecha
