modulo examples.web_dev

usa std.frontend.intrinsics

campo inicio() -> Num toca frontend, rede ::
  frontend_injeta_css(estilos())
  frontend_monta("#seven-app", tela())
  frontend_escuta("#nome", "input", "atualiza_nome")
  frontend_escuta("#salvar", "click", "salva_estado")
  frontend_escuta("#manifesto", "click", "carrega_manifesto")
  devolve 0
fecha

campo atualiza_nome() -> Num toca frontend ::
  guarda nome := frontend_evento_valor()
  frontend_texto("#preview", "Ola, " + nome)
  devolve 0
fecha

campo salva_estado() -> Num toca frontend ::
  guarda nome := frontend_evento_valor()
  frontend_armazena("seven-web-dev:nome", nome)
  frontend_texto("#status", "Estado salvo no navegador.")
  devolve 0
fecha

campo carrega_manifesto() -> Num toca frontend, rede ::
  frontend_fetch_texto("./seven.web.json", "recebe_manifesto")
  devolve 0
fecha

campo recebe_manifesto() -> Num toca frontend, rede ::
  guarda resposta := frontend_resposta_texto()
  frontend_texto("#status", resposta)
  devolve frontend_resposta_status()
fecha

campo tela() -> Texto ::
  devolve
    "<section class='shell'>" +
    "  <p class='eyebrow'>Seven Web Dev</p>" +
    "  <h1>Desenvolva interfaces em <span>.sev</span></h1>" +
    "  <p class='lead'>Este starter usa somente fonte Seven. Compile com <code>seven web build</code> e abra o diretorio gerado em um servidor estatico local.</p>" +
    "  <div class='panel'>" +
    "    <label for='nome'>Nome para testar evento</label>" +
    "    <input id='nome' placeholder='Digite algo...' autocomplete='off'>" +
    "    <p id='preview'>Ola, Seven</p>" +
    "    <div class='actions'>" +
    "      <button id='salvar'>Salvar estado</button>" +
    "      <button id='manifesto' class='secondary'>Ler manifesto</button>" +
    "    </div>" +
    "    <pre id='status'>Pronto para desenvolver.</pre>" +
    "  </div>" +
    "  <footer>.sev -> WebAssembly -> Browser</footer>" +
    "</section>"
fecha

campo estilos() -> Texto ::
  devolve
    ":root{color-scheme:dark;--bg:#070a12;--panel:#101827;--line:#263244;--text:#f8fafc;--muted:#9aa8ba;--accent:#7ee787;--blue:#58a6ff}" +
    "*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% 0%,rgba(88,166,255,.16),transparent 34rem),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,Segoe UI,sans-serif}" +
    ".shell{width:min(880px,calc(100% - 32px));margin:0 auto;padding:72px 0}.eyebrow{color:var(--accent);font:700 12px ui-monospace,Consolas,monospace;text-transform:uppercase;letter-spacing:.16em}" +
    "h1{font-size:clamp(42px,7vw,78px);line-height:1;margin:16px 0 22px;letter-spacing:-.06em}h1 span{color:var(--accent)}.lead{max-width:680px;color:var(--muted);font-size:18px;line-height:1.7}.lead code{color:var(--blue)}" +
    ".panel{margin-top:36px;padding:28px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.015));box-shadow:0 30px 90px rgba(0,0,0,.32)}" +
    "label{display:block;margin-bottom:10px;color:var(--muted);font-size:14px}input{width:100%;height:52px;border:1px solid #334155;border-radius:14px;background:#080d16;color:var(--text);font:inherit;padding:0 16px;outline:none}input:focus{border-color:var(--blue);box-shadow:0 0 0 4px rgba(88,166,255,.12)}" +
    "#preview{font-size:28px;font-weight:800;margin:24px 0}.actions{display:flex;gap:12px;flex-wrap:wrap}button{border:0;border-radius:13px;background:var(--accent);color:#06210f;font-weight:800;padding:13px 18px;cursor:pointer}.secondary{background:#172033;color:var(--text);border:1px solid var(--line)}" +
    "pre{white-space:pre-wrap;margin:22px 0 0;padding:16px;border-radius:14px;background:#080d16;color:#b7c4d4;min-height:72px;overflow:auto}footer{margin-top:26px;color:#66758a;font:12px ui-monospace,Consolas,monospace}@media(max-width:560px){.shell{padding:46px 0}.panel{padding:20px}h1{font-size:42px}}"
fecha
