modulo seven0.token

usa seven0.primitives

molde Token ::
  tipo: Texto
  marca: Texto
  linha: U32
  coluna: U32
fecha

molde Fluxo ::
  fonte: Texto
  tokens: ListaToken
fecha

campo token(tipo: Texto, marca: Texto, linha: U32, coluna: U32) -> Token ::
  devolve Token {
    tipo: tipo,
    marca: marca,
    linha: linha,
    coluna: coluna
  }
fecha

campo lista_token_coloca(itens: ListaToken, valor: Token) -> Nada ::
  sys_lista_coloca(itens, valor)
fecha

campo lista_token_pega(itens: ListaToken, indice: U64) -> Token ::
  devolve sys_lista_pega(itens, indice)
fecha

campo lista_token_tamanho(itens: ListaToken) -> U64 ::
  devolve itens.tamanho
fecha
