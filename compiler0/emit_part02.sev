modulo seven0.emit

usa std.base.lista
usa seven0.primitives
usa seven0.ast
usa seven0.check
usa seven0.svbc0

campo emite_chamada(contexto: ContextoCampo, expr: No) -> Nada ::
  veja chamada_lista(expr.nome) ::
    emite_lista_nova(contexto)
    devolve nulo
  fecha

  veja chamada_numerica(expr.nome) ::
    veja lista_no_tamanho(expr.filhos) > 0 ::
      emite_expressao(contexto, lista_no_pega(expr.filhos, 0))
    outro ::
      emite_const_u32(contexto, 0)
    fecha
    emite_syscall(contexto, "sys_num_cast", 1)
    devolve nulo
  fecha

  guarda campo := campo_interno_indice(contexto.emissao.unidade.programa, expr.nome)
  veja campo >= 0 ::
    para cada argumento em expr.filhos :: emite_expressao(contexto, argumento) fecha
    emite_instrucao(contexto.emissao, OpChama, U32(campo), U32(lista_no_tamanho(expr.filhos)))
    devolve nulo
  fecha

  veja nome_maiusculo(expr.nome) ::
    emite_variante(contexto, expr)
    devolve nulo
  fecha

  para cada argumento em expr.filhos :: emite_expressao(contexto, argumento) fecha
  emite_syscall(contexto, expr.nome, U32(lista_no_tamanho(expr.filhos)))
fecha

campo emite_variante(contexto: ContextoCampo, expr: No) -> Nada ::
  emite_const_texto(contexto, "__tipo")
  emite_const_texto(contexto, expr.nome)
  emite_const_texto(contexto, "tag")
  emite_const_texto(contexto, expr.nome)
  solta argumentos: U32 := 4
  solta indice: U64 := 0
  guarda declaracao := variante_por_nome(contexto.emissao.unidade.programa, expr.nome)

  para cada valor em expr.filhos ::
    solta campo := ""
    veja declaracao.especie == "variante" e indice < lista_no_tamanho(declaracao.filhos) ::
      vira campo := lista_no_pega(declaracao.filhos, indice).nome
    fecha
    veja campo == "" e lista_no_tamanho(expr.filhos) == 1 :: vira campo := "valor" fecha
    veja campo == "" :: vira campo := texto_u64(indice) fecha

    emite_const_texto(contexto, campo)
    emite_expressao(contexto, valor)
    vira argumentos := argumentos + 2
    vira indice := indice + 1
  fecha

  emite_syscall(contexto, "sys_obj_novo", argumentos)
fecha

campo emite_binario(contexto: ContextoCampo, expr: No) -> Nada ::
  guarda esquerda := lista_no_pega(expr.filhos, 0)
  guarda direita := lista_no_pega(expr.filhos, 1)

  veja expr.valor == "e" e direita.especie == "nome" e nome_maiusculo(direita.nome) ::
    emite_expressao(contexto, esquerda)
    emite_const_texto(contexto, "tag")
    emite_syscall(contexto, "sys_obj_pega", 2)
    emite_const_texto(contexto, direita.nome)
    emite_instrucao(contexto.emissao, OpIgual, 0, 0)
    devolve nulo
  fecha

  veja expr.valor == "e" ::
    emite_expressao(contexto, esquerda)
    guarda salto_falso := emite_instrucao(contexto.emissao, OpSaltaFalso, 0, 0)
    emite_expressao(contexto, direita)
    guarda salto_fim := emite_instrucao(contexto.emissao, OpSalta, 0, 0)
    corrige_a(contexto.emissao, salto_falso, U32(lista_tamanho(contexto.emissao.codigo)))
    emite_const_u32(contexto, 0)
    corrige_a(contexto.emissao, salto_fim, U32(lista_tamanho(contexto.emissao.codigo)))
    devolve nulo
  fecha

  veja expr.valor == "ou" ::
    emite_expressao(contexto, esquerda)
    guarda avalia_direita := emite_instrucao(contexto.emissao, OpSaltaFalso, 0, 0)
    emite_const_u32(contexto, 1)
    guarda salto_fim := emite_instrucao(contexto.emissao, OpSalta, 0, 0)
    corrige_a(contexto.emissao, avalia_direita, U32(lista_tamanho(contexto.emissao.codigo)))
    emite_expressao(contexto, direita)
    corrige_a(contexto.emissao, salto_fim, U32(lista_tamanho(contexto.emissao.codigo)))
    devolve nulo
  fecha

  emite_expressao(contexto, esquerda)
  emite_expressao(contexto, direita)

  veja expr.valor == "+" :: emite_instrucao(contexto.emissao, OpSoma, 0, 0) devolve nulo fecha
  veja expr.valor == "-" :: emite_instrucao(contexto.emissao, OpSub, 0, 0) devolve nulo fecha
  veja expr.valor == "*" :: emite_instrucao(contexto.emissao, OpMul, 0, 0) devolve nulo fecha
  veja expr.valor == "/" :: emite_instrucao(contexto.emissao, OpDiv, 0, 0) devolve nulo fecha
  veja expr.valor == "==" :: emite_instrucao(contexto.emissao, OpIgual, 0, 0) devolve nulo fecha
  veja expr.valor == "<" :: emite_instrucao(contexto.emissao, OpMenor, 0, 0) devolve nulo fecha

  guarda descarte_direita := local_temporario(contexto)
  emite_instrucao(contexto.emissao, OpLocalGrava, descarte_direita, 0)
  guarda descarte_esquerda := local_temporario(contexto)
  emite_instrucao(contexto.emissao, OpLocalGrava, descarte_esquerda, 0)
  emite_instrucao(contexto.emissao, OpLocalLe, descarte_esquerda, 0)
  emite_const_texto(contexto, expr.valor)
  emite_instrucao(contexto.emissao, OpLocalLe, descarte_direita, 0)
  emite_syscall(contexto, "sys_vm_binaria", 3)
fecha

campo emite_unario(contexto: ContextoCampo, expr: No) -> Nada ::
  veja expr.valor == "nao" ::
    emite_expressao(contexto, lista_no_pega(expr.filhos, 0))
    emite_syscall(contexto, "sys_bit_nao", 1)
    devolve nulo
  fecha

  veja expr.valor == "-" ::
    emite_const_u32(contexto, 0)
    emite_expressao(contexto, lista_no_pega(expr.filhos, 0))
    emite_instrucao(contexto.emissao, OpSub, 0, 0)
    devolve nulo
  fecha

  emite_expressao(contexto, lista_no_pega(expr.filhos, 0))
fecha

campo emite_const_u32(contexto: ContextoCampo, valor: U32) -> Nada ::
  emite_instrucao(contexto.emissao, OpConstU32, numero_indice(contexto.emissao, valor), 0)
fecha

campo emite_const_texto(contexto: ContextoCampo, valor: Texto) -> Nada ::
  emite_instrucao(contexto.emissao, OpConstTexto, texto_indice_pool(contexto.emissao, valor), 0)
fecha

campo emite_syscall(contexto: ContextoCampo, nome: Texto, argumentos: U32) -> Nada ::
  emite_instrucao(contexto.emissao, OpSyscall, nome_indice(contexto.emissao, nome), argumentos)
fecha

campo emite_descarta(contexto: ContextoCampo) -> Nada ::
  veja contexto.descarte == 4294967295 ::
    vira contexto.descarte := local_adiciona(contexto, "__descarte", sim)
  fecha
  emite_instrucao(contexto.emissao, OpLocalGrava, contexto.descarte, 0)
fecha

campo local_temporario(contexto: ContextoCampo) -> U32 ::
  devolve local_adiciona(contexto, "__tmp_" + texto_u64(contexto.proximo_local), sim)
fecha

campo local_adiciona(contexto: ContextoCampo, nome: Texto, mutavel: Bit) -> U32 ::
  guarda existente := local_indice_opcional(contexto, nome)
  veja existente >= 0 :: devolve U32(existente) fecha

  guarda indice := contexto.proximo_local
  lista_coloca(contexto.locais, LocalEmitido {
    nome: nome,
    indice: indice,
    mutavel: mutavel
  })
  vira contexto.proximo_local := contexto.proximo_local + 1
  devolve indice
fecha

campo local_indice(contexto: ContextoCampo, nome: Texto) -> U32 ::
  guarda indice := local_indice_opcional(contexto, nome)
  veja indice >= 0 :: devolve U32(indice) fecha
  devolve local_adiciona(contexto, nome, sim)
fecha
