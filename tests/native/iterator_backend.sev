  lista_coloca(codigo, Instrucao { opcode: Guarda, a: 2, b: 0, c: 0, ip: 45 })

  lista_coloca(codigo, Instrucao { opcode: Carrega, a: 1, b: 0, c: 0, ip: 46 })
  lista_coloca(codigo, Instrucao { opcode: Syscall, a: 3, b: 1, c: 0, ip: 47 })
  lista_coloca(codigo, Instrucao { opcode: SaltaSeNao, a: 51, b: 0, c: 0, ip: 48 })

  lista_coloca(codigo, Instrucao { opcode: Const, a: 8, b: 0, c: 0, ip: 49 })
