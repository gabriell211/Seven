  lista_coloca(codigo, Instrucao { opcode: Const, a: 9, b: 0, c: 0, ip: 51 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 52 })

  devolve ImagemSvbc {
    versao: 1,
    nomes: nomes,
    constantes: constantes,
    campos: campos,
    codigo: codigo
  }
fecha

campo inicio() -> Num toca disco ::
  guarda imagem := imagem_prova_iterador()
  guarda linux := baixa_nativo(imagem, alvo_linux_x64())
  veja linux e Falha :: devolve 50 fecha

  guarda windows := baixa_nativo(imagem, alvo_win_x64())
  veja windows e Falha :: devolve 51 fecha

  sys_arquivo_grava_bytes("build/native-iterator-proof", linux.valor.bytes)
  sys_arquivo_grava_bytes("build/native-iterator-proof.exe", windows.valor.bytes)
  devolve 0
fecha
