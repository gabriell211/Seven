modulo tests.native.text_backend

usa seven.runtime.platform.native.linker
usa seven.runtime.platform.native.target
usa seven.runtime.svbc.image
usa seven.runtime.svbc.opcode
usa seven.runtime.svbc.value
usa std.base.lista
usa std.base.resultado

campo imagem_texto_nativo() -> ImagemSvbc ::
  solta constantes := lista<ValorVm>()
  lista_coloca(constantes, VmTexto("Seven language"))
  lista_coloca(constantes, VmNum(0))
  lista_coloca(constantes, VmNum(5))
  lista_coloca(constantes, VmNum(6))
  lista_coloca(constantes, VmNum(14))
  lista_coloca(constantes, VmTexto("Seven"))
  lista_coloca(constantes, VmTexto("language"))
  lista_coloca(constantes, VmTexto(""))
  lista_coloca(constantes, VmTexto("S"))
  lista_coloca(constantes, VmNum(42))
  lista_coloca(constantes, VmNum(1))
  lista_coloca(constantes, VmNum(2))
  lista_coloca(constantes, VmNum(3))
  lista_coloca(constantes, VmNum(4))

  solta nomes := lista<Texto>()
  lista_coloca(nomes, "sys_texto_fatia")
  lista_coloca(nomes, "sys_texto_caractere")

  solta campos := lista<CampoImagem>()
  lista_coloca(campos, CampoImagem {
    nome: "inicio",
    entrada: 0,
    locais: 0,
    parametros: 0,
    efeitos: lista<Texto>()
  })

  solta codigo := lista<Instrucao>()

  lista_coloca(codigo, Instrucao { opcode: Const, a: 0, b: 0, c: 0, ip: 0 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 1, b: 0, c: 0, ip: 1 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 2, b: 0, c: 0, ip: 2 })
  lista_coloca(codigo, Instrucao { opcode: Syscall, a: 0, b: 3, c: 0, ip: 3 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 5, b: 0, c: 0, ip: 4 })
  lista_coloca(codigo, Instrucao { opcode: Igual, a: 0, b: 0, c: 0, ip: 5 })
  lista_coloca(codigo, Instrucao { opcode: SaltaSeNao, a: 29, b: 0, c: 0, ip: 6 })

  lista_coloca(codigo, Instrucao { opcode: Const, a: 0, b: 0, c: 0, ip: 7 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 3, b: 0, c: 0, ip: 8 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 4, b: 0, c: 0, ip: 9 })
  lista_coloca(codigo, Instrucao { opcode: Syscall, a: 0, b: 3, c: 0, ip: 10 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 6, b: 0, c: 0, ip: 11 })
  lista_coloca(codigo, Instrucao { opcode: Igual, a: 0, b: 0, c: 0, ip: 12 })
  lista_coloca(codigo, Instrucao { opcode: SaltaSeNao, a: 31, b: 0, c: 0, ip: 13 })

  lista_coloca(codigo, Instrucao { opcode: Const, a: 0, b: 0, c: 0, ip: 14 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 2, b: 0, c: 0, ip: 15 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 2, b: 0, c: 0, ip: 16 })
  lista_coloca(codigo, Instrucao { opcode: Syscall, a: 0, b: 3, c: 0, ip: 17 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 7, b: 0, c: 0, ip: 18 })
  lista_coloca(codigo, Instrucao { opcode: Igual, a: 0, b: 0, c: 0, ip: 19 })
  lista_coloca(codigo, Instrucao { opcode: SaltaSeNao, a: 33, b: 0, c: 0, ip: 20 })

  lista_coloca(codigo, Instrucao { opcode: Const, a: 0, b: 0, c: 0, ip: 21 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 1, b: 0, c: 0, ip: 22 })
  lista_coloca(codigo, Instrucao { opcode: Syscall, a: 1, b: 2, c: 0, ip: 23 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 8, b: 0, c: 0, ip: 24 })
  lista_coloca(codigo, Instrucao { opcode: Igual, a: 0, b: 0, c: 0, ip: 25 })
  lista_coloca(codigo, Instrucao { opcode: SaltaSeNao, a: 35, b: 0, c: 0, ip: 26 })

  lista_coloca(codigo, Instrucao { opcode: Const, a: 9, b: 0, c: 0, ip: 27 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 28 })

  lista_coloca(codigo, Instrucao { opcode: Const, a: 10, b: 0, c: 0, ip: 29 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 30 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 11, b: 0, c: 0, ip: 31 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 32 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 12, b: 0, c: 0, ip: 33 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 34 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 13, b: 0, c: 0, ip: 35 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 36 })

  devolve ImagemSvbc {
    versao: 1,
    nomes: nomes,
    constantes: constantes,
    campos: campos,
    codigo: codigo
  }
fecha

campo inicio() -> Num toca disco ::
  guarda imagem := imagem_texto_nativo()
  guarda linux := baixa_nativo(imagem, alvo_linux_x64())
  veja linux e Falha :: devolve 10 fecha
  guarda windows := baixa_nativo(imagem, alvo_win_x64())
  veja windows e Falha :: devolve 11 fecha

  sys_arquivo_grava_bytes("build/native-text-proof", linux.valor.bytes)
  sys_arquivo_grava_bytes("build/native-text-proof.exe", windows.valor.bytes)
  devolve 0
fecha
