modulo tests.native.aot_backend

usa seven.runtime.platform.native.linker
usa seven.runtime.platform.native.target
usa seven.runtime.svbc.image
usa seven.runtime.svbc.opcode
usa seven.runtime.svbc.value
usa std.base.lista

campo imagem_prova_nativa() -> ImagemSvbc ::
  solta constantes := lista<ValorVm>()
  lista_coloca(constantes, VmNum(40))
  lista_coloca(constantes, VmNum(2))
  lista_coloca(constantes, VmNum(42))
  lista_coloca(constantes, VmNum(1))

  solta campos := lista<CampoImagem>()
  lista_coloca(campos, CampoImagem {
    nome: "inicio",
    entrada: 0,
    locais: 3,
    parametros: 0,
    efeitos: lista<Texto>()
  })

  solta codigo := lista<Instrucao>()
  lista_coloca(codigo, Instrucao { opcode: Const, a: 0, b: 0, c: 0, ip: 0 })
  lista_coloca(codigo, Instrucao { opcode: Guarda, a: 0, b: 0, c: 0, ip: 1 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 1, b: 0, c: 0, ip: 2 })
  lista_coloca(codigo, Instrucao { opcode: Guarda, a: 1, b: 0, c: 0, ip: 3 })
  lista_coloca(codigo, Instrucao { opcode: Carrega, a: 0, b: 0, c: 0, ip: 4 })
  lista_coloca(codigo, Instrucao { opcode: Carrega, a: 1, b: 0, c: 0, ip: 5 })
  lista_coloca(codigo, Instrucao { opcode: Soma, a: 0, b: 0, c: 0, ip: 6 })
  lista_coloca(codigo, Instrucao { opcode: Guarda, a: 2, b: 0, c: 0, ip: 7 })
  lista_coloca(codigo, Instrucao { opcode: Carrega, a: 2, b: 0, c: 0, ip: 8 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 2, b: 0, c: 0, ip: 9 })
  lista_coloca(codigo, Instrucao { opcode: Igual, a: 0, b: 0, c: 0, ip: 10 })
  lista_coloca(codigo, Instrucao { opcode: SaltaSeNao, a: 14, b: 0, c: 0, ip: 11 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 2, b: 0, c: 0, ip: 12 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 13 })
  lista_coloca(codigo, Instrucao { opcode: Const, a: 3, b: 0, c: 0, ip: 14 })
  lista_coloca(codigo, Instrucao { opcode: Volta, a: 0, b: 0, c: 0, ip: 15 })

  devolve ImagemSvbc {
    versao: 1,
    nomes: lista<Texto>(),
    constantes: constantes,
    campos: campos,
    codigo: codigo
  }
fecha

campo inicio() -> Num toca disco ::
  guarda imagem := imagem_prova_nativa()
  guarda linux := baixa_nativo(imagem, alvo_linux_x64())
  veja linux e Falha :: devolve 10 fecha

  guarda windows := baixa_nativo(imagem, alvo_win_x64())
  veja windows e Falha :: devolve 11 fecha

  sys_arquivo_grava_bytes("build/native-aot-proof", linux.valor.bytes)
  sys_arquivo_grava_bytes("build/native-aot-proof.exe", windows.valor.bytes)
  devolve 0
fecha
